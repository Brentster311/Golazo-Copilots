.create-or-alter function with (folder = "SolutionDash/Raw", docstring = "", skipvalidation = "true") Get_SolutionDash_Raw(ParamSolutionScanRange:timespan=90d, SampleWorkflowProductIdList:string="", SampleWorkflowTopicIdList:string="", SampleSolutionId:string="", SampleWorkflowId:string="", SampleSupportRequestNumber:string="") {
    // SAMPLE USAGE
    //      Get_SolutionDash_Raw(ParamSolutionScanRange=3d)
    //      Get_SolutionDash_Raw(SampleWorkflowProductIdList=14749)
    //      Get_SolutionDash_Raw(SampleWorkflowProductIdList=14749,SampleWorkflowTopicIdList=32615526)//RDP
    //
    // ETL
    //      .drop table Cache_Get_SolutionDash_Raw
    //      .set-or-replace Cache_Get_SolutionDash_Raw with (folder='SolutionDash/V2_ApolloOnly')<|Get_SolutionDash_Raw()
    //      .Cache_Get_SolutionDash_Raw_ApolloOnly
    //      .set Cache_Get_SolutionDash_Raw_ApolloOnly_2 with (folder='SolutionDash/V2_ApolloOnly')<|Get_SolutionDash_Raw()
    //
    // DESIGN/CAVEATS
    //      1) CSF + StepType only
    //      2) Collect Present and Engage from different telemetry entry, which shares SolutionId
    //          ==> Most (if not all) sol only has present event, while most clicks is on link level
    //      3) Dedup same Workflow+Solution, multi present
    //      4) [Remove this 4/30] Simulate "clickable" with 1 year of cooked.clicked
    // BIG CHANGES FROM PREVIOUS ITERATION:
    //      1) keep in sol level (Expect remove a lot of single-click or no-click)
    //      2) calc "TotalPresentCount" cross pivot
    //          ==> use single total number cross board biases to bigger flight
    //              i.e. favor Alchemy for full onboarded;  favor !Alchemy for 50% traffic
    //      3) dedup on Workflow+Solution , multi present
    // 4/30 - switch to PartC.SolutionId
    //      - Honor ApolloId & components
    //      - primary key WorkflowId+ApolloId
    //
    // PENDING
    //      3)  Get LinkCount
    //      4)  UU discussion 
    //      5)  Sub "simulate" UU : ~10% ASMS has not Sub, by design?
    //      6)  KO Raw, or query tuning to prevent runaway
    //      8)  Keep active leaf topics only, or flag it
    //      9)  DataVal : Solution.Present/Click any missing telemetry scenario?
    //      13) Flag coexist : Help20/CSF
    //      14) Dwell - Take from Dash1 
    //      15) Dwell - Remodel for Sol Dwell
    //      16) Correlation: LogP VS SV2 (fail in PBI)
    //      17) CDF
    //      18) A few drill down for AKB, or not?
    //
    //
    //let SampleWorkflowId='f901a8c7-664d-4db4-879d-ba40d1e5caac';let ParamSolutionScanRange= 180d;
    //let SampleSolutionId='';let SampleWorkflowProductIdList='';let SampleWorkflowTopicIdList='';let SampleSupportRequestNumber='';
    database("CXP_CSF").Get_CSF_Annotated()
    | where StartDate >= ago(ParamSolutionScanRange)
    | where IsEligible and IsPAC and not(IsTestSub) 
    | where isempty( SampleWorkflowProductIdList)
            or (isnotempty(LastProductId) and SampleWorkflowProductIdList contains LastProductId)
    | where isempty( SampleWorkflowTopicIdList) or Workflow_TopicId == SampleWorkflowTopicIdList
            or (isnotempty(Workflow_TopicId) and SampleWorkflowTopicIdList contains Workflow_TopicId)
    | where isempty( SampleWorkflowId)           or WorkflowId == SampleWorkflowId
    | where isempty( SampleSupportRequestNumber) or SupportRequestNumber == SampleSupportRequestNumber
    | project WorkflowId,IsSRCreated, StartDate, SupportRequestNumber, SubscriptionId
            ,Workflow_ProductId=LastProductId
            ,Workflow_TopicId
            ,AlchemyFullExposure,AlchemyBucketId,AlchemyRuleId,PresentedSolutionTypes
    | extend Workflow_ProductTopic=strcat(Workflow_ProductId,':',Workflow_TopicId)
    | extend Workflow_ProductTopic=trim_start(':',Workflow_ProductTopic)
    | extend Workflow_ProductTopic=trim_end(':',Workflow_ProductTopic)//|count//30d : 194K
    // Only keep active leaf Topics
    | lookup kind = inner(
            database('CXP_CSF').ActiveTopicTree
            | where IsActiveLeaf
            | project ProductId,LeafTopicId
                     ,Workflow_SapProductId=SapProductId,Workflow_LeafTopicSapId=LeafTopicSapId, Workflow_PathName=PathName
            )on $left.Workflow_ProductId==$right.ProductId, $left.Workflow_TopicId==$right.LeafTopicId//|count//30d: 193K
    // ATTENTION: Primary Key becomes Workflow+SolutionId, including all StepNumbers
    | join kind = inner hint.strategy=shuffle (
            Get_SolutionAnnotated(
                    ParamScanStart  = ago(ParamSolutionScanRange)
                   ,ParamClient     = 'CSF' // 'CSF', 'H20','TSG', 'CSF,H20' // empty value for all
                   )
            | extend
                    IsApolloSolutionPresented = IsApolloSolutionId
                   ,IsEngaged                 = IsClicked
                   ,WorkflowSolution_PresentCount=BladeCount
        )
        on WorkflowId | project-away WorkflowId1
//     | join kind=leftouter hint.strategy=shuffle ( 
//         //Simulate "clickable" with 1 year of Cooked.click
//         cooked
//         | where IsEngaged
//         | summarize hint.strategy=shuffle 
//                    Solution_HistoricalStartDate = min(EventTimestamp)
//                 by SolutionId
//         ) on SolutionId
//         | extend IsClickableSolution = isnotempty(SolutionId1)
//         | project-away SolutionId1
}

.create-or-alter function with (folder = "SolutionDash", docstring = "", skipvalidation = "true") Get_Bonsai_ArticlesV2() {
    //cluster('ACCIA').database('LeftShift').Get_Bonsai_ArticlesV2()|getschema
    //
    // PENDING: currently from a manually cached source @ 2023-5-26
    cluster('ACCIA').database('Playground_Wei').Cache_Bonsai_Get_ArticlesV2
    | extend  TopicCount=array_length(SapIds)
    | project ArticleId=articleId
             ,Article_Name=name
             ,Article_GitHubPath=gitHubPath
             ,Article_TopicCount = TopicCount
             ,Article_SapIds = SapIds
             ,Article_LegacyIds = LegacyIds
             ,Article_ResourceRequired = resourceRequired
             ,Article_ResourceType = resourceType
             ,Article_ResourceProvider = resourceProvider
             ,Article_SolutionType = SolutionType
             ,Article_Type = type
             ,Article_ProblemIds = problemIds
    | mv-expand Article_SapIds
    | extend SapProductId   = tostring(Article_SapIds['ProductSapId'])
            ,LeafTopicSapId = tostring(Article_SapIds['SupportTopicSapId'])
    | lookup kind = leftouter(
            database('CXP_CSF').ActiveTopicTree()
            |project SapProductId, ProductName, LeafTopicSapId, PathName, IsActiveLeaf
            ) on SapProductId,LeafTopicSapId
    | summarize 
             Article_ProductName_Set=array_sort_asc(make_set(todynamic(ProductName)))
            ,Article_PathName_Set= array_sort_asc(make_set(todynamic(PathName)))
            ,Article_SapProductId_Set= array_sort_asc(make_set(todynamic(SapProductId)))
            ,Article_LeafTopicSapId_Set= array_sort_asc(make_set(todynamic(LeafTopicSapId)))
            ,Article_SapIds_Str         =strcat_array(make_set(Article_SapIds),',')
            ,Article_LegacyIds_Str      =strcat_array(make_set(Article_LegacyIds),',')
            ,take_any(*)
          by ArticleId, Article_Name, Article_GitHubPath,Article_TopicCount
          | project-away Article_SapIds,Article_LegacyIds,ProductName,PathName,SapProductId,LeafTopicSapId
    | extend 
             Article_ActiveProductCount     = array_length(Article_SapProductId_Set)
            ,Article_ActiveLeafTopicCount   = array_length(Article_LeafTopicSapId_Set)
            ,Article_ProductName_Set        = strcat_array(Article_ProductName_Set,',')
            ,Article_PathName_Set           = strcat_array(Article_PathName_Set,',')
            ,Article_SapProductId_Set       = strcat_array(Article_SapProductId_Set,',') 
            ,Article_LeafTopicSapId_Set     = strcat_array(Article_LeafTopicSapId_Set,',')
}

.create-or-alter function with (folder = "SolutionDash", docstring = "", skipvalidation = "true") Get_SolutionAnnotated_V2_BucketGen(ParamScanStart:datetime=datetime(2023-1-1), ParamScanEnd:datetime=datetime(2099-9-9), ParamAzureCoreOnly:bool=True, ParamClient:string="CSF", ParamHelpfulDocOnly:bool=True, ParamSampleProducts:string="", ParamAdditionalStopwords:string="") {
    // NOTE: Modified from Get_SolutionAnnotated (created for SolutionDash) 
    //                for Alchemy Bucket generation
    //                ignore the details on component level
    //
    // SAMPLE USAGE
    //      Get_SolutionAnnotated_V2_BucketGen(ParamSampleProducts=15526,ParamAdditionalStopwords='["not"]')|project-reorder Verbatim
    //      Get_SolutionAnnotated_V2_BucketGen(ParamSampleProducts='Virtual')|summarize count() by ProductId, ProductName
    //      Get_SolutionAnnotated_V2_BucketGen()|take 100
    //      Get_SolutionAnnotated_V2_BucketGen(ParamAzureCoreOnly,ParamCSFOnly,ParamHelpfulDocOnly)|take 100
    //
    // MANUAL ETL
    //     .set-or-replace Cache_Get_SolutionAnnotated_BucketGen with (folder='BonsaiV2')<|KO_SolutionAnnotated_BucketGen(datetime(2023-1-1), datetime(2023-5-1))
    //     .set-or-append Cache_Get_SolutionAnnotated_BucketGen with (folder='BonsaiV2')<|KO_SolutionAnnotated_BucketGen(datetime(2022-9-1), datetime(2023-1-1))
    //
    database('LeftShift').Cache_Get_SolutionAnnotated_BucketGen
    //     database('LeftShift').KO_SolutionAnnotated_BucketGen(
    //         ParamScanStart          = ParamScanStart
    //        ,ParamScanEnd            = ParamScanEnd
    //        ,ParamClient             = 'CSF'
    //        )
    //PENDING Cook better timestamp
    | where  StepEndTime between (ParamScanStart .. ParamScanEnd )
    | where  isempty(ParamSampleProducts) 
          or strcat(ParamSampleProducts,',') contains strcat(ProductId,',')  // param is comma-delim-productid-list
          or ProductName contains ParamSampleProducts// param is part of product name
    | where isempty(ParamClient) 
            or (ParamClient contains 'CSF' and IsCSF) 
            or (ParamClient contains 'H20' and IsH20)
            or (ParamClient contains 'DNS' and IsDNS)
    | where  not(ParamHelpfulDocOnly) or (ParamHelpfulDocOnly and IsHelpfulSolution)
    | invoke database('CSS_Secured').Invoker_GetIsAzureCore() 
    | where  not(ParamAzureCoreOnly)  or (ParamAzureCoreOnly and IsAzureCore)
    | extend Verbatim       = cluster('ACCIA').database('CSS_Secured').Scalar_RemoveStopWords(Verbatim,ParamAdditionalStopwords)
    | extend ApolloSolution = strcat('<a href=https://github.com/Azure/SelfHelpContent/tree/master',Article_GitHubPath, ' target=_blank>',Article_Name,'</a>')
}

.create-or-alter function with (folder = "SolutionDash", docstring = "", skipvalidation = "true") Get_SolutionDash(ParamPivot:string="All", ParamIsValid4Opportunity_Threshold:real=0.2, ParamPresentMinThreshold:long=0, ParamHTestThreshold:long=10, ParamSolutionScanRange:timespan=90d, ParamSourceTableName:string="Cache_Get_SolutionDash_Raw_ApolloOnly_2", SampleWorkflowProductIdList:string="", SampleWorkflowTopicIdList:string="", SampleSolutionArticleId:string="", SampleWorkflowId:string="", SampleSupportRequestNumber:string="") {
    // SAMPLE USAGE
    //      Get_SolutionDash()|where Pivot=='All=All'
    //      Get_SolutionDash(SampleWorkflowProductIdList=14749)
    //      Get_SolutionDash(SampleWorkflowProductIdList=14749,SampleWorkflowTopicIdList=32615526)//RDP
    //      Get_SolutionDash(ParamPivot='IsSRCreated',SampleWorkflowProductIdList=14749,SampleWorkflowTopicIdList=32615526)//RDP
    //
    //let ParamSourceTableName = 'Cache_Get_SolutionDash_Raw_ApolloOnly_2';let ParamPivot = 'All';let ParamSolutionScanRange =90d;let ParamHTestThreshold= 30;let ParamIsValid4Opportunity_Threshold = 0.2; let ParamPresentMinThreshold = 0;let SampleSolutionArticleId='';//'/articles/microsoft.dbformysql/dbformysql-gen1-performance-querystoreperformanceinsights-v2.md';//'/articles/apollo/f6a908af-bbe0-4046-8816-62a40923df14.md';
    //let SampleWorkflowId='';let SampleWorkflowProductIdList='';let SampleWorkflowTopicIdList='';let SampleSupportRequestNumber='';
    let _Local_Invoker_SigTest=(T:(*),col_name_XY:string,col_name_XNOTY:string,col_name_NOTXY:string,col_name_NOTXNOTY:string,ParamHTestThreshold:long){
        T
        | extend XY         = column_ifexists(col_name_XY,0)
                ,XNOTY      = column_ifexists(col_name_XNOTY,0)
                ,NOTXY      = column_ifexists(col_name_NOTXY,0)
                ,NOTXNOTY   = column_ifexists(col_name_NOTXNOTY,0)
        | extend IsValid4Test= XY>ParamHTestThreshold 
                               and XNOTY >ParamHTestThreshold 
                               and NOTXY >ParamHTestThreshold 
                               and NOTXNOTY>ParamHTestThreshold
        | as TT
        | where IsValid4Test and isnotempty(ParamHTestThreshold)
        | invoke database('CSS_Secured').Invoker_GetChiSquareSigGeneric(Threshold=ParamHTestThreshold)
        | union (TT|where not(IsValid4Test) or isempty(ParamHTestThreshold))
        | extend PassTest_E_SR = case (Sig between (0 ..  0.05), 'TRUE', Sig>0.05,'FALSE','N/A')
        | project-rename Sig_E_SR=Sig
        | project-away XY,XNOTY,NOTXY,NOTXNOTY ,IsValid4Test
        };
    // PENDING: Using caching table during EDA
    //cluster('ACCIA').database("Playground_Wei").
    table(ParamSourceTableName)
    | where isnotempty( ApolloSolutionArticleId)
    | extend  SolutionArticleId = ApolloSolutionArticleId
    | where isempty( SampleWorkflowProductIdList)
            or (isnotempty(Workflow_ProductId) and SampleWorkflowProductIdList contains Workflow_ProductId)
    | where isempty( SampleWorkflowTopicIdList) or Workflow_TopicId == SampleWorkflowTopicIdList
            or (isnotempty(Workflow_TopicId) and SampleWorkflowTopicIdList contains Workflow_TopicId)
    | where isempty( SampleWorkflowId)           or WorkflowId == SampleWorkflowId
    | where isempty( SampleSupportRequestNumber) or SupportRequestNumber == SampleSupportRequestNumber
    | where isempty( SampleSolutionArticleId) or SolutionArticleId == SampleSolutionArticleId
    //     Get_SolutionDash_Raw2(
    //             ParamSolutionScanRange      = ParamSolutionScanRange
    //            ,SampleWorkflowProductIdList = SampleWorkflowProductIdList
    //            ,SampleWorkflowTopicIdList   = SampleWorkflowTopicIdList
    //            ,SampleSolutionArticleId     = SampleSolutionArticleId
    //            ,SampleWorkflowId            = SampleWorkflowId
    //            ,SampleSupportRequestNumber  = SampleSupportRequestNumber
    //             )
    //
    | extend Pivot = strcat(ParamPivot, '=', column_ifexists(ParamPivot, 'All'))
    | as Raw | union (Raw|extend Workflow_ProductId='***All***', Workflow_SapProductId='***All***', Workflow_ProductTopic=''
                                ,Solution_ProductId='***All***', Solution_ProductTopic=''
                                )
    | as Raw1| union (Raw1|where Pivot!='All=All'|extend Pivot='All') // Adds "All" if ParamPivot is a valid col
    | as Raw2
    | summarize 
            P_Count                     = dcount(WorkflowId,4)//count()
           ,E_Count                     = dcountif(WorkflowId ,IsEngaged,4)
           //
           ,P_SR_Count                  = dcountif(WorkflowId ,IsSRCreated,4)
           ,P_NotSR_Count               = dcountif(WorkflowId ,not(IsSRCreated),4)
           //
           ,E_SR_Count                  = dcountif(WorkflowId ,IsSRCreated and IsEngaged,4)
           ,E_NotSR_Count               = dcountif(WorkflowId ,not(IsSRCreated) and IsEngaged,4)
           ,NotE_SR_Count               = dcountif(WorkflowId ,IsSRCreated and not(IsEngaged),4)
           ,NotE_NotSR_Count            = dcountif(WorkflowId ,not(IsSRCreated) and not(IsEngaged),4)
           ,Solution_SubCount          = array_length(make_set(SubscriptionId))
           // Take keep 1 sample per solution from max(SR)
           ,(_SR, Sample_WorkflowId_SRCreated)  = arg_max(IsSRCreated,WorkflowId) 
           ,(_D, Sample_WorkflowId_Deflected)   = arg_max(not(IsSRCreated),WorkflowId) 
            by Pivot,SolutionArticleId,Workflow_ProductId
        // Get totals
        | lookup(Raw2
                 |summarize hint.strategy=shuffle 
                            TotalWorkflowCount_By_Pivot_Product = dcount(WorkflowId,4) 
                           ,TotalWorkflowArticleCount_By_Pivot_Product = count() 
                         by Pivot, Workflow_ProductId
                 ) on Pivot, Workflow_ProductId
        | lookup(Raw2
                 |summarize hint.strategy=shuffle 
                            TotalWorkflowCount_By_Pivot = dcount(WorkflowId,4) 
                           ,TotalWorkflowArticleCount_By_Pivot = count() 
                         by Pivot
                 ) on Pivot
        // Prune
        | where isempty(ParamPresentMinThreshold) or P_Count >=  ParamPresentMinThreshold 
        | extend Sample_WorkflowId_SRCreated = iif(_SR, Sample_WorkflowId_SRCreated, toguid(''))
                ,Sample_WorkflowId_Deflected = iif(_D, Sample_WorkflowId_Deflected, toguid(''))
        | project-away _SR, _D
        // OK, start calc
        | extend LogP               = log(P_Count)
                ,P_Given_AzureTotal = iif(TotalWorkflowArticleCount_By_Pivot>0, 1.0*P_Count/TotalWorkflowCount_By_Pivot, toreal('')) 
                ,P_Given_ProductTotal = iif(TotalWorkflowArticleCount_By_Pivot_Product>0, 1.0*P_Count/TotalWorkflowCount_By_Pivot_Product, toreal('')) 
                ,E_Given_P          = iif(P_Count>0, 1.0* E_Count       /P_Count, toreal(''))
                ,ED_Given_E         = iif(E_Count>0, 1.0* E_NotSR_Count /E_Count, toreal(''))
                ,SR_Given_P         = iif(P_Count>0, 1.0* P_SR_Count    /P_Count, toreal(''))
                ,SR_Given_E         = iif(E_Count>0, 1.0* E_SR_Count    /E_Count, toreal(''))
                ,NotSR_Given_P      = iif(P_Count>0, 1.0* P_NotSR_Count /P_Count, toreal(''))
                ,NotSR_Given_E      = iif(E_Count>0, 1.0* E_NotSR_Count /E_Count, toreal(''))
        | extend SV1                = ED_Given_E*E_Given_P*P_Given_AzureTotal
                ,SV2                = ED_Given_E*E_Given_P
                //a: NotSR
                ,SV1a               = NotSR_Given_E*E_Given_P*P_Given_AzureTotal
                ,SV2a               = NotSR_Given_E*E_Given_P
        | extend Opportunity = iif (
                            NotSR_Given_P <= ParamIsValid4Opportunity_Threshold
                           ,(ParamIsValid4Opportunity_Threshold - NotSR_Given_P) *P_Given_ProductTotal
                           ,toreal(''))
        | lookup kind=leftouter (database('CXP_CSF').ActiveTopicTree|distinct ProductId, ProductName)on $left.Workflow_ProductId==$right.ProductId
        | extend ProductName = coalesce(ProductName, Workflow_ProductId) // 'All' or deleted product
        // SigTest if enabled
        | invoke _Local_Invoker_SigTest('E_SR_Count','E_NotSR_Count','NotE_SR_Count','NotE_NotSR_Count',ParamHTestThreshold)
        | project-reorder Pivot,Workflow_ProductId, ProductName,SolutionArticleId, Opportunity, SV*,*Given*
        | order by SV1a desc nulls  last
}

.create-or-alter function with (folder = "SolutionDash", docstring = "", skipvalidation = "true") KO_SolutionAnnotated_BucketGen(ParamScanStart:datetime=datetime(2022-10-1), ParamScanEnd:datetime=datetime(2099-9-9), ParamClient:string="CSF,H20,DNS", ParamSampleWorkflowId:string="", ParamSampleSessionId:string="") {
    // NOTES:
    //      PrimaryKey : SesionId + WorkflowId + SolutionId
    //      SolutionId        : The unique id for solution. Could be free-format; but mostly guid-format for newer ones authored via Elixir.
    //      Solution          : Help experience presented to User. with UniqueId. Could be Apollo or some non-Apollo scenario (PENDING MORE DATA CLEANSING)
    //      SolutionComponent : Video/AKB etc within Apollo
    //      SolutionLink      : External/Blade Link etc, ApolloSolution could have link; SolutionComponent such as Diag could also have link
    // 
    // SAMPLE USAGE
    //      database('LeftShift').Get_SolutionAnnotated_V2_BucketGen()|getschema
    //      database('LeftShift').Get_SolutionAnnotated_V2_BucketGen()|summarize count(),countif(IsHelpfulSolution) by  IsCSF,IsH20,IsDNS
    //      database('LeftShift').Cache_Get_SolutionAnnotated_BucketGen(ago(91d),now(),'CSF')|summarize count(),take_any(*) by IsApolloSolutionId, WorkflowType_set, StepType_set,SolutionType_set, SolutionComponentType_set
    //      database('LeftShift').Cache_Get_SolutionAnnotated_BucketGen|take 10//where WorkflowId=='395ed30e-3182-433d-bf95-46ab297ce6e2'
    //
    //      .drop table Cache_Get_SolutionAnnotated_BucketGen_1
    //      .rename tables Cache_Get_SolutionAnnotated_BucketGen_1=Cache_Get_SolutionAnnotated_BucketGen
    //      .set-or-replace Cache_Get_SolutionAnnotated_BucketGen with (folder='SolutionAnnotated')<|KO_SolutionAnnotated_BucketGen(datetime(2023-5-1), now())
    //
    //let ParamAzureTechOnly = True; let ParamSampleWorkflowId='6a456691-f855-4215-9594-14fd230f9b4b';let ParamSampleSessionId='';let ParamClient = '';let ParamScanStart = datetime(2023-5-1); let ParamScanEnd=ParamScanStart+180d;
    //let ParamClient = 'CSF,H20,DNS'; let ParamSampleWorkflowId='';let ParamSampleSessionId='';let ParamScanStart = datetime(2023-5-1); let ParamScanEnd=ParamScanStart+1d;
    let Apollo_InvalidStepTypes     = dynamic(['Basics','Details','ReviewAndCreate']);
    let Apollo_InvalidSolutionTypes = dynamic(['FullBladeSolution','']);
    let Apollo_EngagementActions    = dynamic(['clicked','expanded', 'collapsed']);
    let Apollo_Elements             = dynamic(['BladeLink'
                                              ,'ExternalLink'
                                              ,'Accordion'
                                              ,'ApolloInsightAccordion'
                                              ,'ApolloSection'
                                              ,'ApolloVideoLink'
                                              ,'AzureKBCard'
                                              ,'AzureKBLink'
                                              ,'BladeLink'
                                              ,'ExternalLink'
                                              ,'GuidedSolverContinue'
                                              ,'GuidedSolverEditSolutions'
                                              ,'GuidedSolverFeedback'
                                              ,'GuidedSolverRerunDiagnostics'
                                              ,'RerunDiagnostics'
                                              ,'SubmitDiagnosticScopingQuestions'
                                              ,'TroubleshooterAccordion'
                                              ,'ViewServiceHealthLink'
                                              ]);
    cluster('ACCIA').database('CXP_CSF').Get_PortExtTel_Cooked(ParamScanStart, ParamScanEnd)
    | where isempty(ParamSampleWorkflowId) or ParamSampleWorkflowId==WorkflowId 
    | project SessionId
             ,WorkflowId
             ,PreciseTimeStamp
             ,WorkflowType,StepType
             ,StepNumber,StepUpdateNumber
             ,UpdateItemId,UpdateItemAction,UpdateItemValue
             ,SolutionType
             ,SolutionId
             //,SolutionStatus
             //,SolutionArticleId,SolutionArticleUrl,SolutionArticleTitle // optional/legacy telemetry
             ,SapProductId = coalesce(ProductSAPId,PartC_productId_1, ProductId,PartC_ProductId)
             ,LastProductId
             ,TimeOnBladeInSeconds = coalesce(toreal(TimeOnBladeInSeconds),0.0)
    | extend IsCSF = WorkflowType == 'Case Submission V2' and StepType == 'SelfHelp'
            ,IsH20 = WorkflowType in('Help Experience Workflow','Help Pane Workflow')
            ,IsDNS = WorkflowType == 'TroubleshootV3'
    | where isempty(ParamClient) 
            or (ParamClient contains 'CSF' and IsCSF) 
            or (ParamClient contains 'H20' and IsH20)
            or (ParamClient contains 'DNS' and IsDNS)
    | extend IsClicked    = 
                    // Apollo engagement, take logic from CXP.CxJourney
                    StepType                        !in (Apollo_InvalidStepTypes) 
                    and SolutionType                !in (Apollo_InvalidSolutionTypes)
                    and UpdateItemAction            in (Apollo_EngagementActions) 
                    and split(UpdateItemId,'/')[-1] in (Apollo_Elements)
             ,IsApollo  =
                    // Root for Appolo Solution; Unique within Workflow*StepNumber; No click action;
                    SolutionType         == 'Apollo' 
                    and UpdateItemAction == 'presented' 
    // Dwell using precalculated CSF_Product_DwellThreshold
    | lookup kind = leftouter(GetDwellThresholds()|project SapProductId, CSF_Product_DwellThreshold=DwellThreshold) on SapProductId
    | extend IsDwell = TimeOnBladeInSeconds > coalesce(CSF_Product_DwellThreshold,0.0)
    //
    | extend  ApolloSolutionId           = iif(IsApollo,SolutionId,'') 
    | where (isnotempty(SolutionId))
         or (isnotempty( TimeOnBladeInSeconds))         // Mostly for CSF; H20/DNS has own challenge on this data
    //Convert to SAPId
    | lookup kind=leftouter(database('CXP_CSF').ActiveTopicTree() | distinct ProductId, SapProductId)on$left.SapProductId==$right.ProductId
    | extend SapProductId   = coalesce(SapProductId1,SapProductId)| project-away SapProductId1
    // PK: WorkflowId+WorkflowType+StepNumber
    | summarize hint.strategy=shuffle 
                IsEngaged               = max(IsClicked or IsDwell)
               ,IsClicked               = max(IsClicked)
               ,(IsDwell_CSF,CSF_Product_DwellThreshold)   = arg_max(IsDwell,CSF_Product_DwellThreshold)
               ,ApolloSolutionId        = max(ApolloSolutionId) //ASSUMPTION: single product+apollosolution per step number
               ,SapProductId            = max(SapProductId)
               ,TimeOnBladeInSeconds    = sum(TimeOnBladeInSeconds)
               ,StepEndTime             = max(PreciseTimeStamp)
                // Keep for adhoc purpose
               ,Presented_SolutionType_Set  = array_sort_asc(make_set(todynamic(SolutionType)))
               ,Engaged_SolutionType_Set    = array_sort_asc(make_set(todynamic(iif(IsClicked,SolutionType,''))))
               ,Engaged_UpdateItemId_Set    = array_sort_asc(make_set(todynamic(iif(IsClicked,UpdateItemId,''))))
             by SessionId, WorkflowId,StepNumber,StepType, WorkflowType,IsCSF,IsH20,IsDNS
    // Filter down to Apollo only
    | where isnotempty( ApolloSolutionId)
    // PK: WorkflowId + WorkflowType + ApolloSolution, taking from the last StepNumber per WorkflowType
    | as Workflow_StepNumber
    | join kind = inner (
        Workflow_StepNumber
        | summarize hint.strategy=shuffle 
                StepNumber= max(StepNumber)
             by SessionId, WorkflowId ,WorkflowType
        ) on SessionId, WorkflowId,WorkflowType,StepNumber
        | project-away SessionId1,WorkflowId1,WorkflowType1,StepNumber1
    //Get Verbatim for CSF/H20
    | join kind = leftouter hint.strategy=shuffle (
            // ATENTION: Same session could have multiple verbatim!!!
            database('CSS_Secured').GetCSFVerbatim(ParamScanStart,ParamScanEnd)
            | where not(IsTestVerbatim)
            | project Verbatim_WorkflowId = tostring(WorkflowId), Verbatim = tolower(coalesce(Translation,IssueSummary)), WorkflowStartTime
            | summarize 
                    Verbatim_Set = make_set(Verbatim) 
                   ,(WorkflowStartTime,Verbatim) = arg_max(WorkflowStartTime,Verbatim) // take last
                 by Verbatim_WorkflowId
                 |project-away WorkflowStartTime
            ) on $left.WorkflowId ==$right.Verbatim_WorkflowId| project-away Verbatim_WorkflowId
    //Get SR
    | join kind = leftouter hint.strategy=shuffle (
            cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated(ParamScanStart, ParamScanEnd)
            | where IsSRCreated
            | summarize
                    IsSRCreated = max(IsSRCreated) 
                   ,SR_Count    = array_length(make_set(todynamic(SupportRequestNumber)))
                   ,SR_Set      = strcat_array(array_sort_asc(make_set(SupportRequestNumber)),',')
                 by SessionId
            ) on SessionId
            | project-away SessionId1
    | extend IsSRCreated = coalesce(IsSRCreated,False)
    // Simulate Helpful
    | extend IsHelpfulSolution = (IsClicked or IsDwell_CSF) and not(IsSRCreated)
    // Filter down to Active Product
    | lookup kind=inner (
            database('CXP_CSF').ActiveTopicTree()
            |project IssueType=case(ProductId ==15621,'Quota',ProductId in(15659,15660),'ASMS','Tech')
                    ,ProductId
                    ,SapProductId
                    ,ProductName
            | distinct * 
            ) on SapProductId
    // Get Article Metadata 
    // PENDING: currently from a manually cached source @ 2023-5-26
    | lookup kind = leftouter( 
            cluster('ACCIA').database('LeftShift').Get_Bonsai_ArticlesV2()
            //|project-reorder ArticleId,Article_Name, Article_GitHubPath
            ) on$left.ApolloSolutionId==$right.ArticleId
    | project-reorder SessionId,ApolloSolutionId,WorkflowType,WorkflowId,Is*
}

// List of functions in Accia.LeftShift.SR collection

.create-or-alter function with (folder = "SR", docstring = "", skipvalidation = "true") AllCloudsSupportIncidentWithReferenceModelVNext() {
    // SAMPLE USAGE: 
    //      AllCloudsSupportIncidentWithReferenceModelVNext()|take 10
    //      AllCloudsSupportIncidentWithReferenceModelVNext()|summarize max(CreatedDate) by State
    //
    // VNext depreciate: SupportTopicId => SapId 
    //                   SupportTopicPath => SapPath
    //                   [No reference] SupportTopicL*, RootCause*
    // Data quality check:
    //      SapId (w/ 3 day sampling): Leaf_SapId 90% ; L2_SapId 3% ; Product_SapId 2%; empty 6%
    //
	// 2024-10-3 : Migrate to P360 AME cluster
	cluster('supportrptwus3Prod.westus3').database('KPISupportData').AllCloudsSupportIncidentWithReferenceModelVNext
      	| extend
  	         SupportRequestNumber = IncidentId
  	        ,CreatedDate = startofday(CreatedDateTime)
  	        ,CreatedTime = CreatedDateTime
  	        ,ClosedDate = startofday(ClosedDateTime)
  	        ,ClosedTime = ClosedDateTime
  	        ,ResolutionStatus = Status
            // P360 has 3 ProductId fields
            //      - EligibleProductId   : Initial Product, set by customer. ACCIA uses this as InitialProductId starting from 7/1/2019.
            //      - ProductId           : Current Product, some logic behind the sceen to reset CSS rule engine. ACCIA uses this as CurrentProductId since 4/14/2022.
            //      - Incidents_ProductId : SR's product before CSS assigned DerivedProductIdStr to it. ACCIA used this as InitialProductId till end of 6/2019.
            //      - DerivedProductIdStr : SR's Product set by CSS, including effect of Rule Engine.   ACCIA used this as CurrentProductId as of 4/13/2022.
            //                            : DerivedProductIdStr is depreciated in VNext @ 3/17/2023
            ,InitialProductId       = EligibilityProductId
            ,CurrentProductId       = ProductId
            ,InitialProductName     = EligibleSupportProductName
            ,CurrentProductName     = SupportProductName
            ,CurrentTopicFullPath   = SapPath
            //PENDING: Alternatively, get it from ActiveTopicTree
            ,CurrentTopicName       = coalesce(
                                                iif(SapSupportPathL4=='UNKNOWN', '', SapSupportPathL4)
                                               ,iif(SapSupportPathL3=='UNKNOWN', '', SapSupportPathL3))
            ,Initial_SapTopicId     = InitialSapId
            ,Current_SapTopicId     = SapId
            // for Wayfinder.PC
            //,Title,TenantId,CauseType,RootCause,RootCauseL1,RootCauseL2
        | extend
        	IsReroute  = InitialProductId != CurrentProductId
        	          or Initial_SapTopicId != Current_SapTopicId
           ,IsSRClosed = State=='Resolved'	// Active/Resolved
}

.create-or-alter function with (folder = "", docstring = "", skipvalidation = "true") Get_AzureCoreInsights_S360ExpandedActionItem() {
    // SAMPLE USAGE
    //      database("LeftShift").AzureCoreInsights_S360ExpandedActionItem
    //
    // ETL : https://aka.ms/acciaflow
    // .set-or-replace AzureCoreInsights_S360ExpandedActionItem with(folder='S360')<|database("LeftShift").Get_AzureCoreInsights_S360ExpandedActionItem()
    //
    union cluster('s360prodro').database('service360db').S360ExpandedActionItem_*
    | where S360_ProgramIds has '65a010a5-1e3d-4777-bb89-f149470a507d'  //SFI Wave1
         or S360_ProgramIds has "aa6ddae1-5f87-41c5-bb11-e003a143a844"  //Azure Core Wave1
         or S360_ProgramIds has "ccc75fc8-dd6a-4351-8465-ecf2ccbe3493"  //GetSecure
    | where S360_Audience_DisplayName == "Murali Chintalapati"
    | project-away S360_ServiceHierarchy_Json,ServiceHierarchy,XDivTeamInfo,S360_UniqueKey,S360_UniqueKey2,S360_UniqueKey3,S360_ObjectiveIds,S360_ObjectiveIds2
                  ,S360_ObjectiveIds1,CalculationLogic,S360_ProgramIds1,S360_ProgramIds2//,S360_ProgramIds
    | extend Program = case(S360_ProgramIds has '65a010a5-1e3d-4777-bb89-f149470a507d', '0. SFI Wave1'
                           ,S360_ProgramIds has "aa6ddae1-5f87-41c5-bb11-e003a143a844", '1. Azure Core Wave1'
                           ,S360_ProgramIds has "ccc75fc8-dd6a-4351-8465-ecf2ccbe3493", '2. GetSecure'
                           ,'Unknown')
    | extend Owner = iff(isnotempty(S360_ServiceDevOwner), S360_AssignedToName,S360_ServiceTreeServiceName)       
    | extend Owner = replace("'s Team","",Owner)
    | summarize by Program
                  ,Action=['title']
                  ,Owner
                  ,ServiceName=RowNodeName
                  ,ServiceId=RowNodeId
                  ,URL=url
    }

.create-or-alter function with (folder = "", docstring = "", skipvalidation = "true") Get_IPW_P360SR(ParamPivot:string="All") {
    // SAMPLE USAGE
    //      Get_IPW_P360SR()|project-rename All=PivotsCol|render timechart
    //      Get_IPW_P360SR(ParamPivot='Status')|project-rename Status=PivotsCol|render timechart
    //      Get_IPW_P360SR(ParamPivot='CreationChannel')|project-rename CreationChannel=PivotsCol|render timechart
    //
    //let ParamPivot ='Status';
    cluster('ACCIA').database('CXP_CSF').GetSupportRequestsWithReferenceModel()|where CreatedDate >ago(180d)
    | extend StartDate=CreatedDate
    | extend PivotsCol = column_ifexists(ParamPivot, '')
    | invoke Invoker_Get_MA(ScanWindowInDays = 7)
    | project PivotsCol,StartDate,IPW = Total_MA
}

.create-or-alter function with (folder = "", docstring = "", skipvalidation = "true") GetSolutionList_Laxmi(ScanStartDate:datetime=datetime(2023-1-1), ScanEndDate:datetime=datetime(2099-9-9)) {
    // SAMPLE USAGE
    //      database("LeftShift").GetSolutionList_Laxmi() //From Laxmi @ 4/24/2023
    //
    cluster('AzSupport').database("AzureSupportability").SelfhelpSuccess_SummarizedByWorkflowId
        | where Timestamp >= ScanStartDate and Timestamp < ScanEndDate
        | where IsEligible
            and IsIssueType_Billing_Subscription_Technical
            and isnotempty( SolutionArticlePairs)
            and SolutionArticlePairs has "Apollo" 
            and SolutionArticlePairs !contains "<scrubbed"
        | summarize hint.strategy=shuffle SampleWorkflowId = take_any(WorkflowId)  by SolutionArticlePairs= tostring( SolutionArticlePairs)//, ProductId,WorkflowId
        | extend SolutionArticlePairs=todynamic(SolutionArticlePairs)
        | mv-expand SolutionArticlePairs
        | extend GitHubPath = tolower(tostring(SolutionArticlePairs.ArticleId))
        | where GitHubPath !contains "<scrubbed"
        | summarize hint.strategy=shuffle SampleWorkflowId = take_any(SampleWorkflowId)  by GitHubPath
}

.create-or-alter function with (folder = "", docstring = "", skipvalidation = "true") InternalReview_CARET_Q5_NotFound(BeforeBugFix:bool=True) {
    //TEST DESIGN: 
    //      Random pick 1000 CARET from production
    //      Get 401 have Q5_NOT_FOUND in production
    //      Generate EMAIL with new prompt
    //      Generate CARET with new prompt and new email
    // TEST RESULTS
    //      401 gets CARET_Q5=NotFound in Production   : 40% 
    //      123 get  CARET_Q5=NotFound with new Prompt : 12% 
    //               most of the 123 related to EMAIL_Q5_NotFound
    // SAMPLE SUAGE
    //      database("Playground_Wei").InternalReview_CARET_Q5_NotFound()|where QuestionIndex==5 //in (0,5)
    //
    database("Playground_Wei")._JobExecutor_CaretDetails_V2_DEBUG_Q5NotFound
        |where isnotempty( FinalSummary)
        |summarize arg_max(ingestion_time(), FinalSummary) by SupportRequestNumber, RequestType = strcat(RequestType,'_NewQ5')
        |as a
    | union (database("CSS_Secured")._JobExecutor_CaretSummary_V2
            |where ingestion_time() <datetime(2024-5-4 6:30) or not(BeforeBugFix)
            |where SupportRequestNumber  in (a|project SupportRequestNumber)
            |where RequestType in ('CARET','EMAIL')
            |summarize arg_max(ingestion_time(), FinalSummary) by SupportRequestNumber, RequestType = strcat(RequestType,'_Production')
            )
    |invoke database('LeftShift').Invoker_ParseCaretResults()
    |evaluate pivot(RequestType, max(Answer), SupportRequestNumber, QuestionIndex)
    |project-reorder SupportRequestNumber,QuestionIndex, *Pro*, EMAIL*,CARET*
}

   