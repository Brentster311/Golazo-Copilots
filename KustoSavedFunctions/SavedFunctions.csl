.create-or-alter function with (folder = "CARET/InputRaw", docstring = "", skipvalidation = "true") Get_JobExecutor_EmailSummary(ParamShowAll:bool=False) {
    // PENIDNG: Switch to Details raw table when it gets RequestType col
    // NOTE 
    //      This func is consumed by CARET. It is renamed from Get_DERA_InputData_EmailComm() => Get_CARET_EmailSummary => Get_JobExecutor_EmailSummary @ 2023 Sep.
    //
    // SAMPLE USAGE
    //      Get_JobExecutor_EmailSummary()|take 10
    //      Get_JobExecutor_EmailSummary(ParamShowAll=True) | take 10
    //      Get_JobExecutor_EmailSummary(ParamShowAll=False)| summarize count() by SupportRequestNumber|summarize count()by count_
    //      Get_JobExecutor_EmailSummary(ParamShowAll=True) | summarize count() by SupportRequestNumber|summarize count()by count_
    //
    // let ParamShowAll = False;
    union isfuzzy=True
        (database("CSS_Secured")._JobExecutor_CaretSummary_V2 | where RequestType =='EMAIL'|extend tostring(SupportRequestNumber))  // AKS based, Email Executor using CARET pipeline
    | extend Timestamp=ingestion_time()
            ,Email_FinalSummary= FinalSummary
    | as a | where not(ParamShowAll)|summarize arg_max(Timestamp,*)by SupportRequestNumber
    | union (a|where ParamShowAll)
    | order by SupportRequestNumber desc, Timestamp desc
}

.create-or-alter function with (folder = "CARET", docstring = "", skipvalidation = "true") Get_CARET_Feedback_Backend(ParamScanStart:datetime=datetime(2023-05-01T00:00:00.0000000Z), ParamScanEnd:datetime=datetime(null), ParamCaseReviewUser:string="", ParamSupportRequestNumberList:string="", ParamCaseReviewKeyword:string="") {
    //.append _DERA_UserFeedback_Backend<|_DERA_UserFeedback_Backend|take 0|union(_DERA_UserFeedback|project-away CaseReviewScope)
    //let ParamScanStart=datetime(2023-05-01); let ParamScanEnd=datetime(null); let ParamCaseReviewUser=""; let ParamSupportRequestNumberList=""; let ParamCaseReviewKeyword="";
    let ScanEnd = coalesce(ParamScanEnd,now());
    _DERA_UserFeedback_Backend
        | where Timestamp between (ParamScanStart .. ScanEnd)
        | where strcat(Feedback ,Rating) !=""
        | where isempty(ParamSupportRequestNumberList) 
                 or ParamSupportRequestNumberList == SupportRequestNumber
                 or strcat(ParamSupportRequestNumberList,',') contains strcat(SupportRequestNumber,',')
        | where  isempty(ParamCaseReviewUser)  
                 or User contains ParamCaseReviewUser //parital match allowed
        | summarize arg_max(Timestamp,*) by SupportRequestNumber
        | join kind=inner (
            Get_CARET_Store_Backend() 
            | project SapPath, EligibleProductId, EligibleProductName, FinalSummary, SupportRequestNumber
            ) on SupportRequestNumber
        | where isempty(ParamCaseReviewKeyword)
                 or EligibleProductName  contains ParamCaseReviewKeyword  // string partial match
                 or SapPath                     contains ParamCaseReviewKeyword   // string partial match
                 or EligibleProductId       == ParamCaseReviewKeyword         // Id exact match
        | project-away SupportRequestNumber1      
        | project SupportRequestNumber, User, Feedback, Rating, FinalSummary, EligibleProductId, EligibleProductName, SapPath, Timestamp       
        // Workaround FinalSummay nested json, which renders empty cell value in WISE & ProblemModeling PBI
        | extend FinalSummary=replace('/"', "'", FinalSummary)
        // PENDING REDESIGN
        //      Disable FinalSummary which breaks caret_api/review_feedbacks, and is not referenced anywhere
        //      WISE: pending design Feedback feature
        //      ACCIAPortal: only support following features
        | project SupportRequestNumber,SapPath,User,Timestamp,Rating,Feedback
}

.create-or-alter function with (folder = "CARET", docstring = "", skipvalidation = "true") Get_CARET_Store_Backend(ParamScanStart:datetime=datetime(2023-06-01T00:00:00.0000000Z), ParamScanEnd:datetime=datetime(null), ParamCaseReviewScope:string="", ParamSupportRequestNumberList:string="", ParamRequestTypeList:string="CARET") {
    // SAMPLE USAGE 
    //      database("LeftShift").Get_CARET_Store_Backend(ParamCaseReviewScope='17535',ParamScanStart=datetime(2023-6-1))|project SupportRequestNumber
    //      database("LeftShift").Get_CARET_Store_Backend(2306010060000551)
    //      database("LeftShift").Get_CARET_Store_Backend()|summarize count() by CaseReviewScope
    //      // IcM hackathon
    //      database("LeftShift").Get_CARET_Store_Backend(411064105)
    //      database("LeftShift").Get_CARET_Store_Backend(ParamCaseReviewScope='IcmStore')
    //
    //let ParamSupportRequestNumberList = "";let ParamCaseReviewScope= '';let ParamScanStart=ago(30d); let ParamScanEnd=ParamScanStart+1h;let ParamRequestTypeList = 'CARET';
    let ScanEnd = coalesce(ParamScanEnd, now());
    database("SupportAnalysis").AllCloudsSupportIncidentWithReferenceModelVNext
    | where isempty(ClosedDateTime) or ClosedDateTime between (ParamScanStart .. ScanEnd)
    // Remove violations: 
    //      caret_api.caret_utils.load_caret() : if payload['request_type'] == 'CARET_ANYSR': request_type_list = "CARET,CARET_ANYSR"
    //      'CARET,CARET_ANYSR' is the only scenario to enable active SR
    | where State == 'Resolved' 
         or ParamRequestTypeList == 'CARET,CARET_ANYSR'
    | project SupportRequestNumber  = IncidentId
             ,ClosedDateTime 
             ,ProductId
             ,SapPath
    | lookup kind=inner (ActiveTopicTree_CARET()|distinct ProductId, ProductName)on ProductId
    | where isempty(ParamCaseReviewScope) 
             or ProductName  contains ParamCaseReviewScope   // string partial match
             or SapPath                     contains ParamCaseReviewScope   // string partial match
             or ProductId        == ParamCaseReviewScope         // Id exact match
    | where isempty(ParamSupportRequestNumberList) 
             or ParamSupportRequestNumberList == SupportRequestNumber
             or strcat(ParamSupportRequestNumberList,',') contains strcat(SupportRequestNumber,',')
    | extend SR_ClosedDate         = startofday(ClosedDateTime)
    | invoke Invoker_GetCaretData(ParamRequestTypeList=ParamRequestTypeList)
    | invoke Invoker_GetCaretFeedback()
    | order by SupportRequestNumber desc
    // Remove after deploy to Portal
    | extend SummaryDiscussion= ''
    | project-away Src, CaseReviewScope1, SummaryDiscussion
            //, GenerationTime, CaseReviewScope // bring these back, for WISE-UI & ACCIAPortal dependency
    | project-reorder SupportRequestNumber, SR_ClosedDate, ProductId, ProductName, SapPath, FinalSummary, Feedback, Rating, Feedback_Timestamp, Feedback_User
    // TEMP : Add back to unblock WISE, until hardcoded fields removed from WISE code base
    | extend EligibleProductId = ProductId,EligibleProductName = ProductName
}

