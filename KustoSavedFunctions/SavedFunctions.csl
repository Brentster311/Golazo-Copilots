.create-or-alter function with (folder = "LeftShift/Subscriptions/Invokers", docstring = "", skipvalidation = "true") Invoker_AddSubscriptionMetadata(T:(SubscriptionId:guid)) {
T
|join hint.shufflekey=SubscriptionId kind=leftouter  (database("CommonDims").Product360CustomerSubscriptions| project SubscriptionId=toguid(SubscriptionId),OfferType,Strategic400Flag) on SubscriptionId 
| extend OfferType = coalesce(OfferType,'[Unknown]')
| extend IsS500 = Strategic400Flag=='Yes'
| project-away SubscriptionId1,Strategic400Flag
}

// List of functions in Accia.LeftShift.SupportCases collection

