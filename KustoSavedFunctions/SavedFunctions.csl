.create-or-alter function with (folder = "aks", docstring = "", skipvalidation = "true") TusharsMagicFunction() {
let terms = todynamic('["product limitation","product bug", "not supported" ,"feature not available", "By design", "Working as designed", "feature request", "submit a request", "file a request", "limitation", "missing feature"]')
;
let q = database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel
| where ClosedDateTime > ago(30d)
| where SupportLanguage !in ("ja-JP", "ko-KR", "zh-CN", "zh-HK", "zh-TW") 
| extend IsLimitation= Causetxt has_any (terms)
| extend CausetxtLen = strlen(Causetxt)
| project Id=tostring(IsLimitation), Verbatim=Causetxt
| where strlen(Verbatim) > 0 and strlen(Verbatim) < 280 
;
let TrueTable = q
| where Id=="True"
| order by rand()
| take 5000
;
q
| where Id=="False"
| take 5000
| order by rand()
| union TrueTable
}

