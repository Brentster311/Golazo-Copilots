.create-or-alter function with (folder = "CSS_Reporting/BaseFunctions", docstring = "", skipvalidation = "true") GetSupportRequestsWithReferenceModel() {
    // SAMPLE USAGE: 
    //      GetSupportRequestsWithReferenceModel()|take 10
    //      GetSupportRequestsWithReferenceModel()|summarize max(CreatedTime)
    //
    database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel
      	| project
  	         SupportRequestNumber = IncidentId
            // P360 has 3 ProductId fields
            //      - EligibleProductId   : Initial Product, set by customer. ACCIA uses this as InitialProductId starting from 7/1/2019.
            //      - DerivedProductIdStr : Current Product, set by CSS. ACCIA uses this as CurrentProductId.
            //      - Incidents_ProductId : SR's product before CSS assigned DerivedProductIdStr to it. ACCIA used this as InitialProductId till end of 6/2019.
            ,InitialProductId       = EligibilityProductId
            ,CurrentProductId       = DerivedProductIDStr
        | extend
         IsProductReroute = InitialProductId != CurrentProductId
}

