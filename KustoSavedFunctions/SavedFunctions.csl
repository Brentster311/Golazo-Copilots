// List of functions in Accia.SupportAnalysis.DataScience collection

.create-or-alter function with (folder = "DataScience", docstring = "", skipvalidation = "true") Invoker_GetChiSquareSigGeneric(T:(XY:long,XNOTY:long,NOTXY:long,NOTXNOTY:long), Threshold:long=30) {
let PythonCode = 
'threshold = kargs["Threshold"]\n'
'from scipy.stats import chi2_contingency\n'
'# contingency table\n'
'\n'
'def CalcSig(row):\n'
'    table2 = [	[row["XY"]   , row["XNOTY"]],\n'
'			    [row["NOTXY"], row["NOTXNOTY"]]]\n'
'    if table2[0][0]<threshold or table2[0][1]<threshold or table2[1][0]<threshold or table2[1][1]<threshold:\n'
'        p2=-1\n'
'    else:\n'
'            stat2, p2, dof2, expected2 = chi2_contingency(table2,False)\n'
'            if expected2[0][0]<threshold or expected2[0][1]<threshold or expected2[1][0]<threshold or expected2[1][1]<threshold:\n'
'                p2=-1\n'
'    return p2\n'
'\n'
'\n'
'result=df\n'
'result["Sig"]= result.apply(CalcSig,axis=1)\n'
;
T
| evaluate python(typeof(*,Sig:real),PythonCode, pack('Threshold',Threshold))
}

.create-or-alter function with (folder = "DataScience", docstring = "", skipvalidation = "true") Invoker_PrepChiSquare(T:(X:bool,Y:bool,pivot:string)) {
T
| summarize XY = countif(X and Y)
           ,XNOTY = countif(X and not(Y))
           ,NOTXY = countif(not(X) and Y)
           ,NOTXNOTY = countif(not(X) and not(Y)) by pivot
}

