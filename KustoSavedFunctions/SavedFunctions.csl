.create-or-alter function with (folder = "DERA/Temp", docstring = "", skipvalidation = "true") Get_SRs_For_Raw_Email() {
database("Playground_ronit").CaseReview_v2
| where Additional_Info contains "Tim_PromptV1_60SR"
| distinct SupportRequestNumber
| join kind=leftouter (cluster('ACCIA').database('LeftShift').Get_DERA_UserFeedback()
|where Feedback contains "email"
| distinct  SupportRequestNumber
| project SupportRequestNumber, Priority ="Tim_P0"
) on SupportRequestNumber | project-away SupportRequestNumber1
| union (cluster('ACCIA').database('LeftShift').Get_DERA_CaseStore("","Chirag")
| distinct SupportRequestNumber
| project SupportRequestNumber, Priority = "Chirag_P0"), 
