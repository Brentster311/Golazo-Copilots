// List of functions in Accia.Playground_Brent (Playground_BrentJ).Deflection collection

// List of functions in Accia.Playground_Brent (Playground_BrentJ).Invokers collection

.create-or-alter function with (folder = "Deflection/Invokers", docstring = "KeyInfluencers", skipvalidation = "true") Invoker_GetKeyInfluencers(T:(*), AnalyzeBy:string, Goal:bool, FeaturesRegex:string=".*") {
// let T =cluster('accia').database("Playground_BrentJ").GetLeftShiftData(7);
// let AnalyzeBy='IsSRCreated'; let FeaturesRegex=@'Is(?!\w+(RouteOut|Closed))|Visit|TimeOnBladeInSeconds';let Goal=False;
// T
// | where InitialProductId == '14749'
// | invoke Invoker_GetKeyInfluencers(AnalyzeBy=AnalyzeBy, FeaturesRegex=FeaturesRegex, Goal=Goal) 
let PythonParameters = pack('FeaturesRegex',FeaturesRegex
                           ,'AnalyzeBy',AnalyzeBy
                           )
;
let PythonCode = ```
import pandas as pd
import numpy as np
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from scipy.stats import chi2_contingency
from sklearn.tree import DecisionTreeClassifier
import json
import math
import sys

def FindSplitThreshold(Dataframe,ColumnToSplit,AnalyzeColumn):
    df = Dataframe[[ColumnToSplit,AnalyzeColumn]].copy()
    #drop Nan, inf, and empties
    df.replace('',np.nan,inplace=True)
    df.replace(np.inf,np.nan,inplace=True)
    df.dropna(inplace=True)
    clf=DecisionTreeClassifier(random_state=0, max_depth=2,min_samples_leaf=0.1)
    clf.fit(df[[ColumnToSplit]],df[AnalyzeColumn])

    n_nodes = clf.tree_.node_count
    children_left = clf.tree_.children_left
    children_right = clf.tree_.children_right
    feature = clf.tree_.feature
    threshold = clf.tree_.threshold

    node_depth = np.zeros(shape=n_nodes, dtype=np.int64)
    is_leaves = np.zeros(shape=n_nodes, dtype=bool)
    stack = [(0, 0)]  # start with the root node id (0) and its depth (0)
    while len(stack) > 0:
        # `pop` ensures each node is only visited once
        node_id, depth = stack.pop()
        node_depth[node_id] = depth

        # If the left and right child of a node is not the same we have a split
        # node
        is_split_node = children_left[node_id] != children_right[node_id]
        # If a split node, append left and right children and depth to `stack`
        # so we can loop through them
        if is_split_node:
            stack.append((children_left[node_id], depth + 1))
            stack.append((children_right[node_id], depth + 1))
        else:
            is_leaves[node_id] = True
    rules = ([threshold[i] for i in range(n_nodes) if not is_leaves[i]])
    rules.append(float('-inf'))
    rules.append(float('inf'))
    return sorted(rules)

def KeyInfluencers(Dataframe,AnalyzeColumn):
    df=Dataframe.copy()
    Y = df[AnalyzeColumn]
    if Y.dtype.name != 'bool':
        raise TypeError("The datatype for column {0} is not bool.".format(AnalyzeColumn))

    #convert other numeric into Booleans by finding a good place to split

    Nonbool_df = df.select_dtypes(include=['int64','float','int'])
    ColsToProcess=Nonbool_df.columns
    del Nonbool_df

    X=df

    for col in ColsToProcess:
        ThresholdRules = FindSplitThreshold(X,col,colToAnalyze)

        for RuleIndex in range(len(ThresholdRules)-1):
            valLeft = ThresholdRules[RuleIndex]
            valRight = ThresholdRules[RuleIndex+1]
            if math.isinf(valLeft):
                X[col+'<='+str(valRight)] = X[col]<=valRight
            elif math.isinf(valRight):
                X[col+'>'+str(valLeft)] = X[col]>valLeft
            else:
                X[str(valLeft)+'<'+col+'<='+str(valRight)] = (X[col]>valLeft) & (X[col]<=valRight)
        X=X.drop([col],axis=1)

    X = X.drop([AnalyzeColumn],axis = 1)
    #One hot encode
    X = pd.get_dummies(X,dtype=bool,prefix_sep = '=')
    scaler = StandardScaler()  #powerbi's documentation says the use MeanVariance scaling
    scaler.fit(X) 
    X_scaled = pd.DataFrame(scaler.transform(X),columns = X.columns)
    clf = LogisticRegression(fit_intercept=False,
                             #solver='saga'  #power bi uses lbfgs which is sklearn's default
                             )
    clf.fit(X_scaled,Y)
    Score = clf.score(X_scaled,Y)

    Classes = clf.classes_
    
    df = pd.concat([X,Y], axis=1)


    feature_importance = clf.coef_[0]
    feature_list=X.columns
    output_df = pd.DataFrame(data= list(zip(feature_list,feature_importance)),columns=['Feature','Weight'])
    output_df['AnalyzedTarget']=AnalyzeColumn
    output_df['AccuracyScore'] = Score

    conditionals=[]

    for col in feature_list:
        tuple= (-1,False,0.0,False,'Error',[],[],[],[])
        if df[col].dtype == 'bool':
            TT=sum((df[AnalyzeColumn]==True)  & (df[col]==True))
            TF=sum((df[AnalyzeColumn]==True)  & (df[col]==False))
            FT=sum((df[AnalyzeColumn]==False) & (df[col]==True))
            FF=sum((df[AnalyzeColumn]==False) & (df[col]==False))
            
            ExpectedMatrix= ActualsMatrix = [[TT,TF],
                                             [FT,FF]]

            ExpectedMatrix= ActualsMatrix = [[FF,FT],
                                             [TF,TT]]

            ProbabilitiesMatrix=[]
            for row in ActualsMatrix:
                ProbabilitiesMatrix.append([row[0]/sum(row),row[1]/sum(row)])


            LiklihoodMatrix=[]
            bestOddsValue =(0,0,0,1,1)
            for r in range(len(ProbabilitiesMatrix)):
                row=[]
                for c in range(len(ProbabilitiesMatrix[r])):
                    curVal = (ProbabilitiesMatrix[r][c])/(ProbabilitiesMatrix[abs(r-1)][c]) if ProbabilitiesMatrix[abs(r-1)][c]>0 else sys.float_info.max
                    if curVal> bestOddsValue[0]:
                        bestOddsValue= (curVal,r,c,abs(r-1),abs(c-1))
                    row.append(curVal)
                LiklihoodMatrix.append(row)
          
            #generate analysis strings
            output = """{0}=={2} is {4} times more likely when {1}=={3} and {0}=={5} is {7} times more likely when {1}=={6}""".format(
                     AnalyzeColumn,col,
                     str(bool(bestOddsValue[1])),str(bool(bestOddsValue[2])),
                     str(round(LiklihoodMatrix[bestOddsValue[1]][bestOddsValue[2]],3)) if LiklihoodMatrix[bestOddsValue[1]][bestOddsValue[2]] != sys.float_info.max else "INFINITELY",
                     str(bool(bestOddsValue[3])),str(bool(bestOddsValue[4])),
                     str(round(LiklihoodMatrix[bestOddsValue[3]][bestOddsValue[4]],3)) if LiklihoodMatrix[bestOddsValue[3]][bestOddsValue[4]] != sys.float_info.max else "INFINITELY"
                    )
            

            p=sys.float_info.max
            try:
                stat, p, dof, ExpectedMatrix = chi2_contingency(ActualsMatrix)
                ExpectedMatrix=ExpectedMatrix.tolist()
            except:
                print("An exception occurred processing {0}".format(col))

            IsSig = p>=0 and p<=0.05

            #modifed output based on significance test
            if p==sys.float_info.max:
                output = col + 'is ALWAYS ' + str(ProbabilitiesMatrix[0][0]+ProbabilitiesMatrix[1][0]==2)
            elif not IsSig:
                output = 'Not statistcally significant'
            ProbOfBestFeature=(ActualsMatrix[0][bestOddsValue[2]]+ActualsMatrix[1][bestOddsValue[2]])/(TT+TF+FT+FF)

            #really bad variable names
            f = ActualsMatrix[bestOddsValue[1]][bestOddsValue[2]]
            g = ActualsMatrix[bestOddsValue[3]][bestOddsValue[2]]
            h = ActualsMatrix[bestOddsValue[1]][bestOddsValue[4]]
            i = ActualsMatrix[bestOddsValue[3]][bestOddsValue[4]]

            Netimpact = 0
            try:
                Netimpact = (f/(f+g)) - (h/(h+i))
            except:
                 #ignore DBZ errors
                 print("An exception occurred processing {0}".format(col))

            tuple= (p,IsSig,bestOddsValue[0],bool(bestOddsValue[1]),bool(bestOddsValue[2]),ProbOfBestFeature,Netimpact,output,json.dumps(ActualsMatrix),json.dumps(ExpectedMatrix),json.dumps(ProbabilitiesMatrix),json.dumps(LiklihoodMatrix))

        conditionals.append(tuple)

    testing_df=pd.DataFrame(conditionals,
                            index=output_df.index, 
                            columns=['ChiSquare_pvalue','IsSignificant','BestOddsRatio','BestWhenTargetIs','BestWhenFeatureIs','ProbOfBestFeatureValue','NetImpactOfBest','AnalysisMessage','ActualsMatrix','ExpectedMatrix','ProbabilitiesMatrix','LiklihoodMatrix'])

    return pd.concat([output_df,testing_df],axis=1)

colToAnalyze  = kargs["AnalyzeBy"]
FeaturesRegex  = kargs["FeaturesRegex"]
#features I want
Cleaned_df=df[list(df.filter(regex=FeaturesRegex+'|'+colToAnalyze))]
result = KeyInfluencers(Cleaned_df,colToAnalyze)
```
;
T
| where assert(column_ifexists(AnalyzeBy, '6446c97b-acbf-4c0c-9441-d388927ab85e')!='6446c97b-acbf-4c0c-9441-d388927ab85e', "AnalyzeBy column not found.") 
| evaluate python(typeof(Feature:string, Weight:real, AnalyzedTarget:string, AccuracyScore:real, 
                         ChiSquare_pvalue:real,IsSignificant:bool,BestOddsRatio:real,BestWhenTargetIs:bool,BestWhenFeatureIs:bool,ProbOfBestFeatureValue:real,NetImpactOfBest:real,
                         AnalysisMessage:string,
                         ActualsMatrix:string,ExpectedMatrix:string,ProbabilitiesMatrix:string,LiklihoodMatrix:string),PythonCode,PythonParameters)
| extend NetImpact = NetImpactOfBest, Opportunity = iff(BestWhenTargetIs==Goal, 1-ProbOfBestFeatureValue, ProbOfBestFeatureValue)
| extend TotalOpportunity = NetImpact*Opportunity
| extend Verb=iff(BestWhenTargetIs==Goal,"Seek", "Avoid")
| extend Value = BestWhenFeatureIs
//eliminate doublenegatives
| extend Verb = iff(BestWhenTargetIs!=Goal and BestWhenFeatureIs==false, "Seek",Verb)
| extend Value = iff(BestWhenTargetIs!=Goal and BestWhenFeatureIs==false, true,Value)
| extend Guidance = strcat(Verb,' (',Feature, ') == ',Value)
| project-away Verb,Value
| project-reorder IsSignificant, NetImpact,Opportunity,TotalOpportunity,Guidance,AnalysisMessage
| order by TotalOpportunity desc
// | extend ActualsMatrix      =parse_json(ActualsMatrix)
//         ,ExpectedMatrix     =parse_json(ExpectedMatrix)
//         ,ProbabilitiesMatrix=parse_json(ProbabilitiesMatrix)
//         ,LiklihoodMatrix    =parse_json(LiklihoodMatrix)
}

.create-or-alter function with (folder = "Deflection", docstring = "", skipvalidation = "true") GetDeflectionData(ParamScanDays:long=56) {
//let ParamScanDays=91;
let datapoints = ParamScanDays;
let enddate=toscalar(cluster('accia').database("CXP_CSF").Get_CSF_Annotated() | summarize max(startofday(StartWorkflowTimestamp)));
let startdate=startofday(enddate,(1-datapoints));
let HealthCardMetaData = cluster('accia').database("CXP_CSF").Get_CSF_Cooked()
                    | where StepType=='Basics'
                    | extend IsHealthCardShown= UpdateItemId == 'Microsoft_Azure_Support/Case Submission V2/Basics/HealthCard'
                    | extend IsBladeLinkPresented =UpdateItemId == 'Microsoft_Azure_Support/Case Submission V2/Basics/BladeLink'
                    | extend IsBladeLinkClicked = UpdateItemId == 'Microsoft_Azure_Support/Case Submission V2/Basics/BladeLink' and UpdateItemAction =='clicked'
                    | project IsHealthCardShown,IsBladeLinkPresented,IsBladeLinkClicked,SolutionArticleId,WorkflowId
                    | summarize hint.shufflekey=WorkflowId IsHealthCardShown=max(IsHealthCardShown)
                               ,IsBladeLinkPresented=max(IsBladeLinkPresented)
                               ,IsBladeLinkClicked=max(IsBladeLinkClicked),SolutionArticleId=any(SolutionArticleId) by WorkflowId
;
let engagedmetadata = database("CXP_CSF").Get_CSF_Cooked() 
    | where StepType =='SelfHelp' and isnotempty(TimeOnBladeInSeconds) and toreal(TimeOnBladeInSeconds) >=0
    | project WorkflowId, TimeOnBladeInSeconds
    | summarize hint.shufflekey=WorkflowId TimeOnBladeInSeconds=avg(toreal(TimeOnBladeInSeconds)) by WorkflowId
    | project WorkflowId, TimeOnBladeInSeconds
;
let accia_annotation = cluster('accia').database("CXP_CSF").Get_CSF_Annotated()
                    | where StartDate between (startdate .. enddate)
                    // handle Tetris
               //     | extend LastSelectedTreeId=iff(IsTetrisReroute, coalesce(LastL3TopicId,LastL2TopicId,LastProductId),LastSelectedTreeId)
                   // | where LastProductId  in (ProductList)
                    | extend IsError = iff(IsSRCreated and LastStepType !in ('ReviewAndCreate','SRCreated'), true,false)
                    | project IsSRCreated,IsEligible, WorkflowId,SupportRequestNumber,IsHelpPresented, ProductId=LastProductId,LastStepType,IsHelpEngaged,TopicId=LastSelectedTreeId,IsTetrisReroute,StartDate,IsError, StartWorkflowTimestamp, SessionId, IsPAC, IsMPAC, IsTestSub
                    | join hint.shufflekey=WorkflowId kind=inner (HealthCardMetaData) on WorkflowId | project-away WorkflowId1
                    | join hint.shufflekey=WorkflowId kind=leftouter (engagedmetadata) on WorkflowId | project-away WorkflowId1
                    | extend TimeOnBladeInSeconds = iff(isempty(TimeOnBladeInSeconds),0.0,TimeOnBladeInSeconds)
                    | extend IsSolutionClicked = (IsEligible and IsHelpEngaged )  or (IsHealthCardShown and IsBladeLinkClicked)
;
let data = 
accia_annotation
| where TimeOnBladeInSeconds>0 and not(IsError) and isnotempty(TimeOnBladeInSeconds)
| extend LogTime=log10(TimeOnBladeInSeconds)
;
let trimmers=
data
| summarize hint.shufflekey=ProductId (p5,p95) = percentiles(LogTime,0,90) by IsSolutionClicked,ProductId
;
let stats = 
data
| join hint.shufflekey=ProductId kind=inner (trimmers) on  IsSolutionClicked,ProductId
| where LogTime between (p5 .. p95)
| summarize hint.shufflekey=ProductId m2=avgif(LogTime,IsSolutionClicked), s2=stdevif(LogTime,IsSolutionClicked)
           ,m1=avgif(LogTime,not(IsSolutionClicked)), s1=stdevif(LogTime,not(IsSolutionClicked))
           ,x=max(TimeOnBladeInSeconds)
           by ProductId
| extend  n=m2*s1*s1+(s2*(m1*s2 + s1*sqrt(pow(m1-m2,2)+2*(s1*s1-s2*s2)*log10(s1/s2)))), d=(s1*s1 - s2*s2)
| extend n1 = m2*s1*s1, n2= m1*s2, n3 = pow((m1-m2),2), n4 = 2*(pow(s1,2)-pow(s2,2)), n5 = log10(s1/s2)
| extend f=(n3+(n4*n5))
| extend sf=s1*sqrt(f)
| extend DwellThreshold=pow(10, (n1-s2*(n2 + sf))/d)
| extend DwellThreshold = iff(isnan( DwellThreshold), x,DwellThreshold)
| project ProductId,DwellThreshold
| join hint.shufflekey=ProductId kind=inner (accia_annotation) on ProductId | project-away ProductId1
| extend IsDwellEngaged = DwellThreshold < TimeOnBladeInSeconds
// handle no support differently
| extend IsWorkflowEligible= IsEligible or IsHealthCardShown 
| extend IsSolutionPresented = (IsEligible and IsHelpPresented) or IsHealthCardShown
| extend IsSolutionDwelled = (IsEligible and IsDwellEngaged)  or (IsHealthCardShown and LastStepType =='Basics')
| extend IsSolutionEngaged = (IsSolutionClicked or IsSolutionDwelled)
| extend IsEngagedDeflection = IsSolutionEngaged and not(IsSRCreated)
| extend key=strcat(ProductId,':',TopicId)
;
stats 
| where IsWorkflowEligible 
| project IsSolutionClicked,IsSolutionDwelled,IsSolutionEngaged,IsSolutionPresented,IsSRCreated,IsWorkflowEligible,ProductId,TopicId,key,WorkflowId,IsEngagedDeflection,StartDate,DwellThreshold,TimeOnBladeInSeconds, StartWorkflowTimestamp, SessionId, IsPAC, IsMPAC, IsTestSub
}

.create-or-alter function with (folder = "Deflection", docstring = "", skipvalidation = "true") GetHypothesisData() {
let stats = GetDeflectionData | where IsWorkflowEligible
;
union (stats | extend X = 'SR Creation',Y= 'Help is Dwelled', Y1=strcat(' for at least ', round(DwellThreshold,1), ' secs')
             | summarize XY       = sum(IsSRCreated and IsSolutionDwelled)
                        ,XNOTY    = sum(IsSRCreated and not(IsSolutionDwelled))
                        ,NOTXY    = sum(not(IsSRCreated) and IsSolutionDwelled)
                        ,NOTXNOTY = sum(not(IsSRCreated) and not(IsSolutionDwelled))
                         by ProductId,TopicId,X,Y,Y1
                         | invoke database("CSS_Secured").Invoker_GetChiSquareSigGeneric(Threshold=5))
       ,(stats
| extend X = 'SR Creation',Y= 'Help is Clicked', Y1=''
             | summarize XY       = sum(IsSRCreated and IsSolutionClicked)
                        ,XNOTY    = sum(IsSRCreated and not(IsSolutionClicked))
                        ,NOTXY    = sum(not(IsSRCreated) and IsSolutionClicked)
                        ,NOTXNOTY = sum(not(IsSRCreated) and not(IsSolutionClicked))
                         by ProductId,TopicId,X,Y,Y1
                        | invoke database("CSS_Secured").Invoker_GetChiSquareSigGeneric(Threshold=5) )
| extend PercentXGivenY = 1.0*XY/(XY+NOTXY),PercentXGivenNotY = 1.0*XNOTY/(XNOTY+NOTXNOTY)
| extend Result  = case(Sig==-1,'INSUFFICIENT DATA'
                      ,Sig <=0.05 and PercentXGivenY<PercentXGivenNotY, 'LOWER'
                      ,Sig <=0.05 and PercentXGivenY>PercentXGivenNotY, 'HIGHER'
                      ,'INSIGNIFICANT')
| extend ResultMessage = case(Sig==-1,''
                      ,Sig <=0.05 and PercentXGivenY<PercentXGivenNotY, strcat('Rates of ', X, ' are ',Result,' by ', round(100*(PercentXGivenNotY-PercentXGivenY),1), '% when ',Y,Y1)
                      ,Sig <=0.05 and PercentXGivenY>PercentXGivenNotY, strcat('Rates of ', X, ' are ',Result,' by ', round(100*(PercentXGivenY-PercentXGivenNotY),1), '% when ',Y,Y1)
                      ,'')
| extend Hypothesis = strcat(X, ' changes when ', Y)     
| extend key=strcat(ProductId,':',TopicId)
}

.create-or-alter function with (folder = "Deflection", docstring = "", skipvalidation = "true") GetLeftShiftData(ParamScanDays:long=84) {
//
//
//let ParamScanDays=7;
let EndDate = toscalar(database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel	| summarize max(CreatedDateTime))
;
let StartDate=startofday(EndDate,-1*ParamScanDays)
;
let CaseData=database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel 
| project SupportRequestNumber=IncidentId
                              ,CurrentPathName=SapPath
                              ,CurrentProductName=EligibleSupportProductName
                              ,ServiceName
                              ,Causetxt
                              ,Symptomstxt
                              ,Resolutiontxt
                              ,RootCauseSupportTopic
                              ,CurrentProductId=ProductId
                              ,CurrentLeafTopicId=tostring(split(SupportTopicId,@"\")[-1])
                              ,IsProductRouteOut = EligibilityProductId!=ProductId
                              ,TotalLaborMinutes=round(toreal(TotalLabourMinutes),0)
                              ,IsCaseClosed = State == 'Closed'
                              ,TotalCalendarMinutes = (coalesce(ClosedDateTime,now()) - CreatedDateTime)/1m
;
let CSFData = database("CXP_CSF").Get_CSF_Annotated(ParamScanStart=StartDate, ParamScanEnd=EndDate)
| where IsEligible
| project WorkflowId, SessionId,SupportRequestNumber, IsSRCreated,IsHelpPresented, IsHelpEngaged
         ,InitialLeafTopicId=LastSelectedTreeId,InitialProductId=LastProductId
         ,IsRecoTaken, IsRecoPresented, IsTetrisReroute
         ,IsApolloPresented = PresentedSolutionTypes contains 'Apollo'
         ,IsDiagnosticPresented = PresentedSolutionTypes contains 'Diagnostic'
         ,IsVideoPresented= PresentedSolutionTypes contains 'Video'
         ,IsCommonSolutionPresented = PresentedSolutionTypes contains 'CommonSolutions'
         ,IsAzureKBPresented = PresentedSolutionTypes contains 'AzureKb'
         ,IsGuidedTroubleshooterPresented = PresentedSolutionTypes contains 'GuidedTroubleshooter' //["GuidedTroubleshooter"]
         ,IsWebAppsTroubleshooterPresented = PresentedSolutionTypes contains 'WebAppsTroubleshooter' //["WebAppsTroubleshooter"]
         ,IsQuickFixPresented
         ,IsQuickFixEngaged=coalesce(IsQuickFixEngaged,false)
         ,StartWorkflowTimestamp
         ,IsChatPresentedSolutions
         ,IsChatStartedSolutions
         ,IsConfirmedNoSupportPlan
         ,SubscriptionId
         ,TetrisInitialProductSapId
         ,TetrisInitialSupportTopicSapId
// reset initial topic/product id's in the case of Tetris Reroute
| join kind=leftouter (database("CXP_CSF").GetActiveTopicTree() | project LeafTopicId,LeafTopicSapId,ProductId) on $left.TetrisInitialSupportTopicSapId==$right.LeafTopicSapId
| extend InitialProductId = coalesce(ProductId,InitialProductId)
| extend InitialLeafTopicId = coalesce(LeafTopicId,InitialLeafTopicId)
| project-away LeafTopicId,LeafTopicSapId,ProductId,TetrisInitialProductSapId,TetrisInitialSupportTopicSapId
| join kind=inner (database("CXP_CSF").GetActiveTopicTree() | project InitialLeafTopicId=LeafTopicId
                                                                     ,InitialProductId=ProductId
                                                                     ,InitialProductName=ProductName
                                                                     ,InitialPathName = strcat('Azure/',PathName)) on InitialLeafTopicId, InitialProductId
| join kind=inner (database("CommonDims").Product360CustomerSubscriptions| project SubscriptionId=toguid(SubscriptionId),OfferType) on SubscriptionId 
| project-away SubscriptionId,SubscriptionId1
| project-away InitialLeafTopicId1, InitialProductId1
;
let CRIData =toscalar(
        cluster('https://acciafollowercentralus.centralus.kusto.windows.net').database("IcMDataWarehouse").IncidentsSnapshotV2()
        | where CreateDate>= startofday(now(),-1*ParamScanDays)
        | where isnotempty( SupportTicketId)
        | summarize  SupportRequestNumber=make_set(SupportTicketId)
    )
;
let DwellTimes=database("CXP_CSF").Get_CSF_Cooked() 
    | where StepType =='SelfHelp' and isnotempty(TimeOnBladeInSeconds) and toreal(TimeOnBladeInSeconds) >=0
    | summarize hint.shufflekey=WorkflowId TimeOnBladeInSeconds=avg(toreal(TimeOnBladeInSeconds)) by WorkflowId
    | project WorkflowId, TimeOnBladeInSeconds
;
let Modality= database("CXP_CSF").Get_CSF_Cooked() 
| where StepType == 'Details'
| where UpdateItemId == "Microsoft_Azure_Support/Case Submission V2/Details/PreferredContactOptions"
| where UpdateItemAction == "selected"
| where isnotempty(UpdateItemValue )
| summarize arg_max(LogCoordinate,UpdateItemValue) by WorkflowId
| project WorkflowId,ContactModality=UpdateItemValue
;
let CSFPlusDwell = CSFData
| join hint.shufflekey=WorkflowId kind=leftouter (DwellTimes) on WorkflowId 
;
let threshold=CSFPlusDwell
| extend LogTime=round(log10(TimeOnBladeInSeconds),1)
| extend LogTime=round(LogTime,1)
| summarize m2=avgif(LogTime,IsHelpEngaged), s2=stdevif(LogTime,IsHelpEngaged)
           ,m1=avgif(LogTime,not(IsHelpEngaged)), s1=stdevif(LogTime,not(IsHelpEngaged))
           ,x=max(TimeOnBladeInSeconds)
           by  InitialProductId,InitialLeafTopicId
| extend  n=m2*s1*s1+(s2*(m1*s2 + s1*sqrt(pow(m1-m2,2)+2*(s1*s1-s2*s2)*log10(s1/s2)))), d=(s1*s1 - s2*s2)
| extend n1 = m2*s1*s1, n2= m1*s2, n3 = pow((m1-m2),2), n4 = 2*(pow(s1,2)-pow(s2,2)), n5 = log10(s1/s2)
| extend f=(n3+(n4*n5))
| extend sf=s1*sqrt(f)
| extend DwellThreshold=pow(10, (n1-s2*(n2 + sf))/d)
| extend DwellThreshold = iff(isnan( DwellThreshold), x,DwellThreshold)
| project  InitialProductId,InitialLeafTopicId,DwellThreshold
;
CSFPlusDwell
| join kind=inner (threshold) on InitialProductId,InitialLeafTopicId | project-away InitialProductId1,InitialLeafTopicId1
| extend  IsHelpDwelled = DwellThreshold < TimeOnBladeInSeconds
| project-away DwellThreshold
| join hint.shufflekey=SupportRequestNumber kind=leftouter (CaseData) on SupportRequestNumber 
| extend CurrentLeafTopicId=coalesce(CurrentLeafTopicId,InitialLeafTopicId)
| extend CurrentProductId =coalesce(CurrentProductId,InitialProductId)
| extend CurrentPathName=coalesce(CurrentPathName,InitialPathName)
| extend CurrentProductName=coalesce(CurrentProductName,InitialProductName)
| extend SupportRequestNumber= coalesce(SupportRequestNumber,SupportRequestNumber1)
| extend IsProductRouteOut=coalesce(IsProductRouteOut,false)
| extend IsCRI= SupportRequestNumber in (CRIData)
| extend Annotation = case(IsSRCreated and isempty(SupportRequestNumber1),dynamic([-1,'Case data missing'])
                          ,IsSRCreated and (TotalLaborMinutes ==  0 or isempty(TotalLaborMinutes)), dynamic([4,'Free Case'])
                          ,IsSRCreated and TotalLaborMinutes <= 75                  , dynamic([5,'Cheap Case']) 
                          ,IsSRCreated and TotalLaborMinutes <=200                  , dynamic([6,'Typical Case']) 
                          ,IsSRCreated and TotalLaborMinutes > 200                  , dynamic([7,'Expensive Case']) 
                      //    ,IsSRCreated and TotalLaborMinutes > 200  and    (IsCRI)  , dynamic([8,'Expensive CRI Case']) 
                          ,not(IsSRCreated) and IsHelpPresented and IsQuickFixEngaged
                                                              , dynamic([0,'Automated Deflection'])
                          ,not(IsSRCreated) and IsHelpPresented and IsHelpEngaged   
                                                              , dynamic([1,'Clicked Deflection']) 
                          ,not(IsSRCreated) and IsHelpPresented and IsHelpDwelled    
                                                              , dynamic([2,'Dwelled Deflection']) 
                          ,not(IsSRCreated) and IsHelpPresented and not(IsHelpEngaged)   
                                                              , dynamic([3,'Presented Deflection']) 
                          ,not(IsSRCreated) and not(IsHelpPresented), dynamic([3,'Helpless Deflection'])
                          ,dynamic([-1,'Unknown']))  
| project-away SupportRequestNumber1
| extend AnnotationLabel=strcat(Annotation[0],':',Annotation[1]), AnnotationId=tolong(Annotation[0]), IsTopicRouteOut = not(IsProductRouteOut) and InitialLeafTopicId !=CurrentLeafTopicId
| where AnnotationId >=0
| project-away Annotation
| invoke database("Playground_BrentJ").Invoker_GetTranslatedVerbatim(CleanVerbatim=true)
| extend IsCaseClosed = iff(not(IsSRCreated), True, IsCaseClosed)
| extend TotalLaborMinutes =  iff(not(IsSRCreated), 0.0, TotalLaborMinutes)
| join kind=inner (database("CSS_Secured").Get_WorkflowIdVisits() 
                  | project-away IsHelpEngaged,IsSRCreated, SnapshotTimestamp) on WorkflowId | project-away WorkflowId1
| join kind=leftouter(Modality) on WorkflowId | project-away WorkflowId1
| extend ContactModality=coalesce(ContactModality,'[Empty]')
| extend IsPrevWFHelpEngaged=coalesce(PrevHelpEngaged,false)
| extend IsPrevWFPrevSRCreated=coalesce(PrevSRCreated,false)
| project-away WorkflowId3,PrevHelpEngaged,PrevSRCreated
| extend SolutionType = iff(IsSRCreated, "Support Case","Self-Help Deflection")
}

.create-or-alter function with (folder = "Deflection", docstring = "", skipvalidation = "true") GetLeftShiftLinkData(ParamScanDays:long=84) {
let EndDate = toscalar(database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel	| summarize max(CreatedDateTime))
;
let StartDate=startofday(EndDate,-1*ParamScanDays)
;
database("CXP_CSF").Get_CSF_Annotated(StartDate,EndDate) | project WorkflowId, IsSRCreated
| join kind=inner (
database("CXP_CSF").Get_CSF_Cooked(StartDate,EndDate) 
    | where StepType == 'SelfHelp'  and UpdateItemAction in ('presented','clicked')
    | project WorkflowId, UpdateItemAction,  Link=tostring(extract_all("<(http.+)>",UpdateItemValue)[0])
    | where isnotempty(Link)
    | extend ActionId=case(UpdateItemAction=='clicked',1,0)
    | summarize (ActionId,BestAction) = arg_max(ActionId,UpdateItemAction) by Link, WorkflowId
) on WorkflowId
}

.create-or-alter function with (folder = "Deflection", docstring = "", skipvalidation = "true") GetPPSData() {
let queryStartTime = startofday(ago(7d));
let queryEndTime = endofday(ago(1d));
let binTimeInDays = 7d; // split data into binTimeInDays intervals
let region = "eastus"; // zoom in a region, e.g. "eastus"
let vmSize = ""; // zoom in a SKU, e.g., "standard_d48ds_v4"
let aggregateColumns = "vmSize"; // "": aggregate all, "vmSize": aggregate by vmSize, "vmSize,region": aggregate by vmSize, region
//
 let excludedSubs = cluster('https://vmaprodshared.centralus.kusto.windows.net').database("crp_allprod").PPS_SubIdsNotNeededForPrediction() | project SubscriptionId // set of subIds for synthetic tests 
;
let sizes=cluster('https://vmaprodshared.centralus.kusto.windows.net').database('crp_config').VMSizes | extend ExternalName=tolower(ExternalName) 
;
let PutOps = dynamic(["VirtualMachines.ResourceOperation.PUT", "VirtualMachineScaleSets.ResourceOperation.PUT", "VMScaleSetVMs.VMScaleSetVMsOperation.PUT", "VMScaleSetExtensions.ResourceOperation.PUT", "VMExtensions.VMExtensionOperation.PUT"])
;
let DeleteOps = dynamic(["FabricCallback.OnVMScaleSetVMsEvicted.POST", "VirtualMachineScaleSets.ResourceOperation.DELETE", "VirtualMachineScaleSets.SaveVMStateAndDelete.DELETE", "DeleteVMScaleSetVMsInternalOperation"])
;
let BaseData = cluster('https://vmaprodshared.centralus.kusto.windows.net').database('crp_allprod').VMApiQosEvent
        | where PreciseTimeStamp between (queryStartTime..queryEndTime)
        | where operationName in (PutOps) 
             or operationName in (DeleteOps) //consider these operations for now, small portion of VM creates with PATCH operation is currently not considered.
        | where allocationAction in ("None","VMAddedToTenant","TenantCreated","TenantDeleted","VMRemovedFromTenant") // exclude "VMUpdatedInTenant" and "Invalid"
        | where MonitoringApplication has region or isempty(region)
        | where vMSize == vmSize or isempty(vmSize)
        // not filtering resultType != 0, for several reasons, such as CRP may fail but VM create still succeeds, VMSS overprovision mode
        | where isnotempty(preprovisionedVMReuse) or resourceName startswith_cs "pps-vm"
        | extend IsPPS = resourceName startswith_cs "pps-vm" // IsPPS=True: meaning a PPS source VM
        | extend IsCxCreate = not(IsPPS) and (operationName in (PutOps) or allocationAction in ("VMAddedToTenant","TenantCreated")) // IsCxCreate=True: meaning on-demand VM create
        | project PreciseTimeStamp, vMId,  operationName, IsPPS
                 ,IsPPSReused          = preprovisionedVMReuse == "ReusingPreprovisionedVM"
                 ,vMSize               = tolower(vMSize)
                 ,CxCreateTimeInSecs   = iff(IsCxCreate, durationInMilliseconds/1000.0, 0.0)
                 ,CxCreateTimestamp    = iff(IsCxCreate, PreciseTimeStamp, todatetime(''))
                 ,IsPPSDeletedFromPool = IsPPS and (allocationAction == "TenantDeleted" or operationName in (DeleteOps))
                 ,IsPPSSavedToDisk     = IsPPS and operationName == "VirtualMachineScaleSets.SaveVMStateAndDelete.DELETE"
                 ,IsPPSDiskReused      = preprovisionedVMReuse == "ReusingPreprovisionedVM" and iff(extraVMProperties has "ReusingSavedStatePreprovisionedVM", tobool(parse_json(extraVMProperties)["ReusingSavedStatePreprovisionedVM"]), False)
                 ,IsSyntheticTest      = subscriptionId in (excludedSubs)
                 // https://docs.microsoft.com/en-us/azure/virtual-machines/shared-image-galleries#generalized-and-specialized-images
                 ,IsSpecializedImage   = oSProvisionDurationInSeconds==0 and preprovisionedVMReuse == "VMModelDisqualified"
                 ,IsFailedOp           = resultType != 0
                 ,Region               = tolower(extract('-(.*)_',1,MonitoringApplication))
                 ,ImageType            = case(isnotempty(galleryImage) ,"Gallery"
                                             ,isnotempty(userVMImage)  ,"User"
                                             ,isnotempty(platformImage),"Platform"
                                             ,"")
                 ,extraVMProperties = parse_json(extraVMProperties)
                 ,oSType
                 ,oSDiskStorageAccountType
                 ,allocationAction
                 ,IsCxCreate
                 ,preprovisionedVMReuse
        | evaluate bag_unpack(extraVMProperties)
        | project-away ColocationSkipDetails,OSDiskBlobUrl
;
let Annotation = 
BaseData
    | extend aggrCols = tostring(pack(
            "VMSize", iff(aggregateColumns has "vmSize", vMSize, ""),
            "Region", iff(aggregateColumns has "region", Region, "")))
    | summarize hint.shufflekey=vMId
            IsPPS                           = max(IsPPS or IsPPSDeletedFromPool or IsPPSSavedToDisk or IsPPSDiskReused or IsPPSReused)
           ,IsPPSDeletedFromPool            = max(IsPPSDeletedFromPool or IsPPSSavedToDisk or IsPPSDiskReused)
           ,IsPPSSavedToDisk                = max(IsPPSSavedToDisk or IsPPSDiskReused)
           ,IsPPSReused                     = max(IsPPSReused or IsPPSDiskReused)
           ,IsPPSDiskReused                 = max(IsPPSDiskReused)
           ,IsSyntheticTest                 = max(IsSyntheticTest)
           ,IsSpecializedImage              = max(IsSpecializedImage)
           ,HasFailedOp                     = max(IsFailedOp)
           ,IsCxCreate                      = max(IsCxCreate)
           ,StartTime                       = arg_min(PreciseTimeStamp,vMSize,Region)
           ,CxCreateTime                    = arg_min(CxCreateTimestamp,*) //CxCreateTime can be empty if PPSSourceVM or Regular VM was created outside the queryTime interval
      by vMId, aggrCols
    | where not(IsSyntheticTest) and (IsPPS or IsCxCreate)
    | extend binTimestamp=bin_at(StartTime, binTimeInDays, startofday(now()))
    | project-away IsPPS1
                  ,IsPPSDeletedFromPool1
                  ,IsPPSDiskReused1
                  ,IsPPSReused1
                  ,IsPPSSavedToDisk1
                  ,IsSpecializedImage1
                  ,IsSyntheticTest1
                  ,IsSyntheticTest
                  ,IsFailedOp
                  ,PreciseTimeStamp
                  ,vMSize1
                  ,Region1
                  ,IsCxCreate1
                  ,StartTime
;
Annotation
| where IsCxCreate
| extend IsExceedingMedian = CxCreateTimeInSecs>44.4032912741643
| project-away vMId,aggrCols,CxCreateTime,CxCreateTimeInSecs,TimeCreated,binTimestamp, TipNodeSessionId
}

