.create-or-alter function with (folder = "Cook/Internals", docstring = "", skipvalidation = "true") _Cook_ContainerLogsV2(ParamScanStart:datetime, ParamScanEnd:datetime, ParamTenant:string) {
    // KO Jobs : remote job on SupportAnalysis instance
    //      https://kustoorchestrator-prod-web.azurewebsites.net/Manage/Details?cluster=Accia&database=SupportAnalysis&actorId=MHFLogs_Cook_ContainerLogsV2_AME
    //      https://kustoorchestrator-prod-web.azurewebsites.net/Manage/Details?cluster=Accia&database=SupportAnalysis&actorId=MHFLogs_Cook_ContainerLogsV2_CORP
    // KO AppId:
    //      'aadapp=7a322254-619e-47f5-addd-d5b54facdc1d;72f988bf-86f1-41af-91ab-2d7cd011db47'
    //      Admins : MHFLogs
    //      Viewers: MHFCorpContainerLogsV2, ContainerLogsV2
    // Kusto Func: 
    //      Cook_ContainerLogsV2_AME()
    //      Cook_ContainerLogsV2_CORP()
    //      Get_ContainerLogsV2()
    // Kusto Table
    //      _ContainerLogsV2
    //
    union
        (
            //AME started : datetime(2024-11-01 04:32:21.1244666)
            cluster('accia').database("ContainerLogsV2").ContainerLogsV2 
            | where ParamTenant == 'AME'
        )
       ,(
            //CORP started : datetime(2024-11-07 22:38:32.4066650)
            cluster('accia').database("MHFCorpContainerLogsV2").MHFCorpContainerLogsV2 
            | where ParamTenant == 'CORP'
         )
    | where ingestion_time() between ( ParamScanStart.. ParamScanEnd)
    | mv-expand records
    | evaluate bag_unpack(records)
    | summarize take_any(LogMessage) by
                _Internal_WorkspaceResourceId,
                _ItemId,
                _ResourceId,
                Computer,
                ContainerId,
                ContainerName,
                LogLevel,
                LogSource,
                PodName,
                PodNamespace,
                TenantId,
                TimeGenerated,
                Type
    | extend LogMessage= tostring(LogMessage)
    | invoke Invoker_ExtractIngressLogFields()
    | extend 
         Tenant = ParamTenant,
         //pending remove //Event_IngestionTime = ingestion_time(),
         KO_ProcessedTime= now()
}

