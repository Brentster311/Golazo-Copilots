.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_AddAvaData(T:(SupportRequestNumber:string), ParamScanStart:datetime, ParamScanEnd:datetime=datetime(2099-09-09T00:00:00.0000000Z)) {
    // SAMPLE USAGE
    //      database("LeftShift").GetCSFData(ago(30d))|where InitialProductId==16450|invoke Invoker_AddAvaData(ago(90d), now())|where HasAvaRequest
    //      database("LeftShift").GetCSFData(ago(30d))|invoke Invoker_AddAvaData(ago(90d), now())|summarize AvaCount =countif(HasAvaRequest), SrCount = count() by InitialProductName|extend pct = 1.0*AvaCount/SrCount|order by SrCount desc|take 20
    // 
    // TEMP ETL 180d to CSS_Secured until figure out permission : ~68K for 180d
    //      .set-or-replace AvaCaseBi <| cluster('Ava').database('ava-bi').CasesBi |where TimeCreated >= ago(180d)
    //
    //let ParamScanStart=ago(30d); let ParamScanEnd = ago(3d); let T = GetCSFData(ParamScanStart,ParamScanEnd) | where isnotempty(SupportRequestNumber);
    let AvaData=
        cluster('ACCIA').database('CSS_Secured').AvaCaseBi
        //cluster('Ava').database('ava-bi').CasesBi 
        | where TimeCreated >=ParamScanStart and TimeCreated < ParamScanEnd
        | summarize 
            // Expect single Ava Request per SR, but observed dedup
            arg_max( TimeCreated
                    ,TimeFirstCheckedByExpert
                    ,TimeLastCheckedByExpert 
                    ,ChannelName
                    ,TimeOfLastMessage 
                    ,TimeWaitedForHelpInMinutes 
                    ,WaitedForHelpNotificationCount
                    ,IsArchivedInBot 
                    //,SupportEngineerAlias
                    //,Expert 
                    //,ExpertAlias
                    //,Conversation
                    )
            by SupportRequestNumber = CaseNumber
        |project-rename 
                 AvaTimeCreated = TimeCreated
                ,AvaTimeFirstCheckedByExpert = TimeFirstCheckedByExpert
                ,AvaTimeLastCheckedByExpert = TimeLastCheckedByExpert
                ,AvaTimeOfLastMessage = TimeOfLastMessage
                ,AvaTimeWaitedForHelpInMinutes = TimeWaitedForHelpInMinutes
                ,AvaWaitedForHelpNotificationCount = WaitedForHelpNotificationCount
                ,AvaIsArchivedInBot  = IsArchivedInBot 
        ;
    T 
    | join hint.shufflekey=SupportRequestNumber kind=leftouter (AvaData) on SupportRequestNumber 
    | extend HasAvaRequest = isnotempty(SupportRequestNumber1) 
    | project-away SupportRequestNumber1
}

.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_AddCaseData(T:(SupportRequestNumber:string), ParamScanStart:datetime, ParamScanEnd:datetime=datetime(2099-9-9)) {
    // SAMPLE USAGE
    //      GetCSFData(30)|where InitialProductId==16450|invoke Invoker_AddCaseData(ago(30d), now())|where IsCollabTasks_Exist
    //
// let ParamScanEnd = toscalar(database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel	| summarize max(CreatedDateTime))
// ;
// let ParamScanStart=startofday(ParamScanEnd,-1*7)
// ;
// let T = GetCSFData(ParamScanStart,ParamScanEnd) | where isnotempty(SupportRequestNumber)|take 100
// ;
let CaseData=database("SupportAnalysis").AllCloudsSupportIncidentWithReferenceModelVNext 
| where CreatedDateTime >=ParamScanStart and CreatedDateTime < ParamScanEnd
| extend CurrentParentPathName = strcat_array((array_split(split(SapPath,@"/"),-1)[0]) , @'/')       // Get parent of leaf
| extend CurrentParentPathName = iif(CurrentParentPathName contains @'/', CurrentParentPathName, '') // Remove if parent is product
| project SupportRequestNumber=IncidentId
                              ,CurrentPathName=SapPath
                              ,CurrentParentPathName 
                              ,CurrentProductName=EligibleSupportProductName // ATTENTION: This could mismatch with ProductId. Should get from ActiveTopicTree but join is expansive
                              ,ServiceName
                              ,Causetxt
                              ,Symptomstxt
                              ,Resolutiontxt
                              ,RootCauseSupportTopic
                              ,CurrentProductId=ProductId
                              ,CurrentLeafTopicId=''//tostring(split(SupportTopicId,@"\")[-1])
                              ,IsProductRouteOut = EligibilityProductId!=ProductId
                              ,TotalLaborMinutes=round(toreal(TotalLabourMinutes),0)
                              ,IsCaseClosed = State == 'Resolved'
                              ,TotalCalendarMinutesSpent = (coalesce(ClosedDateTime,now()) - CreatedDateTime)/1m
                              ,IsRouteOut = InitialSapId != SapId
                              ,IsCustomerNotResolved =not(IsResolved)
                              ,CSAT=1.0*TotalCsatScore/TotalSurveys
                              ,CSATSurveyVerbatim =SurveyVerbatims
                              ,IsRelatedToICM,IsRelatedToOutage, RelatedICM_IDs, RelatedOutage_IDs
| extend IsTopicRouteOut = not(IsProductRouteOut) and IsRouteOut
;
T 
| join hint.shufflekey=SupportRequestNumber kind=leftouter (CaseData) on SupportRequestNumber 
| extend IsMissingCaseData= isempty(SupportRequestNumber1) 
| project-away SupportRequestNumber1
}

.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_AddCollabTasksData(T:(SupportRequestNumber:string)) {
    // SAMPLE USAGE
    //      GetCSFData(30)|where InitialProductId==16450|invoke Invoker_AddCollabTasksData()|where IsCollabTasks_Exist
    //      GetCSFData(90)|invoke Invoker_AddCollabTasksData()|consume
    //
    //let ScanDays = 28;let ParamScanStart= ago(1d*ScanDays); let ParamScanEnd = now(); let T = GetCSFData(ScanDays);
    let collab_tasks = materialize (
        T 
        | invoke Invoker_GetCollabTasksRaw() // RETURNS : CollabTask dataset with IncidentId * CollabTaskId as primary key, do NOT include metadata from T
        | summarize hint.strategy=shuffle 
                CollabTasks_Count           = count()
               ,CollabTasks_ProductIds      = make_set(todynamic(CT_ProductId))
               ,CollabTasks_SapIds          = make_set(todynamic(CT_SapId))
               ,CollabTasks_Queues          = make_set(todynamic(CT_QueueId))
               ,CollabTasks_DaysToClosure   = sum(CT_DaysToClosure)
               ,CollabTasks_TimespanInDays  = (max(CT_ModifiedDateTime) - min(CT_CreatedDateTime))/1d
               ,CollabTasks_Link_MSDocs     = make_set(CT_Link_MSDocs)
               ,CollabTasks_Link            = make_set(CT_Link)
               ,CollabTasks_Text            = make_set(todynamic(CT_Description))
                by SupportRequestNumber
        );
    union
        (
            T
            | where SupportRequestNumber in((collab_tasks|project SupportRequestNumber))
            | join kind = leftouter  hint.strategy=shuffle (collab_tasks) on SupportRequestNumber 
            | project-away SupportRequestNumber1
            | extend IsCollabTasks_Exist = True
       )
      ,(
            T
            | where SupportRequestNumber !in((collab_tasks|project SupportRequestNumber))
            | extend IsCollabTasks_Exist = False
       )
    | extend 
            CollabTasks_Count           = coalesce(CollabTasks_Count,0)
           ,CollabTasks_ProductCount    = coalesce(array_length(CollabTasks_ProductIds),0)
           ,CollabTasks_TopicCount      = coalesce(array_length(CollabTasks_SapIds),0)
           ,CollabTasks_QueueCount      = coalesce(array_length(CollabTasks_Queues),0)
           ,CollabTasks_ProductIds      = strcat_array(CollabTasks_ProductIds,',')
           ,CollabTasks_SapIds          = strcat_array(CollabTasks_SapIds,',')
           ,CollabTasks_Queues          = strcat_array(CollabTasks_Queues,',')
           ,CollabTasks_Link_MSDocs     = strcat_array(CollabTasks_Link_MSDocs,',')
           ,CollabTasks_Link            = strcat_array(CollabTasks_Link,',')
           ,CollabTasks_Text            = strcat_array(CollabTasks_Text,',')
    | extend IsCollabTasks_CrossProduct = isnotempty(CollabTasks_ProductIds) and CollabTasks_ProductCount >1 //PENDING: This assumes ProductId is logged properly
}

.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_AddInsightsData(T:(WorkflowId:guid,SupportRequestNumber:string), ParamScanStart:datetime=datetime(2011-01-01T00:00:00.0000000Z), ParamScanEnd:datetime=datetime(2099-09-09T00:00:00.0000000Z)) {
    // SAMPLE USAGE
    //      GetCSFData(ago(30d))|where InitialProductId==16450|invoke Invoker_AddInsightsData()| take 10
    //      GetCSFData(ago(90d))|where InitialProductId==16450|invoke Invoker_AddInsightsData()|summarize count() by isnotempty(AscInsight_SymptomId_Set)
    //      GetLeftShiftData(90, ParamProductList=16450)|invoke Invoker_AddInsightsData(ago(90d))|summarize count() by isnotempty(AscInsight_SymptomId_Set)
    //
    // ETL due to permission issue
    //      .set-or-replace Azds_adsmds_calculated_ASCinsightInformation <|cluster('Azds').database('adsmds').calculated_ASCinsightInformation| where isnotempty(ASCInsightInformation_telemetryTypeDisplayed_ASCCaseDashboard)
    //
    //let ParamScanStart=ago(90d); let ParamScanEnd = now(); let T = GetCSFData(ParamScanStart=ParamScanStart)|where InitialProductId==16450;
    T
        | join kind = leftouter hint.strategy=shuffle (
            // 3 month retention
            // ETL due to permission issue
            //cluster('Azds').database('adsmds').calculated_ASCinsightInformation
            cluster('ACCIA').database('Playground_Wei').Azds_adsmds_calculated_ASCinsightInformation
                | where ASCInsightInformation_GenerationTime between (ParamScanStart .. ParamScanEnd)
                | where isnotempty(ASCInsightInformation_telemetryTypeDisplayed_ASCCaseDashboard)   // Reuse filter from InsightsRanker
                | where ASCInsightInformation_telemetryTypeOpened_ASCCaseDashboard == 'Opened'
                | project
                         SupportRequestNumber  = ASCInsightInformation_ServiceRequestId
                        ,AscInsight_SymptomId  = ASCInsightInformation_SymptomId
                        ,AscInsight_FriendlyName   = ASCInsightInformation_InsightFriendlyName
                        ,AscInsight_IsFirtOpened = ASCInsightInformation_telemetryTypeOpened_ASCCaseDashboard
            ) on SupportRequestNumber 
            | extend SupportRequestNumber = SupportRequestNumber1
            // dedup after join since insight rate is low
            | summarize 
                    AscInsight_SymptomId_Set    = make_set(todynamic(AscInsight_SymptomId))
                   ,AscInsight_FriendlyName_Set = make_set(todynamic(AscInsight_FriendlyName))
                   ,(AscInsight_IsFirtOpened, AscInsight_FirstOpened_SymptomId,AscInsight_FirstOpened_FriendlyName) 
                                                = arg_max(AscInsight_IsFirtOpened,AscInsight_SymptomId,AscInsight_FriendlyName)
                   ,take_any(*)
                    by WorkflowId, SupportRequestNumber
            | project-away AscInsight_IsFirtOpened
} 

.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_AddUsageData(T:(SubscriptionId:guid,StartWorkflowTimestamp:datetime), ParamScanStart:datetime, UsageType:string="Monthly") {
// 
// let ParamScanEnd = toscalar(database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel | summarize max(CreatedDateTime))
// ;
// let ParamScanStart=startofday(now(),-1*91)
// ;
// let UsageType = 'monthly'
// ;
// let T = GetCSFData(datetime(2022-9-1),datetime(2022-10-1) )
// | where isnotempty(SupportRequestNumber)// == 2204250040005345
// ;
let UsageIncr = case(tolower(UsageType)=='monthly',28
                    ,tolower(UsageType)=='weekly',7
                    ,1)
;
let LastDate = toscalar(database("AzureCoreCSI").ComputeSubscriptionAnnotations | summarize max(Timestamp))
;
let Usage = database("AzureCoreCSI").ComputeSubscriptionAnnotations
                        | where Timestamp >= ParamScanStart
                        | project Timestamp,SubscriptionId=toguid(SubscriptionId)
                                 ,AverageDailyCoreHours= case(UsageIncr==28, Monthly_CoreHours, UsageIncr==7, Weekly_CoreHours,Daily_CoreHours)
;
T
| extend Timestamp=startofday(StartWorkflowTimestamp)
| join hint.shufflekey=SubscriptionId kind=leftouter  (Usage) on SubscriptionId,Timestamp
| extend  AverageDailyCoreHoursBeforeSR=coalesce(AverageDailyCoreHours,0.0)
| project-away SubscriptionId1,Timestamp1,  AverageDailyCoreHours
| extend Timestamp = Timestamp+UsageIncr*1d
| extend IsInFuture = Timestamp> LastDate
| join hint.shufflekey=SubscriptionId kind=leftouter  (Usage) on SubscriptionId,Timestamp
| extend  AverageDailyCoreHoursAfterSR=coalesce(AverageDailyCoreHours,iff(not(IsInFuture),0.0,toreal('')))
         ,UsageIncrementInDays=UsageIncr
| project-away SubscriptionId1,Timestamp1, AverageDailyCoreHours
| extend AverageDailyVCoreHoursIncrease        = iff(not(IsInFuture),AverageDailyCoreHoursAfterSR-AverageDailyCoreHoursBeforeSR,toreal(''))
| extend IsVCoreUsageIncreased = iff(not(IsInFuture) and AverageDailyVCoreHoursIncrease>=UsageIncr/7.0,True, False)
| extend IsVCoreUsageDecreased = iff(not(IsInFuture) and AverageDailyVCoreHoursIncrease<0 ,True, False)
| project-away AverageDailyCoreHoursAfterSR, AverageDailyCoreHoursBeforeSR, IsInFuture,Timestamp,UsageIncrementInDays
}

.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_GetCollabTasksRaw(T:(SupportRequestNumber:string), ParamCTProductId:string="", ParamSampleTaskCount:long=0, ParamClosedTaskOnly:bool=true) {
    // RETURNS : CollabTask dataset with IncidentId * CollabTaskId as primary key, do NOT include metadata from T
    // 
    // SAMPLE USAGE
    //      database('CXP_CSF').AllCloudsSupportIncidentWithReferenceModel|where CreatedDateTime > ago(40d)| where State == 'Closed' | project SupportRequestNumber = IncidentId|take 1000|invoke Invoker_GetCollabTasksRaw()
    //
    //let ParamSampleTaskCount = 0;let ParamCTProductId= ''; let ParamClosedTaskOnly= True; let T = database('CXP_CSF').AllCloudsSupportIncidentWithReferenceModel|where CreatedDateTime > ago(40d)| project SupportRequestNumber = IncidentId|take 10000;
    let url_pattern = @"(https?://[-a-zA-Z0-9@:%._\+~#=/?&*{}\[\]]*)"; // Need to support scrubbing, e.g. [redacted], {subscription_id}
    cluster('ACCIA').database('CSS_Secured').MSaaS_IncidentTaskComputed
    | where isempty(ParamCTProductId) or ParamCTProductId== ProductId
    | where (ParamClosedTaskOnly and State =='ClosedCompleted') or not(ParamClosedTaskOnly)
    | where TaskType == "CollaborationTask"  and  isnotempty( IncidentId)
    | where SapId != 'f3d777ec-5ba5-fa63-8aaa-59fdc72be955' // Exclude "Azure/Azure Customer Recovery (Manager Engagement Only)"
    | where IncidentId in ((T|project SupportRequestNumber))
    | as a |where ParamSampleTaskCount ==0 |union (a|take ParamSampleTaskCount)
    | project-away DataSource, EndsOn,EntitySchemaVersion
    | extend    parsed_url = extract_all(url_pattern, Description)    
    | mv-expand parsed_url to  typeof(string)
    | summarize arg_max(ModifiedDateTime,*) 
               ,CT_DaysToClosure = (maxif(ClosedDateTime, State != 'Open')- min(CreatedDateTime))/1d
               ,CT_Link_MSDocs   = make_set_if(todynamic(parsed_url), parsed_url contains "docs.microsoft.com")
               ,CT_Link          = make_set(todynamic(parsed_url))
                by IncidentId, IncidentTaskId // Keep latest record per IncidentId * TaskId
    | extend    CT_RoutingContextId= tostring(todynamic(ExtendedProperties)['RoutingContextId'])
    //
    | project-rename 
               SupportRequestNumber = IncidentId
              ,CT_ProductId = ProductId
              ,CT_SapId=SapId
              ,CT_CreatedDateTime=CreatedDateTime
              ,CT_ModifiedDateTime= ModifiedDateTime
              ,CT_Description=Description
    // Get Product/Topic metadata
    | join kind = leftouter(
            database('CXP_CSF').ActiveTopicTree
            | project 
               CT_IsActiveLeaf=IsActiveLeaf
              ,CT_SapId=LeafTopicSapId
              ,CT_ProductName=ProductName
              ,CT_PathName = PathName
              ,CT_L2PathName = strcat(ProductName,'/',SupportTopicL2Name)
              ,CT_IsTetris = IsTetris
             ) on CT_SapId |project-away CT_SapId1
    // Get queue metadata
    | join kind = leftouter(
            database('CSS_Secured').MSaaS_IncidentQueue 
            | where QueueId != "3ce2f48e-5729-e811-814f-002dd8151759" //MSaaS Rave Transfers
            | summarize arg_max(ModifiedDateTime,*) by QueueId
            | project CT_QueueId = QueueId, CT_QueueName = Name, CT_QueueDesc = Description
            ) on $left.CT_RoutingContextId==$right.CT_QueueId
            | project-away CT_RoutingContextId
    | project-reorder SupportRequestNumber, IncidentTaskId, CT*Name,CT*Link*,*Desc*, CT*Id, parsed_url
} 

.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_GetCollabTasksRaw_Wei(T:(SupportRequestNumber:string), ParamCTProductId:string="", ParamSampleTaskCount:long=0, ParamClosedTaskOnly:bool=True) {
    // RETURNS : CollabTask dataset with IncidentId * CollabTaskId as primary key, do NOT include metadata from T
    // 
    // SAMPLE USAGE
    //      database('CXP_CSF').AllCloudsSupportIncidentWithReferenceModel|where CreatedDateTime > ago(40d)| where State == 'Closed' | project SupportRequestNumber = IncidentId|take 1000|invoke Invoker_GetCollabTasksRaw_Wei()
    //
    // let ParamSampleTaskCount = 0;let ParamCTProductId= ''; let ParamClosedTaskOnly= True; let T = database('CXP_CSF').AllCloudsSupportIncidentWithReferenceModel|where CreatedDateTime > ago(40d)| project SupportRequestNumber = IncidentId|take 1000;
    cluster('ACCIA').database('CSS_Secured').MSaaS_IncidentTaskComputed
    | where isempty(ParamCTProductId) or ParamCTProductId== ProductId
    | where (ParamClosedTaskOnly and State =='ClosedCompleted') or not(ParamClosedTaskOnly)
    | where TaskType == "CollaborationTask"  and  isnotempty( IncidentId)
    | where SapId != 'f3d777ec-5ba5-fa63-8aaa-59fdc72be955' // Exclude "Azure/Azure Customer Recovery (Manager Engagement Only)"
    | where IncidentId in ((T|project SupportRequestNumber))
    | as a |where ParamSampleTaskCount ==0 |union (a|take ParamSampleTaskCount)
    | project-away DataSource, EndsOn,EntitySchemaVersion
    | summarize arg_max(ModifiedDateTime,*) 
               ,CT_DaysToClosure = (maxif(ClosedDateTime, State != 'Open')- min(CreatedDateTime))/1d
                by IncidentId, IncidentTaskId // Keep latest record per IncidentId * TaskId
    | extend    CT_RoutingContextId= tostring(todynamic(ExtendedProperties)['RoutingContextId'])
    // dummy URL parser
    |parse Description with * 'http://' URL11 ' ' *
    |parse Description with * 'http://' URL12
    |parse Description with * 'https://' URL21 ' ' *
    |parse Description with * 'https://' URL22
    | extend URL1 = coalesce(URL11,URL12), URL2 = coalesce(URL21,URL22)
    | extend URL1 = iif(isempty( URL1), '', strcat('http://', URL1))
            ,URL2 = iif(isempty( URL2), '', strcat('https://', URL2))
    |extend CT_Link = coalesce(URL1, URL2)|project-away URL* 
    |extend CT_Link_MSDocs=iif(CT_Link contains "docs.microsoft.com", CT_Link, '')
    //
    | project-rename 
               SupportRequestNumber = IncidentId
              ,CT_ProductId = ProductId
              ,CT_SapId=SapId
              ,CT_CreatedDateTime=CreatedDateTime
              ,CT_ModifiedDateTime= ModifiedDateTime
              ,CT_Description=Description
    // Get Product/Topic metadata
    | join kind = leftouter(
            database('CXP_CSF').ActiveTopicTree
            | project 
               CT_IsActiveLeaf=IsActiveLeaf
              ,CT_SapId=LeafTopicSapId
              ,CT_ProductName=ProductName
              ,CT_PathName = PathName
              ,CT_L2PathName = strcat(ProductName,'/',SupportTopicL2Name)
              ,CT_IsTetris = IsTetris
             ) on CT_SapId |project-away CT_SapId1
    | project-reorder SupportRequestNumber, IncidentTaskId, CT*Name,CT*Link,*Desc*, CT*Id
}

.create-or-alter function with (folder = "LeftShift/SupportCases", docstring = "", skipvalidation = "true") Adhoc_CollabTasks(ParamSRProductId:string="", ParamCTProductId:string="", ParamScanRange:timespan=90d, ParamIdCol:string="CT_L2PathName", ParamStopwords:string="[\"issue\",\"redacted\", \"namepii\",\"ipaddresspii\", \"alphanumericpii\",\"guidpii\",\"emailpii\",\"precisetimestamp\",\"in\",\"microsoft\",\"azure\",\"cx\"]", ParamSampleCount:long=20) {
    // Data Selection:
    //      All Closed SR  & Closed CollabTasks
    //      
    // SAMPLE USAGE
    //      // All up - L2 as potential provider of KG
    //      Adhoc_CollabTasks(ParamIdCol='CT_L2PathName', ParamScanRange=30d)
    //      Adhoc_CollabTasks(ParamIdCol='CT_QueueName', ParamScanRange=30d)
    //
    //      // All up - Service as potential receiver of KG
    //      Adhoc_CollabTasks(ParamIdCol='Closed_ProductName', ParamScanRange=30d)
    //
    //      // AKS 
    //      Adhoc_CollabTasks(ParamSRProductId = 16450,ParamIdCol='', ParamScanRange=90d)
    //      Adhoc_CollabTasks(ParamSRProductId = 16450,ParamIdCol='CT_ProductName', ParamScanRange=90d)
    //      Adhoc_CollabTasks(ParamSRProductId = 16450,ParamIdCol='CT_L2PathName', ParamScanRange=90d)
    //      Adhoc_CollabTasks(ParamSRProductId = 16450,ParamIdCol='CT_PathName', ParamScanRange=90d)
    //      Adhoc_CollabTasks(ParamSRProductId = 16450,ParamIdCol='CT_QueueName', ParamScanRange=90d)
    //      
    //      Adhoc_CollabTasks(ParamCTProductId = 16450,ParamIdCol='Closed_ProductName', ParamScanRange=90d)
    //
    //----------------------------------------------------
    //
    //let ParamSRProductId='';let ParamCTProductId=''; let ParamScanRange = 30d;let ParamIdCol= 'CT_L2PathName';let ParamStopwords='["ak", "aks","issue","redacted", "namepii","ipaddresspii", "alphanumericpii","guidpii","cx","precisetimestamp","in","microsoft","azure"]';
    cluster('ACCIA').database('CXP_CSF').GetSupportRequestsWithReferenceModel()
    | where CreatedDate >ago(ParamScanRange)
    | where isempty(ParamSRProductId) or ParamSRProductId == ProductId 
    | where State == 'Closed' | extend Closed_ProductId=ProductId
    | as T
    | invoke Invoker_GetCollabTasksRaw_Wei(ParamCTProductId=ParamCTProductId)
    //PENDING: Add into invoker
    | join kind = leftouter(
            database('CSS_Secured').MSaaS_IncidentQueue 
            | where QueueId != "3ce2f48e-5729-e811-814f-002dd8151759" //MSaaS Rave Transfers
            | summarize arg_max(ModifiedDateTime,*) by QueueId
            | project CT_QueueId = QueueId, CT_QueueName = Name, CT_QueueDesc = Description
            ) on $left.CT_RoutingContextId==$right.CT_QueueId
            | project-away CT_RoutingContextId
    // Get back SR metadata
    | join kind = inner(T|project SupportRequestNumber, Closed_ProductId) on SupportRequestNumber|project-away SupportRequestNumber1
    | join kind = leftouter(database('CXP_CSF').ActiveTopicTree| summarize by  Closed_ProductId=ProductId,Closed_ProductName=ProductName) on Closed_ProductId |project-away Closed_ProductId1
    // Prep for TFIDF
    | extend Id=case(
                    ParamIdCol == 'Closed_ProductName'  ,Closed_ProductName
                   ,ParamIdCol == 'CT_ProductName'      ,CT_ProductName
                   ,ParamIdCol == 'CT_L2PathName'       ,CT_L2PathName
                   ,ParamIdCol == 'CT_PathName'         ,CT_PathName
                   ,ParamIdCol == 'CT_QueueName'        ,case(
                                                                isempty(CT_QueueName)           , ''
                                                               ,CT_QueueName ==CT_QueueDesc     , CT_QueueName
                                                                                                , strcat(CT_QueueName , ' |  ', CT_QueueDesc))
                                                        ,'Single_Id'
                   )
    | where isnotempty(Id) and isnotempty( CT_Description)
    | project Id=strcat(ParamIdCol, ' = ', Id)
             ,Verbatim=database('CSS_Secured').Scalar_RemoveStopWords(CT_Description, ParamStopwords)
             ,SupportRequestNumber, IncidentTaskId
             ,CT_Description, CT_Link,CT_Link_MSDocs
             ,CT_ProductId,CT_SapId,CT_IsTetris
             ,Closed_ProductId,Closed_ProductName
    | as T1
    | invoke database('CSS_Secured').Invoker_GetTFIDFVectors()
    | invoke database('CSS_Secured').Invoker_GetTermsFromResultVector()
    | where tostring(tolong(term)) != term  // Remove number tokens
    | order by score desc 
    | summarize CT_TopTerms = make_list(strcat(term, ' ', round(score, 4)), 20)by Id
    // Get back non-NLP features
    | join kind = inner(
            T1
            |summarize 
                    SR_Count=array_length(make_set(todynamic(SupportRequestNumber)))
                   ,CT_Count=array_length(make_set(todynamic(IncidentTaskId)))
                   ,SR_ProductCount = array_length(make_set(todynamic(Closed_ProductId)))
                   ,CT_ProductCount = array_length(make_set(todynamic(CT_ProductId)))
                   ,CT_TopicCount = array_length(make_set(todynamic(CT_SapId)))
                   ,CT_TetrisTopicCount =array_length(make_set_if(todynamic(CT_SapId),CT_IsTetris))
                   ,SampleLink_MSDocs = make_set(todynamic(CT_Link_MSDocs),ParamSampleCount)
                   ,SampleLink = make_set(todynamic(CT_Link),ParamSampleCount)
                   ,SampleDescriptions=make_set(todynamic(CT_Description),ParamSampleCount)
                   ,SampleSR = make_set(SupportRequestNumber,ParamSampleCount)
                   by Id
                   )on Id|project-away Id1
    | order by SR_Count desc
    | project-reorder Id, *In_Id*, *Count
}

// List of functions in Accia.LeftShift.Users collection

// List of functions in Accia.LeftShift.Invokers collection

.create-or-alter function with (folder = "LeftShift/Users/Invokers", docstring = "", skipvalidation = "true") Invoker_AddUserMetadata(T:(WorkflowId:guid)) {
T
| join hint.strategy=shuffle kind=leftouter  (database("CSS_Secured").Get_WorkflowIdVisits()
                        | project CSFVisit,ProductCSFVisit, PDSRgV,WorkflowId
                        ) on WorkflowId | project-away WorkflowId1
| extend PDSRgVThreshold_High = 0.7
| extend PDSRgVThreshold_Low = 0.4
| extend IsNewCSFUser = CSFVisit <= 2
| extend IsCaseCreator = not(IsNewCSFUser) and (PDSRgV>=PDSRgVThreshold_High)
| extend IsTroubleshooter = not(IsNewCSFUser) and (PDSRgV<=PDSRgVThreshold_Low)
| project-away PDSRgVThreshold_High ,PDSRgVThreshold_Low,PDSRgV
}

// List of functions in Accia.LeftShift.Verbatim collection

// List of functions in Accia.LeftShift.Invokers collection

.create-or-alter function with (folder = "LeftShift/Verbatim/Invokers", docstring = "", skipvalidation = "true") Invoker_AddVerbatim(T:(WorkflowId:guid), IncludeStopwords:bool=True) {
let Verbatim =database('CSS_Secured').GetCSFVerbatim()
            | project WorkflowId, Verbatim = coalesce(Translation, IssueSummary)
            | extend Verbatim= iff(IncludeStopwords,database('CSS_Secured').Scalar_CleanVerbatim(Verbatim)
                                                   ,database('CSS_Secured').Scalar_RemoveStopWords(Verbatim, '[]'))
;
T
| join kind=leftouter  (Verbatim) on WorkflowId | project-away WorkflowId1
}

.create-or-alter function with (folder = "LeftShift", docstring = "", skipvalidation = "true") GetLeftShiftData(ParamScanDays:long=84, ParamProductList:string="", ParamL2List:string="", ParamL3List:string="") {
// SAMPLE USAGE
//      GetLeftShiftData(7)|take 100
//      GetLeftShiftData(90,16450) //AKS
//      GetLeftShiftData(7) |getschema|order by ColumnName
// 
// 
// let ParamScanDays=91; let ParamProductList='14749, 12345'; let ParamL2List='32615525, 12345';
let CSFVisitSnapshotTime = toscalar(database("CSS_Secured").Get_WorkflowIdVisits() | summarize  max(startofday(SnapshotTimestamp,-1)))
;
let SupportCaseSnapshotTime = toscalar(database("CARETProd").AllCloudsSupportIncidentWithReferenceModelVNext | summarize max(startofday(CreatedDateTime,1)))
;
let EndDate = min_of(CSFVisitSnapshotTime,SupportCaseSnapshotTime)
;
let StartDate=startofday(EndDate,-1*ParamScanDays)
;
database("LeftShift").GetCSFData(StartDate,EndDate)
| where isempty(ParamProductList) 
        or ParamProductList == 'AllProducts'
        or InitialProductId == ParamProductList 
        or (strcat(ParamProductList, ',') contains strcat(InitialProductId,',') and isnotempty(InitialProductId))
| where isempty(ParamL2List) 
        or ParamL2List == 'All'
        or InitialL2TopicId == ParamL2List 
        or (strcat(ParamL2List, ',') contains strcat(InitialL2TopicId,',') and isnotempty(InitialL2TopicId))
| where isempty(ParamL3List) 
        or ParamL3List == 'All'
        or InitialL3TopicId == ParamL3List 
        or (strcat(ParamL3List, ',') contains strcat(InitialL3TopicId,',') and isnotempty(InitialL3TopicId))
| invoke database("LeftShift").Invoker_AddUsageData(ParamScanStart=StartDate)
| invoke database("LeftShift").Invoker_AddSubscriptionMetadata()
| invoke database("LeftShift").Invoker_AddUserMetadata()
| invoke database("LeftShift").Invoker_AddIcMMetadata(StartDate)
| invoke database("LeftShift").Invoker_AddCaseData(ParamScanStart=StartDate, ParamScanEnd=EndDate)
// Lost access
    //| invoke database("LeftShift").Invoker_AddCollabTasksData() 
    | extend IsCollabTasks_Exist = False, CollabTasks_Count=0, CollabTasks_Text=''
//| invoke database("LeftShift").Invoker_AddIcMMetadata_V2()
| extend IsCRI          = IsCRI or IsRelatedToICM       // PENDING : Source data quality check for IcM.IsCRI, P360.IsRelatedToICM
//| extend IsKnowledgeGap = IsCRI or IsCollabTasks_Exist
| extend ScanStartDate=StartDate,ScanEndDate=EndDate
// make adjustments for workflows that were deflections and add annotation labels
| extend CurrentLeafTopicId=coalesce(CurrentLeafTopicId,iff(not(IsSRCreated),InitialLeafTopicId,tostring('')))
| extend CurrentProductId =coalesce(CurrentProductId,iff(not(IsSRCreated),InitialProductId,tostring('')))
| extend CurrentPathName=coalesce(CurrentPathName,iff(not(IsSRCreated),InitialPathName,tostring('')))
| extend CurrentProductName=coalesce(CurrentProductName,iff(not(IsSRCreated),InitialProductName,tostring('')))
| extend IsProblemClosed=coalesce(IsCaseClosed,iff(not(IsSRCreated),True,tobool('')))
| extend GapClass = case(not(IsSRCreated)                  ,dynamic([3,"Product Gap"])
                        ,not(IsCRI or IsCollabTasks_Exist) ,dynamic([2,"Solution Gap"]) 
                                                           ,dynamic([1,"Knowledge Gap"]))
// strrep is used below as a complete hack so PowerBi sorts correctly.
| extend GapType  = strcat(strrep(' ',tolong(GapClass[0])-1) ,GapClass[1])
        ,GapId    = tolong(GapClass[0])     
| extend KnowledgeAskCount=CollabTasks_Count+iff(isempty(RelatedCRI_Ids),toint(IsCRI), array_length(split(RelatedCRI_Ids,',')))
//cheap
| extend CostClass = case(IsProblemClosed and (TotalLaborMinutes ==  0 or isempty(TotalLaborMinutes)) ,dynamic([3,'Free'])
                         ,IsProblemClosed and TotalLaborMinutes <= 60                                 ,dynamic([2,'Cheap']) 
                         ,IsProblemClosed and TotalLaborMinutes <=200                                 ,dynamic([1,'Typical']) 
                         ,IsProblemClosed and TotalLaborMinutes > 200                                 ,dynamic([0,'Expensive']) 
                                                                                                      ,dynamic([-1,'Unknown']))  
| extend CostLabel  = strcat(CostClass[0] ,': ',CostClass[1])
        ,CostId     = tolong(CostClass[0])
//fast
| extend SpeedClass = case(TotalCalendarMinutesSpent <= 240                     ,dynamic([3,'Quick Case']) //4 hrs
                          ,TotalCalendarMinutesSpent <= 1440                    ,dynamic([2,'Fast Case'])  // 1 day
                          ,TotalCalendarMinutesSpent <= 10080                   ,dynamic([1,'Typical Case']) // 1 weeks
                          ,TotalCalendarMinutesSpent > 10080                   ,dynamic([0,'Slow Case']) 
                                                                               ,dynamic([-1,'Unknown']))  
| extend SpeedLabel = strcat(SpeedClass[0],': ',SpeedClass[1])
        ,SpeedId    = tolong(SpeedClass[0])
| extend CollabClass = case(SpeedId>1 and KnowledgeAskCount==1                     ,dynamic([3,'Minor Collab']) 
                           ,KnowledgeAskCount==1                                   ,dynamic([2,'Typical Collab'])  
                           ,KnowledgeAskCount ==2                                  ,dynamic([1,'Major Collab']) 
                           ,KnowledgeAskCount >2                                   ,dynamic([0,'Massive Collab']) 
                                                                                   ,dynamic([-1,'Unknown']))  
| extend CollabLabel  = strcat(CollabClass[0] ,': ',CollabClass[1])
        ,CollabId     = tolong(CollabClass[0])
// deflection
| extend DeflectionClass = case(not(IsSRCreated) and IsHelpPresented and IsQuickFixEngaged         ,dynamic([3,'Automated Deflection'])
                               ,not(IsSRCreated) and IsHelpPresented and IsHelpEngaged             ,dynamic([2,'Engaged Deflection']) 
                               ,not(IsSRCreated) and IsHelpPresented                               ,dynamic([1,'Presented Deflection']) 
                               ,not(IsSRCreated) and not(IsHelpPresented)                          ,dynamic([0,'Helpless Deflection'])
                                                                                                   ,dynamic([-1,'Unknown']))  
| extend DeflectionLabel  = strcat(DeflectionClass[0] ,': ',DeflectionClass[1])
        ,DeflectionId     = tolong(DeflectionClass[0])
//phase annotations
| extend Annotation = case(DeflectionId==3                                                          ,dynamic([12,'Automated Deflection'])
                          ,DeflectionId==2                                                          ,dynamic([11,'Engaged Deflection']) 
                          ,DeflectionId==1                                                          ,dynamic([10,'Presented Deflection']) 
                          ,DeflectionId==0                                                          ,dynamic([9,'Helpless Deflection'])
                          ,IsSRCreated and IsMissingCaseData                                        ,dynamic([-1,'Case data missing'])
                          ,GapId ==2 and IsCustomerNotResolved                                      ,dynamic([4,'Not Solved Case'])
                          ,SpeedId==3  and GapId ==2                                                ,dynamic([8,'Quick Case']) //16 hrs
                          ,SpeedId==2  and GapId ==2                                                ,dynamic([7,'Fast Case'])  // 1 week
                          ,SpeedId==1  and GapId ==2                                                ,dynamic([6,'Typical Case']) // 2 weeks
                          ,SpeedId==0  and GapId ==2                                                ,dynamic([5,'Slow Case']) 
                          ,CollabId==3 and GapId ==1                                                ,dynamic([3,'Minor Collab']) 
                          ,CollabId==2 and GapId ==1                                                ,dynamic([2,'Typical Collab'])  
                          ,CollabId==1 and GapId ==1                                                ,dynamic([1,'Major Collab']) 
                          ,CollabId==0 and GapId ==1                                                ,dynamic([0,'Massive Collab']) 
                                                                                                    ,dynamic([-2,'Unknown']))  
| extend AnnotationLabel=strcat(Annotation[0],': ',Annotation[1])
        ,AnnotationId=tolong(Annotation[0])
| project-away Annotation,IsMissingCaseData,CostClass,SpeedClass,CollabClass,DeflectionClass,GapClass
| extend IsDeflection_EngagedOrWorse   = AnnotationId<=11
        ,IsDeflection_PresentedOrWorse = AnnotationId<=10
        ,IsDeflection_HelplessOrWorse  = AnnotationId<=9
        ,IsCase_QuickOrWorse           = AnnotationId<=8
        ,IsCase_FastOrWorse            = AnnotationId<=7
        ,IsCase_TypicalOrWorse         = AnnotationId<=6
        ,IsCase_SlowOrWorse            = AnnotationId<=5
        ,IsCase_NotSolvedOrWorse       = AnnotationId<=4
        ,IsCollab_MinorOrWorse         = AnnotationId<=3
        ,IsCollab_TypicalOrWorse       = AnnotationId<=2
        ,IsCollab_MajorOrWorse         = AnnotationId<=1
        ,IsCollab_Massive              = AnnotationId==0
}

.create-or-alter function with (folder = "LeftShift", docstring = "", skipvalidation = "true") GetLeftShiftData_Simple(ParamScanDays:long=84, ParamProductList:string="", ParamL2List:string="", ParamL3List:string="") {
// SAMPLE USAGE
//      GetLeftShiftData_Simple(7)|take 100
//      GetLeftShiftData_Simple(90,16450) //AKS
//      GetLeftShiftData_Simple(7) |getschema|order by ColumnName
// 
// 
// let ParamScanDays=91; let ParamProductList='14749, 12345'; let ParamL2List='32615525, 12345';
let CSFVisitSnapshotTime = toscalar(database("CSS_Secured").Get_WorkflowIdVisits() | summarize  max(startofday(SnapshotTimestamp,-1)))
;
let SupportCaseSnapshotTime = ago(7d)
;
let EndDate = min_of(CSFVisitSnapshotTime,SupportCaseSnapshotTime)
;
let StartDate=startofday(EndDate,-1*ParamScanDays)
;
database("LeftShift").GetCSFData(StartDate,EndDate)
| where isempty(ParamProductList) 
        or ParamProductList == 'AllProducts'
        or InitialProductId == ParamProductList 
        or (strcat(ParamProductList, ',') contains strcat(InitialProductId,',') and isnotempty(InitialProductId))
| where isempty(ParamL2List) 
        or ParamL2List == 'All'
        or InitialL2TopicId == ParamL2List 
        or (strcat(ParamL2List, ',') contains strcat(InitialL2TopicId,',') and isnotempty(InitialL2TopicId))
| where isempty(ParamL3List) 
        or ParamL3List == 'All'
        or InitialL3TopicId == ParamL3List 
        or (strcat(ParamL3List, ',') contains strcat(InitialL3TopicId,',') and isnotempty(InitialL3TopicId))
//| invoke database("LeftShift").Invoker_AddUsageData(ParamScanStart=StartDate)
| invoke database("LeftShift").Invoker_AddSubscriptionMetadata()
| extend L1_Id = InitialProductName, L2_Id=InitialL2TopicName, L3_Id=InitialL3TopicName
| extend txtTopicName = coalesce(L3_Id,L2_Id,L1_Id)
| project-away InitialProductName, InitialL2TopicName, InitialL3TopicName, InitialPathName
| invoke database("CSS_Secured").Invoker_AddVerbatim() 
// | invoke database("LeftShift").Invoker_AddUserMetadata()
// | invoke database("LeftShift").Invoker_AddIcMMetadata(StartDate)
// | invoke database("LeftShift").Invoker_AddCaseData(ParamScanStart=StartDate, ParamScanEnd=EndDate)
// | invoke database("LeftShift").Invoker_AddCollabTasksData()
// //| invoke database("LeftShift").Invoker_AddIcMMetadata_V2()
// | extend IsCRI          = IsCRI or IsRelatedToICM       // PENDING : Source data quality check for IcM.IsCRI, P360.IsRelatedToICM
// //| extend IsKnowledgeGap = IsCRI or IsCollabTasks_Exist
// | extend ScanStartDate=StartDate,ScanEndDate=EndDate
// // make adjustments for workflows that were deflections and add annotation labels
// | extend CurrentLeafTopicId=coalesce(CurrentLeafTopicId,iff(not(IsSRCreated),InitialLeafTopicId,tostring('')))
// | extend CurrentProductId =coalesce(CurrentProductId,iff(not(IsSRCreated),InitialProductId,tostring('')))
// | extend CurrentPathName=coalesce(CurrentPathName,iff(not(IsSRCreated),InitialPathName,tostring('')))
// | extend CurrentProductName=coalesce(CurrentProductName,iff(not(IsSRCreated),InitialProductName,tostring('')))
// | extend IsProblemClosed=coalesce(IsCaseClosed,iff(not(IsSRCreated),True,tobool('')))
// | extend GapClass = case(not(IsSRCreated)                  ,dynamic([3,"Product Gap"])
//                         ,not(IsCRI or IsCollabTasks_Exist) ,dynamic([2,"Solution Gap"]) 
//                                                            ,dynamic([1,"Knowledge Gap"]))
// // strrep is used below as a complete hack so PowerBi sorts correctly.
// | extend GapType  = strcat(strrep(' ',tolong(GapClass[0])-1) ,GapClass[1])
//         ,GapId    = tolong(GapClass[0])     
// | extend KnowledgeAskCount=CollabTasks_Count+iff(isempty(RelatedCRI_Ids),toint(IsCRI), array_length(split(RelatedCRI_Ids,',')))
// //cheap
// | extend CostClass = case(IsProblemClosed and (TotalLaborMinutes ==  0 or isempty(TotalLaborMinutes)) ,dynamic([3,'Free'])
//                          ,IsProblemClosed and TotalLaborMinutes <= 60                                 ,dynamic([2,'Cheap']) 
//                          ,IsProblemClosed and TotalLaborMinutes <=200                                 ,dynamic([1,'Typical']) 
//                          ,IsProblemClosed and TotalLaborMinutes > 200                                 ,dynamic([0,'Expensive']) 
//                                                                                                       ,dynamic([-1,'Unknown']))  
// | extend CostLabel  = strcat(CostClass[0] ,': ',CostClass[1])
//         ,CostId     = tolong(CostClass[0])
// //fast
// | extend SpeedClass = case(TotalCalendarMinutesSpent <= 240                     ,dynamic([3,'Quick Case']) //4 hrs
//                           ,TotalCalendarMinutesSpent <= 1440                    ,dynamic([2,'Fast Case'])  // 1 day
//                           ,TotalCalendarMinutesSpent <= 10080                   ,dynamic([1,'Typical Case']) // 1 weeks
//                           ,TotalCalendarMinutesSpent > 10080                   ,dynamic([0,'Slow Case']) 
//                                                                                ,dynamic([-1,'Unknown']))  
