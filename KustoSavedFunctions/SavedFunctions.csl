| extend Priority = coalesce(Priority, "1")
| order by Priority desc
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).EventStats collection

.create-or-alter function with (folder = "EventStats", docstring = "Generates a CDF Probability Table for each discrete event distribution in the input table to the function", skipvalidation = "true") GenerateDiscreteCdfTables(discreteEventDistriubtionsTable:string) {
// Description:
//      This function returns a CDF Probability Table for each discrete random variable event in the input table. Each random variable event
//      is expected to be modeled as a single row in the input table, see below for schema description of table fields for more detail.
//      NOTE: This function only returns probabilities for the values in DiscreteRandomVariableBins, this implies that the user should not
//      use the results to infer probability of a value that was not contained in DiscreteRandomVariableBins
//      
// Input Table Schema:
//      DiscreteRandomVariableBins:dynamic  - An array containing the set of increasing values that the Discrete Random Variable can have
//      OccurrencesByBin:dynamic            - An array containing the observed occurrences of the Discrete Random Variable for each bin in the 
//                                            DiscreteRandomVariableBins array (NOTE: this implies a 1 to 1 mapping between the two arrays)
//
// Example Usage:
//
//      let exampleTable = datatable(DiscreteRandomVariableBins:dynamic, OccurrencesByBin:dynamic)
//                                  [dynamic([1,2,3,4,5]),               dynamic([1,2,3,4,5]),
//                                   dynamic([1,2,3,4,5]),               dynamic([1,1,1,1,1])];
//      GenerateDiscreteCdfTables('exampleTable')
//
        table(discreteEventDistriubtionsTable)
        // Calculate Cumulative Sum of Occurrences using IIR filter
        | extend CumulativeOccurrences = series_iir(OccurrencesByBin,dynamic([1]), dynamic([1,-1])) 
        | extend EndOfArrayIndex = arraylength(OccurrencesByBin) - 1
        // Last value in the Cumulative Sum Array, is the total occurrences for the given event
        | extend TotalOccurrences = CumulativeOccurrences[EndOfArrayIndex]
        // Expand Cumulative Occurrences array and associated bin value. We hard code a max expand size to 100000
        | mvexpand CumulativeOccurrences, DiscreteRandomVariableBin=DiscreteRandomVariableBins limit 100000
        // Calculate Cumulative Probability defined as the probability that the DiscreteRandomVariable will have a value less than or equal to the DiscreteRandomVariableBin
        | extend DiscreteRandomVariableBin = tolong(DiscreteRandomVariableBin), 
                 CumulativeProbability = todouble(CumulativeOccurrences)/todouble(TotalOccurrences), 
                 TotalSampleSizeForDiscreteRandomVariable = todouble(TotalOccurrences)
}

.create-or-alter function with (folder = "EventStats", docstring = "This function evaluates cluster level statistics for a given Atlas event set.", skipvalidation = "true") Invoker_GeneratePivotEventStats(T:(Pivot:string,Time:datetime), paramStartTime:datetime, paramEndTime:datetime, paramPopulationTimeSpan:timespan) {
//
// Description:
//      This function takes a set of events and then calculates aggregated statistics by pivot for the given event set.
//
// Debugging variables:
// T is expected to be a table with Times on a minutely basis and each row is the event of concern
// let T = cluster('rdos').database("rdos").VmCounterFiveMinuteRoleInstanceCentralBondTable	
//     | where TIMESTAMP >= ago(7d)
//     | where CounterName == 'Percentage CPU' and MaxCounterValue >95
//     | project Pivot = Cluster, Time=bin(TIMESTAMP,1m)
// ;
// let paramStartTime = ago(10m);
// let paramEndTime = ago(0m);
// let paramPopulationTimeSpan = 7d
// ;
    let EventCountOccurrencesDistributions =
        T
        | where Time >= paramStartTime-paramPopulationTimeSpan and Time <= paramEndTime
        // Calculate count of Events observed for each minute by Pivot
        | summarize EventCountBin=count() by Pivot, bin(Time, 5m)
        // Count how often we see each Event value per pivot
        | summarize EventCountOccurrences=count() by EventCountBin, Pivot  
        | as NonZeroEventCountOccurrencesByPivotMinute
        // Count how often we observe zero events in a given Pivot minute
        | summarize TotalMinutesOfNonZeroEventObservations = sum(EventCountOccurrences) by Pivot
        | project EventCountBin = 0,                     
                  Pivot,                     
                  EventCountOccurrences = tolong((paramPopulationTimeSpan/5m) - TotalMinutesOfNonZeroEventObservations)
        // Union back the non zero event counts to get the full distribution
        | union (NonZeroEventCountOccurrencesByPivotMinute)
        | order by EventCountBin asc
        | summarize OccurrencesByBin=make_list(EventCountOccurrences, tolong(1+(paramPopulationTimeSpan/5m))),                       
                    DiscreteRandomVariableBins=make_list(EventCountBin, tolong(1+(paramPopulationTimeSpan/5m)))                       
                    by Pivot      
    ;
    // Evaluate the CDF probabilities for the time range specified by function params         
    T
    | where Time >= paramStartTime and Time <= paramEndTime
    | summarize EventCount=count() by Pivot, bin(Time, 5m) 
    // Join our evaluation set with CDF tables to get CDF probability of observing an event of less magnitude than the one we are evaluating
    | join kind= inner (
        GenerateDiscreteCdfTables('EventCountOccurrencesDistributions')
        | extend EventCount = DiscreteRandomVariableBin     
    ) on Pivot, EventCount 
    | project Pivot, Time, EventCount, Score=CumulativeProbability
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).Exclusivity collection

.create-or-alter function with (folder = "Exclusivity", docstring = "", skipvalidation = "true") GetTermExclusivity() {
let CSGEN=database('CSS').CSGen_GetSrResolutionText()
| project SupportRequestNumber = IncidentId, Text = Resolutiontxt
            // PENDING CSGen integration for Frequency/TFIDF score/EvalHealthy
| invoke database('CSS').Invoker_GetUrls()
| join kind=inner (database("CXP_CSF").Get_CSF_Annotated()
                   | where StartDate >= ago(56d)
                   | where isnotempty(SupportRequestNumber) 
                   | project SupportRequestNumber,WorkflowId,ProductId=LastProductId,LeafTopicId=LastSelectedTreeId) on SupportRequestNumber | project-away SupportRequestNumber1,SupportRequestNumber
| project-rename Url=URL
;
let Workflows =database("CXP_CSF").Get_CSF_Annotated()
| where StartDate >= ago(56d)
| summarize by WorkflowId,ProductId=LastProductId,LeafTopicId=LastSelectedTreeId
;
let url_regex=@"[A-Za-z]+://[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_:%&;\?\#\/.=]+"
;
let clicks = 
database("CXP_CSF").Get_CSF_Cooked()
| where UpdateItemAction == "clicked" and isnotempty(SolutionType) and WorkflowType == "Case Submission V2" //No verbatim for D&s.   Can we fix that?
    and (UpdateItemId !contains "Download" and (UpdateItemId contains "Link" or UpdateItemId contains "Video"))
    and UpdateItemValue !contains  "Microsoft_Azure_Health."
| extend UpdateItemValue= replace("%5C","/",UpdateItemValue)
| extend UpdateItemValue= replace("https:/docs",@"https://docs",UpdateItemValue)
| extend Url = extract(url_regex,0,UpdateItemValue)
| extend Url = iff (UpdateItemId contains "BladeLink",strcat("BladeLink://",extract(@"<([A-Za-z_]+\.[A-Za-z]+)>",1,UpdateItemValue)),Url)
| extend Url = iff(UpdateItemId contains "AzureKBLink",strcat("AzureKBLink://",SolutionArticleId),Url)
| extend Url = iff(SolutionType =="AlchemyInsight",strcat("Alchemy://",AlchemyBucketId,".",AlchemyRuleId),Url)
| extend Url = iff(UpdateItemId contains "ExternalLink" and SolutionType !="AlchemyInsight",strcat("ExternalLink://",SolutionArticleId),Url)
//| project Url,WorkflowId,SolutionArticleId,UpdateItemValue,UpdateItemId,SolutionArticleTitle
;
let Dataset = Workflows
| join kind=inner (clicks) on WorkflowId| project-away WorkflowId1
| project WorkflowId,Url,ProductId,LeafTopicId
| union CSGEN
| invoke database("CSS_Secured").Invoker_GetTranslatedVerbatim()
| where isnotempty(Verbatim)
| distinct *
;
let Probabilities=materialize(union(
Dataset
| project-rename Id=Url         | invoke Invoker_GetExclusivityProbabilities() | where TermCount >1 | extend Src='Url'),
(
Dataset
| project-rename Id=ProductId   | invoke Invoker_GetExclusivityProbabilities() | where TermCount >1 | extend Src='ProductId'),
(
Dataset
| project-rename Id=LeafTopicId | invoke Invoker_GetExclusivityProbabilities() | where TermCount >1 | extend Src='LeafTopicId')
)
;
let stats = Probabilities
| summarize TotalDistinctIds=dcount(Id,4), TotalDistinctTerms=dcount(Term,4),TotalTermsInDataset=any(TotalTermsInDataset) by Src
;
let n=100
;
let TermMeasures=
Probabilities
| order by ProbWordGivenId desc
| summarize Terms=make_list(Term,n),Probs=make_list(ProbWordGivenId,n) by Id,Src
| mv-expand Term=Terms to typeof(string), ProbWordGivenId=Probs to typeof(real)
| project-away Terms,Probs
| as list
| summarize SumOfAllProbabilitiesForTerm=sum(ProbWordGivenId),IdsContainingTerm=count() by Term,Src
| join kind=inner (list) on Term,Src
| project-away Term1,Src1
| extend ratio = (ProbWordGivenId/SumOfAllProbabilitiesForTerm)/IdsContainingTerm
;
let TermExclusivity=TermMeasures
| join kind=inner (Probabilities| summarize TotalTermCount=sum(TermCount) by Term,Src) on Term,Src
| project-away Term1,Src1
| summarize AverageExclusivity=avg(ratio), TotalTermCount=sum(TotalTermCount), IdsUsing = dcount(Id,4) by Term,Src
;
TermExclusivity
| join kind=inner (stats) on Src| project-away Src1
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).Fraud_UPA collection

.create-or-alter function with (folder = "Fraud_UPA", docstring = "", skipvalidation = "true") GetQuotaRequestRiskAnnotation() {
let QuotaRequestData=
database("CXP_CSF").Get_CSF_Annotated()
| where StartDate >= ago(28d)
| where IsSRCreated
| where LastProductId == "15621"
| where Workflow_TopicId == "32447243"
| project StartDate,WorkflowId,SessionId,SubscriptionId,SupportRequestNumber, StartWorkflowTimestamp
| join kind=inner(database("CSS_Secured")._SessionPuidMapping | project PUID,SessionId) on SessionId | project-away SessionId1
| join kind=inner (database("CSS_Secured").DimCSFVerbatim	) on WorkflowId | project-away WorkflowId1
| extend quota_asks = extract_all(@'(Resource Manager, [A-Z0-9]+, [A-Za-z0-9_ ]+ / [0-9]+|Classic, [A-Za-z0-9_ ]+, [A-Z0-9]+ / [0-9]+)',Description)
//| project-away Description, IssueSummary
| mv-expand quota_asks to typeof(string)
| extend quota_asks=replace_string(quota_asks,' ','')
| extend quota_asks=split(replace_string(quota_asks,'/',','),',')
| extend RP = tostring(quota_asks[0]),RequestedLimit=toint(quota_asks[3])
        ,Type=tostring(iff(quota_asks[0]=='Resource Manager',quota_asks[1],quota_asks[2]))
        ,Region=tostring(iff(quota_asks[0]=='Resource Manager',quota_asks[2],quota_asks[1]))
//| parse quota_asks with * ', ' Region:string ', ' Type:string ' / ' RequestedLimit:int 
| project-away quota_asks
| extend IsParseError = isempty(strcat(RP,RequestedLimit,Type,Region))
| where not(IsParseError)
| project StartDate, StartTime=StartWorkflowTimestamp
         ,WorkflowId,SessionId,SubscriptionId,SupportRequestNumber,PUID
         ,RP,RequestedLimit,Type,Region
         ,NewAskCoreHours = 24*RequestedLimit
         ,IsSpotAsk =Type=='Spot'
         ,IsNSeriesAsk= (Type startswith 'N')
         ,Is0Puid = PUID startswith '0'
| summarize DistinctRegions=dcount(Region,4)
           ,TotalCoreLimitRequested =sum(RequestedLimit)
           ,TotalRequestedCoreHours = sum(NewAskCoreHours)
           ,DistinctSeriesTypes  =dcount(Type,4)
           ,IsSpotAsk      = max(IsSpotAsk)
           ,IsNSeriesAsk   = max(IsNSeriesAsk)
           ,take_any(*) by SupportRequestNumber
| project-away RP,RequestedLimit,Type,Region,NewAskCoreHours,IsSpotAsk1,IsNSeriesAsk1
;
QuotaRequestData
| join kind=leftouter (database("AzureCoreCSI").ComputeSubscriptionAnnotations
                       | extend StartDate=Timestamp+1d,SubscriptionId=toguid(SubscriptionId)
                       | project-rename PreviousDayDaily_CoreHours=Daily_CoreHours
                                       ,PreviousDayWeekly_CoreHours=Weekly_CoreHours
                                       ,PreviousDayMonthly_CoreHours=Monthly_CoreHours ) on StartDate,SubscriptionId 
| project-away StartDate1,SubscriptionId1,Timestamp
| join kind=leftouter (database("AzureCoreCSI").ComputeSubscriptionAnnotations
                      | summarize (CurrentUsageTimestamp,CurrentUsageDaily_CoreHours,CurrentUsageMonthly_CoreHours,CurrentUsageWeekly_CoreHours)=arg_max(Timestamp,Daily_CoreHours,Monthly_CoreHours,Weekly_CoreHours) by SubscriptionId=toguid(SubscriptionId)) on SubscriptionId 
| project-away SubscriptionId1
| extend PreviousDayDaily_CoreHours=coalesce(PreviousDayDaily_CoreHours,0.0)
        ,PreviousDayWeekly_CoreHours=coalesce(PreviousDayWeekly_CoreHours,0.0)
        ,PreviousDayMonthly_CoreHours=coalesce(PreviousDayMonthly_CoreHours,0.0)
| extend CurrentUsageDaily_CoreHours=coalesce(CurrentUsageDaily_CoreHours,0.0)
        ,CurrentUsageWeekly_CoreHours=coalesce(CurrentUsageWeekly_CoreHours,0.0)
        ,CurrentUsageMonthly_CoreHours=coalesce(CurrentUsageMonthly_CoreHours,0.0)
| join kind=leftouter (database("CommonDims").Product360CustomerSubscriptions 
                       | project SubscriptionId=toguid(SubscriptionId),CloudCustomerGuid, DeactivationReasonName,LastDisabledDate,CurrentSubscriptionStatus,OfferType) on SubscriptionId | project-away SubscriptionId1
// is usage zero previously
// is new sub?
//look at sub feed for fraud/fraud dat, deactive reason, etc.
//used this?      "ClientApplicationId": "XplatCLI",
//add Arm info
// impossible travel
| extend LastDisabledDate=todatetime(LastDisabledDate)
}

.create-or-alter function with (folder = "Fraud_UPA", docstring = "", skipvalidation = "true") Invoker_AddPercentileRank(T:(*), ColumnName:string) {
let PythonCode = ```
import pandas as pd

col = kargs["ColumnName"]

def add_percentile_column(df):
    percentiles = df[col].rank(pct=True)
    df["percentile"] = percentiles
    return df

result = add_percentile_column(df)
```
;
T
| evaluate python(typeof(*,percentile:real),PythonCode, pack('ColumnName',ColumnName))
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).GuidedSolver collection

.create-or-alter function with (folder = "GuidedSolver", docstring = "Get data from PortalExtTelemetry table", skipvalidation = "true") GetPortalExtTelemetryData(startDate:datetime=datetime(null), endDate:datetime=datetime(null), includeAll:bool=false, duration:timespan=7d, includeNoSolutionInstanceIdDS:bool=false) {
// This function gets all data between date range from Portal Extension telemetry table. Also unpacks json and outputs as inidividual fields. 
let ScanStart = iif(isempty(startDate), startofday((now() - duration)), startDate);
let ScanEnd = iif(isempty(endDate), now(-1m), endDate); 
cluster("azsupportfollower.westus2").database("AzureSupportability").PortalExtTelemetry
        | where PreciseTimeStamp between (ScanStart .. ScanEnd) 
        | extend data=parse_json(Data)
        | extend WorkflowId = tostring(data.PartB.workflowId),
                 SolutionInstanceId = tostring(data.PartC.solutionInstanceId),
                 ExprimentName = tostring(data.PartB.ExperimentName),
                 UpdateItemId = tostring(data.PartB.updateItemId),
                 SolutionlastStepName = tostring(data.PartC.lastStepName),
                 SolutionWaitTime =tostring(data.PartC.solutionWaitTime),
                 error = tostring(data.PartC.error),
                 SolutionStatus = tostring(data.PartC.solutionStatus),
                 SapId = tostring(data.PartC.sapId),
                 SolutionSessionId=tostring(data.PartC.sessionId),
                 SolutionRequestId=tostring(data.PartC.requestId),
                 SolutionType = tostring(data.PartC.solutionType),
                 InsightArticleId = tostring(data.PartC.insightArticleId),
                 InsightArticleTitle = tostring(data.PartC.insightArticleTitle),
                 SubscriptionId = tostring(data.PartB.subscriptionId),         
                 ResourceId = tostring(data.PartB.resourceId),
                 Action = tostring(data.PartB.updateItemAction),
                 WorkflowType = tostring(data.PartB.workflowType),
                 RerunCount = tostring(data.PartC.rerunCount),
                 ProductId = tostring(data.PartB.productId),
                 StepType = tostring(data.PartB.stepType),
                 EventType = tostring(data.PartB.eventType),
                 TimeOnBladeInSeconds = tostring(data.PartB.timeOnBladeInSeconds),
                 StepCount = toint(tostring(data.PartC.stepCount)),
                 UserSessionId = SessionId,
                 SupportTopicId = tostring(data.PartB.supportTopicId),
                 Domain = tostring(data.PartB.domain), 
                 ParentTrackingId=tostring(data.dimensions.ParentTrackingId),
                 ChildTrackingId=tostring(data.dimensions.TrackingId),
                 ProblemId=tostring(data.PartC.problemId), SubProblemId=tostring(data.PartC.subProblemId), LeafsupportTopicId=tostring(data.PartC.leafsupportTopicId)
       | extend IsPAC = case (Domain == "portal.azure.com", 1, 0)
       | where includeAll or SolutionType contains "GuidedTroubleshooter" or 
            (includeNoSolutionInstanceIdDS and WorkflowType contains "TroubleshootV3" and UpdateItemId endswith "NewSupportRequestBladeLink" and ExprimentName contains "GuidedTroubleshooter" and Action contains "clicked") // This is to output contact support clicks
       | project PreciseTimeStamp, WorkflowId, SolutionInstanceId, ExprimentName, UpdateItemId, SolutionlastStepName, SolutionWaitTime, error, SolutionStatus, 
       SapId, SolutionSessionId, SolutionRequestId, SolutionType, InsightArticleId, InsightArticleTitle, SubscriptionId, ResourceId, 
       Action, WorkflowType, RerunCount, ProductId, Data, StepType, EventType, TimeOnBladeInSeconds, StepCount, UserSessionId, SupportTopicId, Domain, IsPAC, Language = AcceptLanguage, 
       Source, ParentTrackingId, ChildTrackingId, ProblemId, SubProblemId, LeafsupportTopicId
 //Uncomment this to test
 //Pulls records for last 7 days
 //GetPortalExtTelemetryData(7d);
 //Scenario 2 // It can be also called by just passing in a start and enddate, this is another way to get the latest by passsing in the most current enddate
 //GetPortalExtTelemetryData(startDate=datetime('2021-08-13'), endDate=datetime('2021-08-20'))
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).IPW_Dashboard collection

.create-or-alter function with (folder = "IPW_Dashboard", docstring = "", skipvalidation = "true") IPW_ByProduct() {
    // SAMPLE USAGE
    //      SHS_Strategy_IPW()|render timechart
    //      .drop function SHS_Strategy_IPW
    //
    let SequenceStart = toscalar(database("CXP_CSF").Get_PortExtTel_Annotated()| summarize min(StartDate))
    ;
    database("CXP_CSF").Get_PortExtTel_Annotated()
    | where IsSRCreated
    | where StartWorkflowTimestamp >= SequenceStart //and LastProductId !in (15621)
    | project WorkflowId,IsSRCreated, StartDate, ProductId=LastProductId
    // Annotated_Prod does NOT backfill 
    //|where StartDate !between (datetime(2023-8-30)..datetime(2023-9-20))
    | make-series sr=count() default=0 on StartDate from SequenceStart to startofday(now(),-1) step 1d by ProductId
    | extend IPW = series_fir(sr,repeat(1,7),false,false)
    | extend IPM = series_fir(sr,repeat(1,28),false,true)| project-away sr
    | mv-expand StartDate to typeof(datetime),IPW to typeof(long),IPM to typeof(long)
    | extend IPW_Smoothed = IPM/4 | project-away IPM
    | where StartDate >= (SequenceStart+28d)
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).KPI collection

// List of functions in Accia.Playground_Brent (Playground_BrentJ).L2 collection

.create-or-alter function with (folder = "KPI/L2", docstring = "", skipvalidation = "true") L2_X2() {
    //SAMPLE USAGE
    //      L2_X2()
    //
    let L2_Raw=
        database("CSS_Secured").GetWayFinderL2Log_Raw(ParamStartTime=datetime(8/8/2022)) 
        | where isnotempty(accia_version)
        | project Environment,WorkflowId,ProductId,IsFlight_L2, IsPredicted,accia_version
        | join kind=inner (
                database('CXP_CSF').Get_CSF_Annotated()
                | where IsPAC and IsEligible
                | project WorkflowId, IsRecoPresented, IsRecoTaken, IsSRCreated,SupportRequestNumber, LastSelectedTreeId
                | extend IsBug_DupSessions = (not(IsRecoPresented) and IsRecoTaken)
                | where not(IsBug_DupSessions)
                ) on WorkflowId | project-away WorkflowId1
        | join kind=leftouter (
                database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel 
                | where State=='Closed' 
                | project IncidentId, SupportTopicId, HasSRMetadata=True
                ) on $left.SupportRequestNumber== $right.IncidentId
        | extend IsReroute = SupportTopicId !has LastSelectedTreeId
        | as all
        | union (all|extend accia_version='All L2 versions')
        ;
    union 
        ( L2_Raw| extend Y=IsFlight_L2, X=IsRecoPresented   | extend Test='Y=IsFlight_L2, X=IsRecoPresented')
       ,( L2_Raw| extend Y=IsFlight_L2, X=IsRecoTaken       | extend Test='Y=IsFlight_L2, X=IsRecoTaken')
       ,( L2_Raw| extend Y=IsFlight_L2, X=IsSRCreated       | extend Test='Y=IsFlight_L2, X=IsSRCreated')
       ,( L2_Raw| where IsRecoPresented | extend Y=IsFlight_L2, X=IsSRCreated| extend Test='Y=IsFlight_L2, X=IsSRCreated; given IsRecoPresented')
       ,( L2_Raw| where IsRecoPresented | extend Y=IsFlight_L2, X=IsRecoTaken| extend Test='Y=IsFlight_L2, X=IsRecoTaken; given IsRecoPresented')
       ,( L2_Raw| where IsRecoTaken | extend Y=IsFlight_L2, X=IsSRCreated| extend Test='Y=IsFlight_L2, X=IsSRCreated; given IsRecoTaken')
       ,( L2_Raw| where IsSRCreated and HasSRMetadata | extend Y=IsFlight_L2, X=IsReroute| extend Test='Y=IsFlight_L2, X=IsReroute; given IsSRCreated & InP360')
       ,( L2_Raw| where IsSRCreated and HasSRMetadata and IsRecoTaken | extend Y=IsFlight_L2, X=IsReroute| extend Test='Y=IsFlight_L2, X=IsReroute; given IsSRCreated,IsRecoTaken & InP360')
    |summarize 
        XY          = countif(    X  and     Y)
       ,XNOTY       = countif(    X  and not(Y))
       ,NOTXY       = countif(not(X) and     Y)
       ,NOTXNOTY    = countif(not(X) and not(Y))
       ,Total= count()
       by Test, accia_version
    |invoke database("CSS_Secured").Invoker_GetChiSquareSigGeneric()
    | extend Y = XY+ NOTXY, NOTY=XNOTY+NOTXNOTY
    | extend 
        X_Given_Y = iif(Y>0, 1.0*XY/Y, toreal(''))
       ,X_Given_NOTY = iif(NOTY>0, 1.0*XNOTY/NOTY, toreal(''))
    | extend 
        X_Increase_L2_Minus_Control = X_Given_Y - X_Given_NOTY
    |order by Test, accia_version desc
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).LeftShift collection

// List of functions in Accia.Playground_Brent (Playground_BrentJ).CaseSubmissionFlow collection

.create-or-alter function with (folder = "LeftShift/CaseSubmissionFlow", docstring = "", skipvalidation = "true") GetCSFData(ParamScanDays:long=84) {
let suffix='Presented'
;
database("CXP_CSF").Get_CSF_Annotated(ParamScanStart=ago(ParamScanDays*1d), ParamScanEnd=now())
| where IsEligible
| extend PresentedSolutionTypes= coalesce(PresentedSolutionTypes,'["NoSolution"]')
| project PresentedSolutionTypes=parse_json(PresentedSolutionTypes)
         ,WorkflowId, SessionId,SupportRequestNumber, IsSRCreated,IsHelpPresented, IsHelpEngaged
         ,InitialLeafTopicId=LastSelectedTreeId,InitialProductId=LastProductId
         ,IsRecoTaken, IsRecoPresented, IsTetrisReroute
         ,IsQuickFixPresented
         ,IsQuickFixEngaged=coalesce(IsQuickFixEngaged,false)
         ,StartWorkflowTimestamp
         ,IsChatPresentedSolutions
         ,IsChatStartedSolutions
         ,IsConfirmedNoSupportPlan
         ,SubscriptionId
         ,TetrisInitialProductSapId
         ,TetrisInitialSupportTopicSapId
| as a 
// handle PresentedSolutionTypes
| extend full_list = toscalar (a|summarize f= make_set(PresentedSolutionTypes) )
| mv-expand full_list to typeof(string)
| extend C= PresentedSolutionTypes contains full_list
| extend full_list = strcat('Is',full_list,suffix)
| evaluate pivot(full_list,max(C),WorkflowId)
| join kind=inner (a) on WorkflowId |  project-away WorkflowId1,PresentedSolutionTypes
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).SupportCases collection

// List of functions in Accia.Playground_Brent (Playground_BrentJ).Invokers collection

.create-or-alter function with (folder = "LeftShift/SupportCases/Invokers", docstring = "", skipvalidation = "true") Invoker_AddCaseData(T:(SupportRequestNumber:string), ParamScanStart:datetime, ParamScanEnd:datetime) {
// let ParamScanEnd = toscalar(database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel	| summarize max(CreatedDateTime))
// ;
// let ParamScanStart=startofday(ParamScanEnd,-1*7)
// ;
// let T = GetCSFData(ParamScanStart,ParamScanEnd) | where isnotempty(SupportRequestNumber)|take 100
// ;
let CaseData=database("CXP_CSF").AllCloudsSupportIncidentWithReferenceModel 
| where CreatedDateTime >=ParamScanStart and CreatedDateTime < ParamScanEnd
| extend CurrentParentPathName = strcat_array((array_split(split(SapPath,@"/"),-1)[0]) , @'/')       // Get parent of leaf
| extend CurrentParentPathName = iif(CurrentParentPathName contains @'/', CurrentParentPathName, '') // Remove if parent is product
| project SupportRequestNumber=IncidentId
                              ,CurrentPathName=SapPath
                              ,CurrentParentPathName 
                              ,CurrentProductName=EligibleSupportProductName // ATTENTION: This could mismatch with ProductId. Should get from ActiveTopicTree but join is expansive
                              ,ServiceName
                              ,Causetxt
                              ,Symptomstxt
                              ,Resolutiontxt
                              ,RootCauseSupportTopic
                              ,CurrentProductId=ProductId
                              ,CurrentLeafTopicId=tostring(split(SupportTopicId,@"\")[-1])
                              ,IsProductRouteOut = EligibilityProductId!=ProductId
                              ,TotalLaborMinutes=round(toreal(TotalLabourMinutes),0)
                              ,IsCaseClosed = State == 'Closed'
                              ,TotalCalendarMinutesSpent = (coalesce(ClosedDateTime,now()) - CreatedDateTime)/1m
                              ,IsRouteOut = InitialSapId != SapId
                              ,IsCustomerNotResolved =not(IsResolved)
                              ,CSAT=1.0*TotalCsatScore/TotalSurveys
                              ,CSATSurveyVerbatim =SurveyVerbatims
                              ,IsRelatedToICM,IsRelatedToLSI,IsRelatedToOutage, RelatedICM_IDs, RelatedLSI_IDs, RelatedOutage_IDs
| extend IsTopicRouteOut = not(IsProductRouteOut) and IsRouteOut
;
T 
| join hint.shufflekey=SupportRequestNumber kind=leftouter (CaseData) on SupportRequestNumber 
| extend IsMissingCaseData= isempty(SupportRequestNumber1) 
| project-away SupportRequestNumber1
// Enhance with CollabTasks
| invoke Invoker_AddCollabTasksData(ParamScanStart, ParamScanEnd)
| extend IsCollabTasks_CrossProduct = isnotempty(CollabTasks_ProductIds) and CollabTasks_ProductCount >1
| extend IsCRI          = IsCRI or IsRelatedToICM //PENDING : Source data validation.
| extend IsKnowledgeGap = IsCRI or IsCollabTasks_Exist
| extend IsCollabTasks_CrossProduct = IsCollabTasks_Exist and (CollabTasks_ProductIds contains CurrentProductId)
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).Users collection

// List of functions in Accia.Playground_Brent (Playground_BrentJ).Invokers collection

.create-or-alter function with (folder = "LeftShift/Users/Invokers", docstring = "", skipvalidation = "true") Invoker_AddUserMetadata(T:(WorkflowId:guid)) {
T
| join hint.strategy=shuffle kind=leftouter  (database("CSS_Secured").Get_WorkflowIdVisits()
                        | project CSFVisit,ProductCSFVisit, PDSRgV,WorkflowId
                        ) on WorkflowId | project-away WorkflowId1
| extend PDSRgVThreshold_High = 0.7
| extend PDSRgVThreshold_Low = 0.4
| extend IsNewCSFUser = CSFVisit <= 2
| extend IsCaseCreator = not(IsNewCSFUser) and (PDSRgV>=PDSRgVThreshold_High)
| extend IsTroubleshooter = not(IsNewCSFUser) and (PDSRgV<=PDSRgVThreshold_Low)
| project-away PDSRgVThreshold_High ,PDSRgVThreshold_Low,PDSRgV
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).monitoring collection

.create-or-alter function with (folder = "monitoring", docstring = "", skipvalidation = "true") GetMonitoringData() {
  let AMclasses=database("CUD").ComputeUsage_Daily_V3 
| where Timestamp >= ago(28d)
| extend IsUsingMonitoring = Extensions contains '"Microsoft.EnterpriseCloud.Monitoring.MicrosoftMonitoringAgent"' or Extensions contains "Microsoft.Azure.Monitor."
| project SubscriptionId=toguid(SubscriptionId),IsUsingMonitoring
| summarize hint.shufflekey=SubscriptionId max(IsUsingMonitoring) by SubscriptionId
;
//find which subscriptions are creating cases
let cases = database("CXP_CSF").Get_CSF_Annotated(ParamScanStart=ago(28d))
| where LastProductId != 15621
| where IsSRCreated and not(IsMPAC) and isnotempty( SubscriptionId)
;
let data =cases
| join kind=inner (AMclasses) on SubscriptionId
| summarize count() by LastSelectedTreeId, max_IsUsingMonitoring,LastProductId
| evaluate pivot(max_IsUsingMonitoring,sum(count_), LastSelectedTreeId,LastProductId)
| join kind=inner (database("CXP_CSF").GetActiveTopicTree() | project LastSelectedTreeId=LeafTopicId, PathName,LastProductId=ProductId) on LastSelectedTreeId,LastProductId
| project-rename IsUsingMonitoring = ['True'], IsNotUsingMonitoring = ['False']
| extend PercentofTotal = 1.0*IsUsingMonitoring/(IsUsingMonitoring+IsNotUsingMonitoring), key=1
;
let totals = data | summarize IsNotUsingMonitoringTotal=sum(IsNotUsingMonitoring),IsUsingMonitoringTotal=sum(IsUsingMonitoring) by key
;
totals
| join kind=inner (data) on key
| extend XY=IsUsingMonitoring
        ,XNOTY=IsUsingMonitoringTotal-IsUsingMonitoring
        ,NOTXY=IsNotUsingMonitoring
        ,NOTXNOTY = IsNotUsingMonitoringTotal-IsNotUsingMonitoring
}

.create-or-alter function with (folder = "monitoring", docstring = "", skipvalidation = "true") pps_aks() {
let data = cluster('Azcrp').database("crp_allprod").VMApiQosEvent
| where PreciseTimeStamp >= ago(7d)
| where resultType==0 and allocationAction in ("TenantCreated", "VMAddedToTenant") and preprovisionedVMReuse != "PreprovisionedVMCreation" and isnotempty(preprovisionedVMReuse)
| extend isMariner = ((platformImage has "microsoftcblmariner") or 
       (galleryImage startswith "/subscriptions/109a5e88-712a-48ae-9078-9ca8b3c81345/resourceGroups/AKS-CBLMariner/providers/Microsoft.Compute/galleries/AKSCBLMariner"))
| extend isAKS= (galleryImage has "microsoft-aks" and galleryImage has "aks" and galleryImage has "aks-ubuntu" and galleryImage !has "engine") 
             or (galleryImage contains "resourcegroups/aks-" and galleryImage contains "109a5e88-712a-48ae-9078-9ca8b3c81345" and galleryImage !has "versions/9999.99.99")
             or (galleryImage has "aks-" or galleryImage has "-aks" or 
                 platformImage has "microsoftcblmariner" or platformImage has "microsoft-aks")
| extend durationInSecs = toint(durationInMilliseconds / 1000.0) /// 60
| where isAKS  and preprovisionedVMReuse in ('ReusingPreprovisionedVM','PreprovisionedVMNotFound','VMModelDisqualified')
| parse galleryImage with * '/resourceGroups/' Image '?' *
| extend ImageType = tostring(split(Image,'/')[0])
| extend IsBetterthan90 = durationInSecs<90
;
data
| summarize c=count() by correlationId
| where c==1
| join hint.shufflekey=correlationId kind=inner (data) on correlationId| project-away correlationId1
| extend ImageType = tostring(split(Image,'/')[0])
| extend log2duration=round(log2(durationInSecs),1)
| extend prop= parse_json(extraVMProperties)
| project-away extraVMProperties
| project MonitoringApplication, durationInSecs, log2duration, Image, ImageType, vMSize, oSType, oSDiskStorageAccountType
         ,IsErrorDetailsEmpty= isempty(errorDetails), IsExceptionEmpty= isempty(exceptionType)
         ,OSDiskSizeInGB = prop.OSDiskSizeInGB, HasDiffOSDisk= prop.HasDiffOSDisk, DataDisks = prop.DataDisks
         ,HyperVGenerationType = prop.HyperVGenerationType,IsBetterthan90,preprovisionedVMReuse
| where rand() < (1.0/3)
}

// List of functions in Accia.Playground_Brent (Playground_BrentJ).NLP collection

// List of functions in Accia.Playground_Brent (Playground_BrentJ).Invokers collection

.create-or-alter function with (folder = "NLP/Invokers", docstring = "sklearn Countvectorizer", skipvalidation = "true") Invoker_GetCooccurrences(T:(Id:string,Verbatim:string), Param_min_df:real=0.0, Param_max_df:real=1.0, Param_min_ngram:long=1, Param_max_ngram:long=1, Param_Use_Stemmer:bool=true) {
// EXAMPLE:
// let Carroll = datatable(Verbatim:string)
// [
// '"Would you tell me, please, which way I ought to go from here?"',
// '"That depends a good deal on where you want to get to," said the Cat.',
// '"I don\'t much care where—" said Alice.',
// '"Then it doesn\'t matter which way you go," said the Cat.',
// '"—so long as I get SOMEWHERE," Alice added as an explanation.',
// '"Oh, you\'re sure to do that," said the Cat, "if you only walk long enough."'
// ]
// ;
// Carroll | extend Id = "Chapter 6"
// | extend Verbatim = Scalar_CleanVerbatim(Verbatim)
// | invoke Invoker_GetCooccurrences()     
//
let Total= toscalar(T | count)
;
let PythonParameters = pack('min_df',Param_min_df
                           ,'max_df',Param_max_df
                           ,'min_ngram',Param_min_ngram
                           ,'max_ngram',Param_max_ngram
                           ,'use_stemmer',Param_Use_Stemmer
                           )
;
let PythonCode = 
'from sklearn.feature_extraction.text import CountVectorizer\n'
'from nltk.stem.snowball import SnowballStemmer\n'
'import pandas\n'
'passed_min_df  = kargs["min_df"]\n'
'passed_max_df  = kargs["max_df"]\n'
'passed_min_N   = kargs["min_ngram"]\n'
'passed_max_N   = kargs["max_ngram"]\n'
'use_stemmer   = kargs["use_stemmer"]\n'
'def text_tokenizer(str_input):\n'
'    return str_input.split()\n'
'\n'
'# Use NLTKs Stemmer\n'
'def stemming_tokenizer(str_input):\n'
'    words = text_tokenizer(str_input)\n'
'    words = [stemmer.stem(word) for word in words]\n'
'    return words\n'
'\n'
'def Countvectorizer(row):\n'
'  data = []\n'
'  data_cleaned=df.loc[df["Id"]==row["Id"]]["Verbatim"].tolist()\n'
'                \n'
'  try:\n'
'    data_vectorized = MyCountVectorizer.fit_transform(data_cleaned)\n'
'    terms = MyCountVectorizer.get_feature_names()\n'
'    #change counts to one-hot encoding\n'
'    data_vectorized[data_vectorized>0]=1\n'
'    #produce co-occurance matrix\n'
'    Cooccurance=(data_vectorized.T*data_vectorized)\n'
'    Cooccurance.setdiag(0)\n'
'    rows,cols = Cooccurance.nonzero()\n'
'    for row,col in zip(rows,cols):\n'
'            data.append ( (str(terms[row]),str(terms[col]),Cooccurance[row,col],data_vectorized.getcol(row).count_nonzero(),data_vectorized.getcol(col).count_nonzero()))\n'
'  except Exception as e:\n'
'    data = "EXCEPTION : " + str(e)\n'
'  return(pandas.io.json.dumps(data))\n'
'                \n'
'stemmer = SnowballStemmer("english")\n'
'if use_stemmer:\n'
'    my_tokenizer = stemming_tokenizer\n'
'else:\n'
'    my_tokenizer = text_tokenizer\n'
'result = pd.DataFrame(columns=["Id"])\n'
'result["Id"] = df["Id"].unique()\n'
'MyCountVectorizer = CountVectorizer(\n'
'                                    analyzer="word",				  \n'
'                                    ngram_range=(passed_min_N,passed_max_N),				  \n'
'                                    min_df=passed_min_df,             # minimum reqd occurences of a word \n'
'                                    max_df=passed_max_df,             # minimum reqd occurences of a word \n'
'                                    # stop_words="english",           # remove stop words   \n'
'                                    lowercase=True,                   # convert all words to lowercase\n'
'                                    tokenizer=my_tokenizer,\n'
'                                    )\n'
'                \n'
'result["ResultVector"]= result.apply(Countvectorizer,axis=1)\n'
;
T
| evaluate python(typeof(Id:string,ResultVector:string),PythonCode,PythonParameters)
| project ResultVector_dynamic = todynamic(ResultVector)
| mv-expand ResultVector_dynamic 
| extend TermA =tostring(ResultVector_dynamic[0]),TermB =tostring(ResultVector_dynamic[1]), CoocurranceCount=toreal(ResultVector_dynamic[2]),TermACount=toreal(ResultVector_dynamic[3]),TermBCount=toreal(ResultVector_dynamic[4])
| project-away ResultVector_dynamic
| extend ProbabilityOfTermAGivenTermB = 1.0*CoocurranceCount/TermBCount
| extend ProbabilityOfTermBGivenTermA = 1.0*CoocurranceCount/TermACount
| extend Lift = 1.0*CoocurranceCount/((TermACount)*(TermBCount))
| extend Support = 1.0*CoocurranceCount/Total
}

.create-or-alter function with (folder = "NLP/Invokers", docstring = "sklearn Countvectorizer", skipvalidation = "true") Invoker_GetCountVectors(T:(Id:string,Verbatim:string), Param_min_df:real=0.0, Param_max_df:real=1.0, Param_min_ngram:long=1, Param_max_ngram:long=1, Param_Use_Stemmer:bool=true) {
// EXAMPLE:
// let Carroll = datatable(Verbatim:string)
// [
// '"Would you tell me, please, which way I ought to go from here?"',
// '"That depends a good deal on where you want to get to," said the Cat.',
// '"I don\'t much care where—" said Alice.',
// '"Then it doesn\'t matter which way you go," said the Cat.',
// '"—so long as I get SOMEWHERE," Alice added as an explanation.',
// '"Oh, you\'re sure to do that," said the Cat, "if you only walk long enough."'
// ]
// ;
// Carroll | extend Id = "Chapter 6"
// | extend Verbatim = Scalar_CleanVerbatim(Verbatim)
// | invoke Invoker_GetCountVectors()     
//
let PythonParameters = pack('min_df',Param_min_df
                           ,'max_df',Param_max_df
                           ,'min_ngram',Param_min_ngram
                           ,'max_ngram',Param_max_ngram
                           ,'use_stemmer',Param_Use_Stemmer
                           )
;
let PythonCode = 
'from sklearn.feature_extraction.text import CountVectorizer\n'
'from nltk.stem.snowball import SnowballStemmer\n'
'import pandas\n'
'passed_min_df  = kargs["min_df"]\n'
'passed_max_df  = kargs["max_df"]\n'
'passed_min_N   = kargs["min_ngram"]\n'
'passed_max_N   = kargs["max_ngram"]\n'
'use_stemmer   = kargs["use_stemmer"]\n'
'def text_tokenizer(str_input):\n'
'    return str_input.split()\n'
'\n'
'# Use NLTKs Stemmer\n'
'def stemming_tokenizer(str_input):\n'
'    words = text_tokenizer(str_input)\n'
'    words = [stemmer.stem(word) for word in words]\n'
'    return words\n'
'\n'
'def Countvectorizer(row):\n'
'  data = []\n'
'  data_cleaned=df.loc[df["Id"]==row["Id"]]["Verbatim"].tolist()\n'
'                \n'
'  try:\n'
'    data_vectorized = MyCountVectorizer.fit_transform(data_cleaned)\n'
'    terms = MyCountVectorizer.get_feature_names()\n'
'    sums = data_vectorized.sum(axis=0)\n'
'                \n'
'    for col,term in enumerate(terms):\n'
'      data.append ( (str(term),sums[0,col]))\n'
'  except Exception as e:\n'
'    data = "EXCEPTION : " + str(e)\n'
'  return(pandas.io.json.dumps(data))\n'
'                \n'
'stemmer = SnowballStemmer("english")\n'
'if use_stemmer:\n'
'    my_tokenizer = stemming_tokenizer\n'
'else:\n'
'    my_tokenizer = text_tokenizer\n'
'result = pd.DataFrame(columns=["Id"])\n'
'result["Id"] = df["Id"].unique()\n'
'MyCountVectorizer = CountVectorizer(\n'
'                                    analyzer="word",				  \n'
'                                    ngram_range=(passed_min_N,passed_max_N),				  \n'
'                                    min_df=passed_min_df,             # minimum reqd occurences of a word \n'
'                                    max_df=passed_max_df,             # minimum reqd occurences of a word \n'
'                                    # stop_words="english",           # remove stop words   \n'
'                                    lowercase=True,                   # convert all words to lowercase\n'
'                                    tokenizer=my_tokenizer,\n'
'                                    )\n'
'                \n'
'result["ResultVector"]= result.apply(Countvectorizer,axis=1)\n'
;
T
| evaluate python(typeof(Id:string,ResultVector:string),PythonCode,PythonParameters)
}

.create-or-alter function with (folder = "NLP/Invokers", docstring = "", skipvalidation = "true") Invoker_GetEntropy(T:(Id:string,Verbatim:string), Param_min_df:real=0.0, Param_max_df:real=1.0, Param_min_ngram:long=1, Param_max_ngram:long=1, Param_Use_Stemmer:bool=true) {
let Probabilities=materialize (
T
| invoke Invoker_GetExclusivityProbabilities(Param_min_df, Param_max_df, Param_min_ngram, Param_max_ngram, Param_Use_Stemmer)
)
;
Probabilities
| summarize by Id,TotalRecordsInDataset,TotalRecordsInId,key=1
| join kind=inner (Probabilities| summarize by Term,key=1) on key | project-away key,key1
| join kind=leftouter  (Probabilities | project Id,Term,RecordsInIdWithTerm) on Id,Term| project-away Id1,Term1
| extend RecordsInIdWithTerm=coalesce(RecordsInIdWithTerm,0)
| extend PTerm = 1.0*RecordsInIdWithTerm/TotalRecordsInDataset
        ,PNoTerm = 1.0*(TotalRecordsInId-RecordsInIdWithTerm)/TotalRecordsInDataset
| extend Entropy = iff(PTerm in (0.0,1.0), 0.0,-1*((PTerm)*log2(PTerm))) + 
                   iff(PNoTerm in (0.0,1.0), 0.0,-1*((PNoTerm)*log2(PNoTerm)))
| summarize Entropy=sum(Entropy),RecordsInWithTerm=sum(RecordsInIdWithTerm),TotalRecordsInDataset=any(TotalRecordsInDataset)  by Term
| project Term, Entropy, ProbabilityOfTermInRecord=1.0*RecordsInWithTerm/TotalRecordsInDataset
}

.create-or-alter function with (folder = "NLP/Invokers", docstring = "", skipvalidation = "true") Invoker_GetEntropyVectors(T:(Id:string,Verbatim:string), Param_min_df:real=0.0, Param_max_df:real=1.0, Param_min_ngram:long=1, Param_max_ngram:long=1, Param_Use_Stemmer:bool=true) {
let Probabilities=materialize (
T
| invoke Invoker_GetExclusivityProbabilities(Param_min_df, Param_max_df, Param_min_ngram, Param_max_ngram, Param_Use_Stemmer)
)
;
let n=10000
;
let TermMeasures=Probabilities
| order by ProbWordGivenId desc
| summarize Terms=make_list(Term,n),Probs=make_list(ProbWordGivenId,n) by Id
| mv-expand Term=Terms to typeof(string), ProbWordGivenId=Probs to typeof(real)
| project-away Terms,Probs
| as list
| summarize SumOfAllProbabilitiesForTerm=sum(ProbWordGivenId),IdsContainingTermInTopN=dcount(Id,4) by Term
| join kind=inner (list) on Term
| project-away Term1
| extend Exclusivity = (ProbWordGivenId/SumOfAllProbabilitiesForTerm)/IdsContainingTermInTopN
;
let Entropy = Probabilities
| extend Entropy= -1*ProbWordGivenId*log2(ProbWordGivenId) 
;
Entropy
| summarize TotalEntropy = sum(Entropy) by Term
| join kind=inner (Entropy) on Term| project-away Term1
| extend PercentOfTotalEntropy = iff(TotalEntropy>0,Entropy/TotalEntropy,0.0)
| join kind=inner (TermMeasures) on Term,Id| project-away Term1,Id1
| project-reorder Id,Term,Entropy,TotalEntropy,PercentOfTotalEntropy,Exclusivity
}

