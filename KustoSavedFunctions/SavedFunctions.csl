        IsIdentitySolutionPresented  = iif(IsHelpPresented,IsIdentitySolutionPresented , tobool('')),
        IsVideoPresented  = iif(IsHelpPresented, IsVideoPresented, tobool('')),
        IsWebAppsTroubleshooterPresented  = iif(IsHelpPresented, IsWebAppsTroubleshooterPresented, tobool('')),
        IsQuickFixPresented  = iif(IsHelpPresented, IsQuickFixPresented, tobool('')),
        //
        IsHelpClicked = iif(IsHelpPresented, IsHelpClicked, tobool('')),
        IsHelpDwelled = iif(IsHelpPresented, IsHelpDwelled, tobool('')),
        IsHelpEngaged = iif(IsHelpPresented, IsHelpEngaged, tobool('')),
        IsQuickFixEngaged = iif(IsQuickFixPresented,IsQuickFixEngaged , tobool('')),//
