// List of functions in Accia.LeftShift.Vuln collection

.create-or-alter function with (folder = "S360/Vuln", docstring = "", skipvalidation = "true") Vuln_Orphaned(RemediationOwner:dynamic, SLA:dynamic, Cloud:dynamic) {   
let _Cluster_Prod = 'shavulnmgmtprdwus.kusto.windows.net';
let _Filter_Actions = dynamic(['MigrateToSupportedRegistry']);
let _Filter_AssetType = dynamic(null);
let _Filter_Cloud = Cloud;
let _Filter_Division = dynamic(null);
let _Filter_Organization = dynamic(null);
let _Filter_RemediationOwner = RemediationOwner;
let _Filter_Service = dynamic(null);
let _Filter_ServiceGroup = dynamic(null);
let _Filter_SubscriptionId = '';
let _Filter_TeamGroup = dynamic(null);
let _Filter_VulnerabilityId = dynamic(null);
let _Filter_CustomGroupingLink = dynamic(null);
let _Filter_Digest = '';
let _Filter_EndDt = datetime(2026-03-20T14:14:51Z);
let _Filter_Environment = dynamic(null);
let _Filter_ExcludeAction = dynamic(['None']);
let _Filter_Image = '';
let _Filter_Registry = '';
let _Filter_ResourceGroup = '';
let _Filter_RootURL = dynamic(null);
let _Filter_SLA = SLA;
let _Filter_ScanToolNames = dynamic(['MissingScanContainerImage']);
let _Filter_StartDt = datetime(2026-03-20T08:21:30Z);
// baseQuery _BaseQuery_ServiceTreeData
let _BaseQuery_ServiceTreeData = () {
    cluster(_Cluster_Prod).database('ShaData').ServiceTreeData
    | distinct
        Division = tostring(ServiceTreeAttributes.DivisionName),
        Organization = tostring(ServiceTreeAttributes.OrganizationName),
        ServiceGroup = tostring(ServiceTreeAttributes.ServiceGroupName),
        Service = ServiceName,
        ServiceTreeId = Id,
        TeamGroup = tostring(ServiceTreeAttributes.TeamGroupName)
};
// baseQuery _BaseQuery_ServiceTreeScope
let _BaseQuery_ServiceTreeScope = () {
    _BaseQuery_ServiceTreeData
    | where
        isnotempty(_Filter_Division) or
        isnotempty(_Filter_Organization) or
        isnotempty(_Filter_ServiceGroup) or
        isnotempty(_Filter_TeamGroup) or
        isnotempty(_Filter_Service) or
        isnotempty(_Filter_RemediationOwner) or
        isnotempty(_Filter_Cloud) or 
        isnotempty(_Filter_AssetType)
    | where isempty(_Filter_Division) or Division in (_Filter_Division)
    | where isempty(_Filter_Organization) or Organization  in (_Filter_Organization)
    | where isempty(_Filter_ServiceGroup) or ServiceGroup  in (_Filter_ServiceGroup)
    | where isempty(_Filter_TeamGroup) or TeamGroup in (_Filter_TeamGroup)
    | where isempty(_Filter_Service) or Service in (_Filter_Service)
    | where isempty(_Filter_RemediationOwner) or ServiceTreeId in (_Filter_RemediationOwner)
    | summarize make_set(ServiceTreeId)
    | extend set_ServiceTreeId = case(
        isempty(_Filter_Division) and
        isempty(_Filter_Organization) and
        isempty(_Filter_ServiceGroup) and
        isempty(_Filter_TeamGroup) and
        isempty(_Filter_Service) and
        isempty(_Filter_RemediationOwner) and 
        (
            isnotempty(_Filter_Cloud) or
            isnotempty(_Filter_SubscriptionId) or
            isnotempty(_Filter_Actions) or
            isnotempty(_Filter_VulnerabilityId)
        ), dynamic(null), set_ServiceTreeId )
};
// baseQuery _BaseTune_ContainerHost
let _BaseTune_ContainerHost = () {
    cluster('shas360prdwus').database('ShaS360').GetUnifiedS360ActionDetails_AllRuns
    (
        _Filter_AssetType = iff(isnotempty(_Filter_AssetType),set_intersect(dynamic(['Container Host']),_Filter_AssetType),dynamic(['Container Host'])),
        _Filter_ExcludeActions=_Filter_ExcludeAction,
        _Filter_Actions=_Filter_Actions,
        _Filter_VulnerabilityId=_Filter_VulnerabilityId,
        _Filter_SubscriptionId=_Filter_SubscriptionId,
        _Filter_RemediationOwner=toscalar(_BaseQuery_ServiceTreeScope),
        _Filter_Cloud=_Filter_Cloud,
        _Filter_Environment=_Filter_Environment,
        _Filter_GroupingRecordId=_Filter_CustomGroupingLink,
        _Filter_SLA=_Filter_SLA,
        _Filter_ResourceGroup=_Filter_ResourceGroup,
        _Filter_ScanToolNames=_Filter_ScanToolNames,
        _Filter_Registry=_Filter_Registry,
        _Filter_Image=_Filter_Image,
        //_Filter_Digest=_Filter_Digest,
        _Filter_RootURL=_Filter_RootURL,
        startCursor=_Filter_StartDt,
        endCursor = _Filter_EndDt,
        partitionCount=100,
        partitionIndex=0
    )
    | extend 
        Digest=tostring(ScanAttributes.ImageId),
        Registry=tostring(ScanAttributes.RegistryName)
    | where Registry in (_Filter_Registry) or isempty(_Filter_Registry)
    | where Digest in (_Filter_Digest) or isempty(_Filter_Digest)
    | summarize VMCount = dcount(AssetId)*100
};
let tune = _BaseTune_ContainerHost
;
 cluster('shas360prdwus').database('ShaS360').GetUnifiedS360ActionDetails
(
    _Filter_AssetType = iff(isnotempty(_Filter_AssetType),set_intersect(dynamic(['Container Host']),_Filter_AssetType),dynamic(['Container Host'])),
    _Filter_ExcludeActions=_Filter_ExcludeAction,
    _Filter_Actions=_Filter_Actions,
    _Filter_VulnerabilityId=_Filter_VulnerabilityId,
    _Filter_SubscriptionId=_Filter_SubscriptionId,
    _Filter_RemediationOwner=toscalar(_BaseQuery_ServiceTreeScope),
    _Filter_Cloud=_Filter_Cloud,
    _Filter_Environment=_Filter_Environment,
    _Filter_GroupingRecordId=_Filter_CustomGroupingLink,
    _Filter_SLA=_Filter_SLA,
    _Filter_ResourceGroup=_Filter_ResourceGroup,
    _Filter_ScanToolNames=_Filter_ScanToolNames,
    _Filter_Registry=_Filter_Registry,
    _Filter_Image=_Filter_Image,
    //_Filter_Digest=_Filter_Digest,
    _Filter_RootURL=_Filter_RootURL,
    startCursor=_Filter_StartDt,
    endCursor = _Filter_EndDt,
    _Tune_ExpectedRowCt=toscalar(tune),
    _Tune_RequestedRowCt=1000
)
| extend 
    Digest=tostring(ScanAttributes.ImageId),
    Registry=tostring(ScanAttributes.RegistryName),
    ImageFullName=tostring(ScanAttributes.ImageName),
    ImageTags=coalesce(tostring(ScanAttributes.ImageTags), tostring(ScanAttributes.ImageTag)),
    ScanCompleteTime=todatetime(ScanAttributes.ScanCompleteTime),
    ManifestListDigest=tostring(split(ScanAttributes.NodeDetails.ParentManifestListFQUri, "@")[1])
| where Registry in (_Filter_Registry) or isempty(_Filter_Registry)
| where Digest in (_Filter_Digest) or isempty(_Filter_Digest)
| extend 
    SubscriptionName=tostring(InventoryAttributes.SubscriptionName),
    ResourceGroup=tostring(InventoryAttributes.ResourceGrp),
    VMScaleSetName=tostring(InventoryAttributes.VMScaleSetName),
    VMScaleSetId=tostring(InventoryAttributes.VMScaleSetId),
    InstanceName=tostring(InventoryAttributes.RoleInstanceName),
    LastSeen=todatetime(ScanAttributes.LastImageListTime),
    LastUsed=todatetime(ScanAttributes.NodeDetails.LastUsed),
    IsHOBO=iff(tobool(InventoryAttributes.1pHoboFlag)==1,true,false),
    ScopedHoboAsset = isnotempty(InventoryAttributes.ProviderAttributes) and tobool(InventoryAttributes.1pHoboFlag) == 1,
    HOBODataProvider=iff(tobool(InventoryAttributes.1pHoboFlag)==1,tostring(InventoryAttributes.HOBODataProvider),"N/A"),
    AKSCluster = tostring(InventoryAttributes.AKS.resourceId),
    K8Details = ScanAttributes.NodeDetails.K8Details,
    PodLabel = tostring(ScanAttributes.NodeDetails.ManagedBy),
    RepoName = tostring(split(ImageFullName,'@')[0]),
    IsAKS = isnotempty(InventoryAttributes.AKS),
    VulnSolution= cluster('shas360prdwus').database('ShaS360').FormatQualysKBHtml(tostring(VulnerabilityAttributes.SOLUTION)),
    K8SService = extract(@"^(.*?)(?:-[a-z0-9]+){1,2}$", 1, tostring(ScanAttributes.NodeDetails.ManagedByDetails.PodName))
| mv-apply K8Details to typeof(dynamic) on 
    (
        summarize K8Namespaces = make_set(K8Details.Namespace)
    )
| extend BeneficiaryResourceAttributes = iff(ScopedHoboAsset, InventoryAttributes.BeneficiaryResourceAttributes, todynamic("N/A"))
| extend ActionWikiLink = strcat('https://aka.ms/VulnerabilityAction-',Action)
// BEGIN : Temporary join to enrich ACA resources - 9/11/24.
| extend ClusterName=tostring(split(AKSCluster,'/')[8])
| join kind = leftouter(
    (union isfuzzy=true
        (datatable(ArmId:string,EnvironmentName:string,_Region:string,PreciseTimeStamp:datetime,Image:string)[]),
        (cluster('cappsanalytics.westus.kusto.windows.net').database('ACAData').ACAImageDetails)
    )
    | where isnotempty(ArmId)
    | where PreciseTimeStamp >= ago(3d)
    ) on $left.ClusterName==$right.EnvironmentName
| extend ACA_SubscriptionId = extract("subscriptions/([^/]*)",1,ArmId)
| extend ACA_ResourceGroup = extract("resourceGroups/([^/]*)",1,ArmId)
| extend ACA_EnvironmentName = extract("containerapps/([^/]*)",1,ArmId)
| lookup (
    cluster(_Cluster_Prod).database('ShaData').ServiceTreeSubscriptionMapping
    | project BeneficiarySubscriptionId = SubscriptionId, BeneficiarySubscriptionName = SubscriptionName, BeneficiaryServiceTreeName = ServiceName
    ) on $left.ACA_SubscriptionId == $right.BeneficiarySubscriptionId
//----
| extend BeneficiaryData = iff(
    isnotempty(BeneficiaryServiceTreeName),
    bag_pack(
        "ProviderServiceTreeName", ServiceTreeName,
        "BeneficiaryServiceTreeName", BeneficiaryServiceTreeName,
        "BeneficiarySubscriptionName", BeneficiarySubscriptionName,
        "BeneficiarySubscriptionId", ACA_SubscriptionId, 
        "BeneficiaryResourceGroup", ACA_ResourceGroup,
        "BeneficiaryEnvironmentName", EnvironmentName),
    dynamic(null))
| extend ServiceTreeName = iff(isempty(BeneficiaryData), ServiceTreeName, "[See BeneficiaryData]")
// END : Temporary join to enrich ACA resources - 9/11/24
| extend AKSAttributes = bag_pack(
    "autoUpgradeProfile", InventoryAttributes.AKS.autoUpgradeProfile,
    "kubernetesVersion", InventoryAttributes.AKS.kubernetesVersion,
    "isCurrentKubeVersionSupported", InventoryAttributes.AKS.isCurrentKubeVersionSupported,
    "supportedKubernetesVersions", InventoryAttributes.AKS.supportedKubernetesVersions,
    "location", InventoryAttributes.AKS.location,
    "releasedVhd", InventoryAttributes.AKS.releasedVhd
)
| project
    Action,
    ServiceTreeName,
    BeneficiaryData, // Temporary join to enrich ACA resources - 9/11/24
    RepoName,
    Digest,
    ManifestListDigest,
    VulnId = VulnerabilityId,
    VulnerabilityName,
    ScanResult,
    VulnSolution,
    Cloud,
    SubscriptionName,
    SubscriptionId,
    ResourceGroup,
    VMScaleSetName,
    VMScaleSetId,
    IsAKS,
    AKSAttributes,
    AKSCluster,
    K8Namespaces,
    K8SService,
    InstanceName,
    IsHOBO,
    HOBODataProvider,
    BeneficiaryResourceAttributes,
    DueDate,
    LastSeen,
    LastUsed,
    Registry,
    ImageTags,
    ImageFullName,
    PodLabel,
    AssetId,
    ActionWikiLink
}

.create-or-alter function with (folder = "S360", docstring = "", skipvalidation = "true") Get_MHF_Audit_V1_ACRPurge(ParamEnv:string="AME_STAGE,AME_PROD") {
    // SAMPLE USAGE
    //      Get_MHF_Audit_V1_ACRPurge()
    //      Get_MHF_Audit_V1_ACRPurge()|summarize count() by Environment, IsDeployed, IsUnsecured
    //
    _MHF_Audit_V1_ACRPurge
    |where isempty( ParamEnv) or Environment  in (split(ParamEnv,','))
    | extend IngestTime=ingestion_time()
    |as a
    | lookup kind=inner(a| summarize IngestTime= max(IngestTime) by Environment) on Environment,IngestTime
    | extend IsUnsecured = iif(Environment =='CORP', bool(null), IsUnsecured)
}

.create-or-alter function with (folder = "S360", docstring = "", skipvalidation = "true") Get_MHF_Audit_V1_ReplicaSetPurge() {
    // SAMPLE USAGE
    //      Get_MHF_ACR_PurgeAudit()
    //      Get_MHF_ACR_PurgeAudit()|summarize count() by Environment, IsDeployed, IsUnsecured, IngestTime
    //
    _MHF_Audit_V1_ReplicaSetPurge
    | extend IngestTime=ingestion_time()
    |as a
    | lookup kind=inner(a| summarize IngestTime= max(IngestTime) by Environment) on Environment,IngestTime
    | extend IsUnsecured = iif(Environment =='CORP', bool(null), IsUnsecured)
}

.create-or-alter function with (folder = "S360", docstring = "", skipvalidation = "true") Get_MHF_ShaVuln(ParamRegistry:string="", ParamAsOf:timespan=timespan(null)) {
    // SAMPLE USAGE
    //      Get_MHF_ShaVuln()
    //      Get_MHF_ShaVuln(ParamRegistry='')
    //      Get_MHF_ShaVuln(ParamRegistry='', ParamAsOf=7d)
    //      _FLOW_ETL_VulnImageSet_Snapshots|summarize count() by IngestTimestamp
    //
    // SOURCE - FLOW 
    //      https://make.powerautomate.com/environments/8d2fcb8c-c33e-ed3e-8d2f-a32c9de1fd02/flows/23984ddb-1fa1-4f27-b2ae-47fb260c6a06/details
    //
    //let ParamRegistry = '';let ParamScanRange = 30d;
    cluster('accia').database('LeftShift')._FLOW_ETL_VulnImageSet_Snapshots
    |where isempty( ParamAsOf) or IngestTimestamp >=ago(ParamAsOf)
    |as v |where IngestTimestamp  == toscalar (v|summarize max(IngestTimestamp))
    | where isempty(ParamRegistry)or ParamRegistry has Registry
    | summarize arg_max(IngestTimestamp,*)by ServiceTreeName,Registry, ContainerName, ImageTag,Digest
}

.create-or-alter function with (folder = "S360", docstring = "fixup bad s360 data", skipvalidation = "true") Invoker_FixSFIData(T:(Title:string,CustomDims:dynamic,AssignedTo:string,ExceptionRequestType:string,ExceptionDecision:string,Service:string,Tags:string,CurrentDueDate:datetime,CurrentETA:datetime,ID:string,TeamGroupName:string)) {
T
| extend IsAlbus =  Title contains 'albus' or  Title contains 'external//triangle' or AssignedTo =='devshah' or AssignedTo =='viramam' or AssignedTo =='jierendeng' 
                    or CustomDims contains 'albus' or CustomDims contains 'triangle' or Title contains 'SingleAgent'
| extend IsAegis =  Title contains 'Aegis'  or AssignedTo =='xiaoya'
| extend IsEuler = (Service contains 'Azure VM' and Tags contains 'ACE')
| extend IsEureka = Title contains 'external/Eureka' or CustomDims contains 'Eureka'
| extend IsMHF = Title contains 'MHI_Apps' and Title !contains 'external'
| extend IsACCIA = * contains 'Sauron' or Title contains 'accia'
| extend IsACPIA = AssignedTo=='trtran' or Title contains 'PPSPrediction'
| extend IsAZCORE = AssignedTo =='meriver' or AssignedTo =='nicksw' or AssignedTo =='hrkulkar'
| extend Actual = case(IsAlbus , '{"AssignedTo": "zeli","Service":"Albus_GF_ AIOps Service"}'
                      ,IsEuler, '{"AssignedTo": "ropandey","Service":"TeamEuler"}'
                      ,IsAegis , '{"AssignedTo": "kehsieh","Service":"Insights Control Plane [Aegis]"}'
                      ,IsACCIA , '{"AssignedTo": "brentj","Service":"Azure Core Customer Insights and Analytics"}'
                      ,IsAZCORE , '{"AssignedTo": "gowrin","Service":"AzCore Data"}'
                      ,IsMHF , '{"AssignedTo": "brentj","Service":"ACCIA Model Hosting Framework"}'
                      ,IsACPIA, '{"AssignedTo": "brentj","Service":"Azure Core Platform and Decision Infrastructure"}'
                      ,IsEureka, '{"AssignedTo": "brentj","Service":"Azure Core Platform and Decision Infrastructure"}'
                      ,'')
| extend TeamGroupName = iff(Service == 'AzCCX-TechEnablement', 'Azure Core Insights (MURALIC)',TeamGroupName)
| extend ExceptionStatus = strcat(ExceptionRequestType,'.', ExceptionDecision) | extend ExceptionStatus = iff(ExceptionStatus=='.','',ExceptionStatus)
| extend Notes = iif(Service == 'Tartarus Unauthorized Party Abuse',
                     pack_array("Service to be deleted"),
                     dynamic([]))
| extend Notes = iif(ExceptionStatus in ("Blocker.Approved", "Dispute.Pending"),
                     array_concat(Notes, pack_array("Awaiting Exception activity")),
                     Notes)
| extend IsOverdue = CurrentDueDate < now()
| extend IsOverETA = CurrentETA < now() or isempty( CurrentETA)
| join kind=leftouter (SFI_Annotations) on ID
| extend Notes = array_concat(Notes, iff(isnotempty(Notes1),pack_array(Notes1),dynamic([])))
| project-away ID1, Notes1
| extend Actual = parse_json(Actual)
| extend ShouldBeAssignedTo = coalesce(tostring(Actual.AssignedTo), AssignedTo),ShouldBeService = coalesce(tostring(Actual.Service), Service)
| extend Notes=tostring(Notes)
}

.create-or-alter function with (folder = "S360", docstring = "", skipvalidation = "true") SFI_FIXUP() {   
    GetLatestSFISnapshot()
    | invoke Invoker_FixSFIData()
}

// List of functions in Accia.LeftShift.ShS collection

// List of functions in Accia.LeftShift.NewUser collection

// List of functions in Accia.LeftShift.ADF collection

.create-or-alter function with (folder = "ShS/NewUser/ADF", docstring = "", skipvalidation = "true") ADF_NewUser_Interactions_Article_Level_Data() {  
 // ADF Job Link: https://ms-adf.azure.com/en/authoring/pipeline/Copy_table_from_leftshift_to_bonsai?factory=%2Fsubscriptions%2Fa361be42-7b3c-4ab9-ab2b-2558d58ce48d%2FresourceGroups%2FACCIA_CSS_ADF%2Fproviders%2FMicrosoft.DataFactory%2Ffactories%2FACCIACSSDatafactory
 // ADF Output Table: database("Bonsai").NewUser_Interactions_Article_Level_Data
union
(Get_NewUser_Interactions_Article_Level(ParamScanStartDate=ago(180d), ParamScanEndDate=now(), summarize_time_level="Monthly") | extend summarize_time_level="Monthly"),
(Get_NewUser_Interactions_Article_Level(ParamScanStartDate=ago(42d), ParamScanEndDate=now(), summarize_time_level="Weekly")  | extend summarize_time_level="Weekly")
| extend ADF_ProcessedTime = now()
}

.create-or-alter function with (folder = "ShS/NewUser", docstring = "New User\'s Interactions Artcle Level", skipvalidation = "true") Get_NewUser_Interactions_Article_Level(ParamScanStartDate:datetime, ParamScanEndDate:datetime, summarize_time_level:string) {
// Weekly New User's Article Performance Metrics
// // Usage: Get_NewUser_Interactions_Article_Level( startDate=ago(42d), endDate=now(), summarize_time_level="Weekly")
// let ParamScanStartDate = ago(42d)
// ;
// let ParamScanEndDate = now()
// ;
// Monthly New User's Article Performance Metrics
// // Usage: Get_NewUser_Interactions_Article_Level( startDate=ago(180d), endDate=now(), summarize_time_level="Monthly")
// let ParamScanStartDate = ago(180d)
// ;
// let ParamScanEndDate = now()
// ;
// let summarize_time_level = "Monthly"
// ;
let StartDate = iff(summarize_time_level == "Monthly",startofday(startofmonth(ParamScanStartDate)), 
                    startofday(ParamScanStartDate, toint(6-(((dayofweek(ParamScanStartDate)/1d)+1)%7)))-6d) 
;
let EndDate = ParamScanEndDate;
let article_data = database("CXP_CSF").Get_SelfHelpRaw()
| where StartWorkflowTimestamp >= StartDate
| project SolutionArticleProperties, workflowId
| mv-expand todynamic(SolutionArticleProperties)
| project WorkflowId=workflowId, ArticleId=SolutionArticleProperties['ArticleId'],SolutionType= SolutionArticleProperties['SolutionType']
| where ArticleId != ""
;
GetCSFData(StartDate,EndDate)
| where InitialProductId !=""
| invoke database("LeftShift").Invoker_AddUserMetadata()
| where IsNewCSFUser
| join hint.strategy=shuffle kind=inner  (article_data) on WorkflowId
| extend Timestamp = iff(summarize_time_level == "Monthly",startofday(endofmonth(StartWorkflowTimestamp)),
                        startofday(StartWorkflowTimestamp, toint(6-(((dayofweek(StartWorkflowTimestamp)/1d)+1)%7))))
| summarize wf_count = count(),
  cuml_sr_created = countif(IsSRCreated),
  cuml_help_engg = countif(IsHelpEngaged),
  cuml_engg_deflection = countif(IsHelpEngaged and not(IsSRCreated)),
  cuml_dsr = countif(not(IsHelpEngaged) and IsSRCreated),
  average_time_on_blades = avgif(TimeOnBladeInSeconds, TimeOnBladeInSeconds >=0),
  average_csf_visit = avgif(CSFVisit, CSFVisit >=0),
  average_product_visit = avgif(ProductCSFVisit, ProductCSFVisit >=0),
  article_initial_path = make_set(InitialPathName),
  workflow_ids = make_set(WorkflowId)
  by tostring(ArticleId),InitialProductId, InitialLeafTopicId, Timestamp 
| extend probablity_of_sr_creation = todouble(cuml_sr_created)/wf_count
| extend probablity_of_dsr_creation = todouble(cuml_dsr)/wf_count
| extend probality_engagement= todouble(cuml_help_engg)/wf_count
| extend probablity_of_deflection_given_engaged = todouble(cuml_engg_deflection)/cuml_help_engg 
| extend probability_of_engaged_deflection = todouble(cuml_engg_deflection)/wf_count
| order  by wf_count desc
}

