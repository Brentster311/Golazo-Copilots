.create-or-alter function with (folder = "CARET/InputRaw/KO", docstring = "", skipvalidation = "true") Cook_AzureCoreClosedSrInsights(ParamScanStart:datetime=datetime(null), ParamScanEnd:datetime=datetime(null)) {
    // SAMPLE USAGE
    //      _AzureCoreClosedSrInsights|count
    // NOTE: 
    //     - Azure Core and onboarded non-Core products only !!!!!
    //     - Only fetch insights for Closed SR
    //     - Take latest insights upon KO job execution time
    // ATTENTION : 
    //     - Cook is incremental, run once for each SR, which means to ignore all diag triggerred for Closed SR after KO instance
    //     - Broadly onboard non-Core will cause this func run away. need better design by then
    //     - Update to support Active SR:
    //              Daily KO. NOT support NRT
    //              Cover cases creatd in previous X days and closed in previous X days
    // ETL: 
    //     - LENS   : CARET Kusto - Cook_AzureCoreClosedSrInsightsDiag
    //                https://lens.msftcloudes.com/#/job/9a502236b60b4b1ebeae8ec94c91ff71?_g=(ws:e1f08ca2-fef0-4d30-86c4-c69b4954fcd8)
    //     - Func   : Cook_AzureCoreClosedSrInsightsDiag()
    //     - Source : Get_CARET_SR_List() to drive input , AzureCore + onboarded NonCore
    //                Invoker_GetInsightsForSR() consumes
    //                    cluster('azds').database("adsmds").InsightsEvent |summarize min(env_time)   // Rentention ~6 mon
    //                    cluster("azds").database("adsmds").DiagnosticEvent |summarize min(env_time) // Rentention ~6 mon
    //     - Output : _AzureCoreClosedSrInsights // Cache_Invoker_GetInsightsForSR_AzureCore
    // Manual ETL   : .drop table _AzureCoreClosedSrInsights
    //                .set-or-append _AzureCoreClosedSrInsights<|Cook_AzureCoreClosedSrInsights()
    //                .set-or-append _AzureCoreClosedSrInsights<| _AzureCoreClosedSrInsights|take 0|union (_AzureCoreClosedSrInsights_PENDINGREMOVE_20231107)
    // 
    // Manual BACKFILL: .set-or-append _AzureCoreClosedSrInsights_Temp <| Cook_AzureCoreClosedSrInsights(3d)
    //                .drop table _AzureCoreClosedSrInsights 
    //                .set-or-append _AzureCoreClosedSrInsights <| _AzureCoreClosedSrInsights_Temp
    //
    //let ParamScanRange = 3d;
    let ScanStart = coalesce(ParamScanStart, ago(3d));
    let ScanEnd = coalesce(ParamScanEnd, now());
    let data = union isfuzzy=True
                    (database("LeftShift")._AzureCoreClosedSrInsights)  //Cache_Invoker_GetInsightsForSR_AzureCore
                   ,(print SupportRequestNumber='', IsClosed=False |take 0 );
    union 
        (
            database("LeftShift").Get_CARET_SR_List(
                    ParamScanStart          = ScanStart
                   ,ParamScanEnd            = ScanEnd
                   ,ParamScanOnClosedDate   = True
                   ,ParamRequiresEmailComm  = False
                   )
        ),
        (
            database("LeftShift").Get_CARET_SR_List(
                    ParamScanStart          = ScanStart
                   ,ParamScanEnd            = ScanEnd
                   ,ParamScanOnClosedDate   = False
                   ,ParamRequiresEmailComm  = False
                   )
        )
    | summarize  IsClosed = max(IsClosed) by SupportRequestNumber
    | join kind = leftanti(data | where isnotempty(IsClosed)) on SupportRequestNumber
    | invoke database("LeftShift").Invoker_GetInsightsForSR()
    | where isnotempty(SymptomId)
}

