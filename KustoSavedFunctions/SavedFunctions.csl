// List of functions in Accia.LeftShift.Invokers collection

.create-or-alter function with (folder = "LeftShift/Incidents/Invokers", docstring = "", skipvalidation = "true") Invoker_AddCriTsgLinks(T:(SupportRequestNumber:string,RelatedICM_IDs:string)) {
    // SAMPLE USAGE
    //      cluster('accia.kusto.windows.net').database('LeftShift').GetLeftShiftData(30, 16450)| where IsCaseClosed|invoke Invoker_AddCriTsgLinks()
    //      cluster('accia.kusto.windows.net').database('CXP_CSF').GetSupportRequestsWithReferenceModel()| where CreatedDate > ago(90d) and State == 'Closed' and isnotempty(RelatedICM_IDs)|project SupportRequestNumber, RelatedICM_IDs, ProductId|invoke Invoker_AddCriTsgLinks()|where isnotempty(TSG_Links)
    //
    //let T = cluster('accia.kusto.windows.net').database('LeftShift').GetLeftShiftData(90)| where IsCaseClosed|project SupportRequestNumber,RelatedICM_IDs;
    let T1 =materialize(
        T
        | where isnotempty(RelatedICM_IDs) 
        | extend    CRI_IncidentId  = split(RelatedICM_IDs, ',')
        | mv-expand CRI_IncidentId to typeof(string) |as icm_raw
        | join kind = inner hint.strategy=shuffle hint.strategy=broadcast (
            cluster('acciafollowercentralus.centralus.kusto.windows.net').database("IcMDataWarehouse").IncidentCustomFieldEntries
            | where isnotempty(IncidentId)
            | where IncidentId  in((icm_raw|project CRI_IncidentId))
            | where DisplayName contains "tsg" // ATTENTION: Display name is arbitratry string, potentially differs in each service's template
            | where Value contains "https://" or Value contains "http://"
            | project CRI_IncidentId = tostring(IncidentId), TSG_Link=Value
            //PENDING: URL Cleanup
        ) on CRI_IncidentId| project-away CRI_IncidentId, CRI_IncidentId1
        | summarize TSG_Links = strcat_array(make_set(TSG_Link), ';'), take_any(*) by SupportRequestNumber 
        | project-away TSG_Link
        );
    union 
        (T1)
       ,(T| where SupportRequestNumber !in((T1|project SupportRequestNumber)))
}

.create-or-alter function with (folder = "LeftShift/Incidents/Invokers", docstring = "", skipvalidation = "true") Invoker_AddIcMMetadata(T:(SupportRequestNumber:string), ParamScanStart:datetime) {
//let ParamScanStart = ago(29d); let T = GetLeftShiftData(ParamScanStart);
let CRIData = materialize(
        cluster('https://acciafollowercentralus.centralus.kusto.windows.net').database("IcMDataWarehouse").IncidentsSnapshotV2() 
        | where CreateDate>=ParamScanStart
        | where isnotempty( SupportTicketId) and isnotempty( IncidentId) 
        | project SupportTicketId, IncidentId, Title,RootCauseId, ResponsibleTeamName, ResponsibleTenantName, OwningTeamName, OwningTenantName,RoutingId,CRI_MinutesToMitigate = (MitigateDate-CreateDate)/1m, CRI_Keywords = Keywords, CRI_Mitigation=Mitigation,CRI_HowFixed = HowFixed, Status, ModifiedDate,Severity
        | summarize hint.strategy=shuffle  
                 RelatedCRI_Ids = strcat_array(make_set(IncidentId),',')
                ,CRI_HowFixed = strcat_array(make_set(todynamic(CRI_HowFixed)),',')
                ,CRI_Keywords = strcat_array(make_set(todynamic(CRI_Keywords)),',')
                ,CRI_Mitigation = strcat_array(make_set(todynamic(CRI_Mitigation)),',')
                ,CRI_OwningTeamName = strcat_array(make_set(todynamic(OwningTeamName)),',')
                ,CRI_OwningTenantName = strcat_array(make_set(todynamic(OwningTenantName)),',')
                ,CRI_ResponsibleTenantName = strcat_array(make_set(todynamic(ResponsibleTenantName)),',')
                ,CRI_ResponsibleTeamName = strcat_array(make_set(todynamic(ResponsibleTeamName)),',')
                ,CRI_RoutingId = strcat_array(make_set(todynamic(RoutingId)),',')
                ,CRI_Titles = strcat_array(make_set(todynamic(Title)),',')
                ,CRI_RootCauseId = strcat_array(make_set(RootCauseId),',')
                ,CRI_MinutesToMitigate = max(CRI_MinutesToMitigate)
                ,(LastModifiedDate, CRI_Status) = arg_max(ModifiedDate, Status)
                ,Severity = strcat_array(make_set(Severity),',')
                by  SupportRequestNumber=SupportTicketId
                |project-away LastModifiedDate
        )
;
union 
    (
        T
        | where isnotempty( SupportRequestNumber)
        | join kind = leftouter(CRIData) on SupportRequestNumber
        | extend IsCRI= isnotempty(SupportRequestNumber1)
        | project-away SupportRequestNumber1
    )
   ,(
        T
        | where isempty( SupportRequestNumber)
    )
| extend 
    IsCRI = coalesce(IsCRI, false)
}

.create-or-alter function with (folder = "LeftShift/Incidents/Invokers", docstring = "", skipvalidation = "true") Invoker_AddIcMMetadata_V2(T:(SupportRequestNumber:string,RelatedICM_IDs:string), ParamScanStart:datetime=datetime(2011-11-11), ParamScanEnd:datetime=datetime(2099-9-9)) {
    // SAMPLE USAGE
    //      cluster('accia.kusto.windows.net').database('LeftShift').GetLeftShiftData(90, 16450)| where IsCaseClosed|invoke Invoker_AddIcMMetadata_V2()
    //      cluster('accia.kusto.windows.net').database('CXP_CSF').GetSupportRequestsWithReferenceModel()| where ProductId ==16450 and State == 'Closed' and isnotempty(RelatedICM_IDs)|order by CreatedDate desc| take 1000|invoke Invoker_AddIcMMetadata_V2()
    //
    //let ParamScanStart = ago(90d); let T=cluster('accia.kusto.windows.net').database('CXP_CSF').GetSupportRequestsWithReferenceModel()| where ProductId ==16450 and State == 'Closed' and isnotempty(RelatedICM_IDs)|order by CreatedDate desc| take 1000 |project SupportRequestNumber,RelatedICM_IDs//| where IncidentId in ("2202260040000152", "2202260030000073", "2202260050000245", "2202260050000263", "2202260010000423");
    let T1 =materialize(
        T
        | where isnotempty(RelatedICM_IDs) 
        | project SupportRequestNumber, RelatedICM_ID  = split(RelatedICM_IDs, ',')
        | mv-expand RelatedICM_ID to typeof(string)
        );
    // Escalated or teams engaged for IcM incidents
    // Take PrimaryTarget on notification level
    let IcmNotifications = materialize(
        cluster('acciafollowercentralus.centralus.kusto.windows.net').database("IcmDataWarehouse").Notifications
        //| where IncidentId in ((T1|project RelatedICM_ID))
        | project NotificationId, PrimaryTarget = tolong(PrimaryTarget), IncidentId=tostring(IncidentId), Lens_IngestionTime
        | summarize arg_max(Lens_IngestionTime, *) 
            by IncidentId, NotificationId 
        );
    // Engaged teams details for IcM incidents
    let IcMTeams= materialize(
        cluster('acciafollowercentralus.centralus.kusto.windows.net').database('IcmDataWarehouse').Teams
        | where IsTombstoned == 'False'
        | project TeamId, TenantId,Lens_IngestionTime
        | summarize arg_max(Lens_IngestionTime, *) by TeamId
        | project-away Lens_IngestionTime
        );
    let IcMCustomFields = 
        cluster('acciafollowercentralus.centralus.kusto.windows.net').database("IcMDataWarehouse").IncidentCustomFieldEntries
        //| where Lens_IngestionTime between(ParamScanStart ..ParamScanEnd) //PENDING CHECK
        | extend TenantId = coalesce(TenantId, TeamId, FrontEndCategoryId)
        | extend TenantName = coalesce(TenantName,TeamName,FrontEndCategoryName)
        // where TenantId in (22547,36722) //TEMP: AKS only // BUGGY // AKS EEE is 36722
        | where TenantId in (22547, 20251) // TEM: AKS only // AKS PG tenantid is 22547 // Support tenantId is 20251 // # Fix#2, Any EEE is 20251
        | where TenantId != 1
        | where Value !in ('na','n/a','N/A','NA', 'Other','Unknown', '') 
        | summarize arg_max(Lens_IngestionTime, CustomFieldId, tostring(IncidentId), DisplayName, TenantId, TenantName, Value) by IncidentCustomFieldId
        | extend Key=replace_regex(DisplayName,@' |\?', '_')
        | extend value_pair = strcat(DisplayName, ':', Value)
        | summarize 
                CRI_AKS_PG_Text=strcat_array(make_set_if(value_pair,TenantId==22547),',')
               ,CRI_AKS_EEE_Text=strcat_array(make_set_if(value_pair,TenantId==36722),',')
               ,Is_there_a_TSG_for_this_issue_ = strcat_array(make_set_if(Value,TenantId==22547 and Key=='Is_there_a_TSG_for_this_issue_'),';')
               ,TSG_Link_and_Comments = strcat_array(make_set_if(Value,TenantId==22547 and Key in ('TSG_Link_and_Comments', 'TSG_Link','TSG_Comments')),';')
                by IncidentId
        ;
     let T2 = materialize ( 
        T1
        | join kind=leftouter hint.strategy=shuffle  (IcmNotifications) on $left.RelatedICM_ID == $right.IncidentId
        | join kind=leftouter (IcMTeams) on $left.PrimaryTarget == $right.TeamId
        | join kind=leftouter hint.strategy=shuffle  (IcMCustomFields) on IncidentId
        | summarize 
            Engaged_TeamIDs = strcat_array(make_set(PrimaryTarget),',')
           ,Engaged_TenantIds = strcat_array(make_set(TenantId),',')
           ,take_any(*)
            by SupportRequestNumber
        | project-away PrimaryTarget, TenantId
        //| extend IsEEE_Engaged = Engaged_TeamIDs has "36722"     // AKS EEE teamid is 36722   # original
        //| extend IsEEE_Engaged = Engaged_TeamIDs has "20251"     // Support tenantId is 20251 # Fix#1
        | extend IsEEE_Engaged = Engaged_TenantIds has "20251"     // Support tenantId is 20251 # Fix#2, Any EEE is 20251
        | extend IsPG_Engaged = Engaged_TenantIds has "22547"      // AKS PG tenantid is 22547
        );
    T
    | join kind = leftouter hint.strategy=shuffle (T2) on SupportRequestNumber|project-away SupportRequestNumber1
}

