// List of functions in Accia.LeftShift.S360 collection

// List of functions in Accia.LeftShift.Cook collection

.create-or-alter function with (folder = "S360/Cook", docstring = "", skipvalidation = "true") KO_Gets360Data(ParamScanStart:datetime, ParamScanEnd:datetime) {   
    let basedata = 
        //union 
        //    cluster('https://s360prodro.kusto.windows.net').database('service360db').S360ExpandedActionItem_*
        cluster('https://s360prodro.kusto.windows.net').database('service360db').GetAllActionItemTypeData()
        | where S360_PartC has '65a010a5-1e3d-4777-bb89-f149470a507d'
           or S360_PartC has '68556099-a3e2-472e-8da0-e1d1b000eda4'
        | where S360_Audience_DisplayName == "Murali Chintalapati"
        | project-away S360_ServiceHierarchy_Json,  S360_UniqueKey
        | extend S360_WaveIds = parse_json(S360_PartC).S360_WaveIds
        | extend S360_ProgramIds = parse_json(S360_PartC).S360_ProgramIdsV2
        | extend Wave = case(
                            S360_WaveIds has "591337bf-6c64-4bf1-b117-03acccea2371", "Wave 1",
                            S360_WaveIds has "24a0a75a-e945-4018-8589-58b8b18c624f", "Wave 2",
                            S360_WaveIds has "19ead072-3bf1-4901-8cba-d837732cddb0", "Wave 3",
                            S360_WaveIds has "0a400b02-e474-421e-b9d9-8d3bd026a5f3", "Wave 4",
                            S360_WaveIds has "2a363cb6-e31d-48ec-a30f-3ad5770950bf", "Wave 5",
                            S360_WaveIds has "2197c304-6dd4-44b6-8b01-be6793536e55", "Wave 6",
                            "")
                 , Program = case(
                            S360_ProgramIds has '65a010a5-1e3d-4777-bb89-f149470a507d', '0. SFI',
                            S360_ProgramIds has "68556099-a3e2-472e-8da0-e1d1b000eda4", '1. QEI',
                            S360_ProgramIds has "ccc75fc8-dd6a-4351-8465-ecf2ccbe3493", '2. GetSecure',
                            'Unknown')
                 , Owner = iff(isnotempty(S360_ServiceDevOwner), S360_AssignedToName, S360_ServiceTreeServiceName)
    ;
    let servicetreelookup = cluster('genevareference.westcentralus.kusto.windows.net').database("Shared").ServiceTree_ServiceHierarchy_Snapshot 
    | project Id, ServiceInternalId = InternalId
    | join kind=inner (
        cluster('genevareference.westcentralus.kusto.windows.net').database("Shared").ServiceTree_ServiceMetadata_Snapshot 
        | where MetadataDefinitionInternalId == int(373)
        | project ServiceInternalId, ServiceType=tostring(parse_json(Value).ServiceTypeClassification)
    ) on ServiceInternalId | project-away ServiceInternalId, ServiceInternalId1
    ;
    basedata
    | project Id=id
            ,S360_ActionItemId
            ,Owner = replace("'s Team","",Owner)
            ,ServiceName=S360_ServiceTreeServiceName
            ,ServiceId=S360_ServiceId
            ,Program
            ,Wave
            ,Title=['title'], name
            ,dueDate
            ,S360_PartC
            ,url
            ,S360_ProgramIds
    | extend S360URL = strcat('https://vnext.s360.msftcloudes.com/blades/security?blade=KPI:'
                             ,S360_ActionItemId
                             ,'~SLA:3~AssignedTo:All~Forums:All~Program:68556099-a3e2-472e-8da0-e1d1b000eda4;65a010a5-1e3d-4777-bb89-f149470a507d~waves:All~Tab:Summary~_loc:Security&peopleBasedNodes=muralic_team&global=3:30c278fc-751d-4262-b5e6-ba797dba7907'
                             ,'&tile=S360_AssignedToName:'
                             ,Owner
                             ,'~S360_ServiceTreeServiceName:'
                             ,ServiceName
                             ,'~_loc:__key__Security__'
                             ,S360_ActionItemId)
    | join kind=leftouter (servicetreelookup) on $left.ServiceId==$right.Id | project-away Id1                 
    //| distinct *
    | extend ParamScanStart=ParamScanStart,ParamScanEnd=ParamScanEnd
    | extend KO_ProcessedTime = now()
    | extend KpiId = S360_ActionItemId
    | join kind=leftouter (
        	union cluster('https://s360prodro.kusto.windows.net').database('service360db').ActionItemETAs_Calculated_Snapshot, 
    	      cluster('https://s360prodro.kusto.windows.net').database('service360db').ActionItemETAs_Calculated_Log ) on Id,KpiId
    	       | summarize hint.strategy=shuffle arg_max(CreatedDateTime, *) by Id, KpiId, TargetId, SlaType
    | project-reorder KpiId,Id, dueDate,Eta,Title,S360URL
}

.create-or-alter function with (folder = "S360/Cook", docstring = "", skipvalidation = "true") KO_Gets360DataV2(ParamScanStart:datetime, ParamScanEnd:datetime) {
    let VAR_servicegroupid = dynamic(["d6f1b2cc-ceb9-43d4-a692-ad70185f2c0d"]);
    let VAR_exceptiontype = dynamic(["Blocker"]);
    let VAR_exceptiondecision = dynamic(["Approved","Pending"]);
    //
    let servicetreelookup = cluster('genevareference.westcentralus.kusto.windows.net').database("Shared").ServiceTree_ServiceHierarchy_Snapshot 
    | project Id, ServiceInternalId = InternalId
    | join kind=inner (
        cluster('genevareference.westcentralus.kusto.windows.net').database("Shared").ServiceTree_ServiceMetadata_Snapshot 
        | where MetadataDefinitionInternalId == int(373)
        | project ServiceInternalId, ServiceType=tostring(parse_json(Value).ServiceTypeClassification)
    ) on ServiceInternalId | project-away ServiceInternalId, ServiceInternalId1
    | join kind=inner (cluster('genevareference.westcentralus.kusto.windows.net').database("Shared").DataStudio_ServiceTree_Hierarchy_Snapshot
        | where ServiceGroupId in (VAR_servicegroupid)
        | where Level == "Service"
        | summarize arg_max(ChangeVersion, * ) by Id 
        | project-away Id
     ) on $left.Id==$right.ServiceId
    ;
    let peoplelookup = cluster('s360prodro.kusto.windows.net').database('service360db').S360_PeopleWithServiceHierarchy_RT 
    | project Alias, ServiceGroupIds, TeamGroupIds, ActualDisplayName
    | mv-expand ServiceGroupId = ServiceGroupIds to typeof(string) | project-away ServiceGroupIds
    | mv-expand TeamGroupId = TeamGroupIds to typeof(string) | project-away TeamGroupIds
    | where ServiceGroupId in (VAR_servicegroupid)
    ;
    let Programdetails =  cluster('s360prodro.kusto.windows.net').database('service360db').ProgramsMetadata()
        | where not(IsDeleted)
        | project ProgramId, DisplayName, Kpis
    ;
    let KPIDetails = Programdetails
        | mv-expand Kpis
        | extend KpiId = tostring(Kpis.KpiId),KPIDisplayName = tostring(Kpis.DisplayName)
        | distinct ProgramId, DisplayName, KpiId, KPIDisplayName
    ;
    let VAR_kpi = toscalar(KPIDetails | summarize make_set(KpiId))
    ;
    let VAR_servicetreeserviceid =  toscalar(servicetreelookup | summarize make_set(ServiceId))
    ;
    let VAR_people =  toscalar(peoplelookup | summarize make_set(Alias))
    ;
    let exceptions = cluster('s360prodro.kusto.windows.net').database('service360db').GetAllExceptions()
        | where KpiId in (VAR_kpi)
        | where IsDeleted == false
        | project KpiId, id, ExceptionRequestServiceId=RequestingTargetId, ExceptionRequestType=RequestType,ExceptionDecision=Decision, ExceptionProposedDueDate=ProposedDueDate
    ;
    let GSS2_lookup = cluster('https://s360drilledinfo.kusto.windows.net').database('s360drilledinforo').GetSecure20_RawData 
    | where isnotempty( ['Risk Score'])
    | where KPIId in (VAR_kpi)
    | where ServiceId in (VAR_servicetreeserviceid)
    | distinct ServiceId,  KPIId, ['Risk Score']
    ;
    let ActiveActionItems = cluster('s360prodro.kusto.windows.net').database('service360db').GetActiveActionItems 
        | where ActionItemId in (VAR_kpi)
        | where TargetId in (VAR_servicetreeserviceid) or 
                TargetType in (VAR_people)
        | where TargetId in (VAR_servicetreeserviceid)
        | extend CustomDims = parse_json(CustomDimensions)
        | extend S360_WavesMetadata = parse_json(tostring(CustomDims['S360_WavesMetadata']))
        | extend S360_WavesMetadata = iff(array_length(S360_WavesMetadata )==0, todynamic('[{}]'), S360_WavesMetadata)
        | mv-expand S360_WavesMetadata
        | extend WaveDisplayName = tostring(S360_WavesMetadata.WaveDisplayName), ProgramDisplayName = tostring(S360_WavesMetadata.ProgramDisplayName)
                ,WaveId=tostring(S360_WavesMetadata.WaveId), ProgramId = tostring(S360_WavesMetadata.ProgramId)
        | lookup kind=leftouter (KPIDetails) on ProgramId, $left.ActionItemId==$right.KpiId
        | lookup kind=leftouter (servicetreelookup) on  $left.TargetId==$right.ServiceId
        | lookup kind=leftouter (exceptions) on $left.ID == $right.id and $left.ActionItemId == $right.KpiId
        | lookup kind=leftouter (peoplelookup | project ActualDisplayName, Alias) on $left.AssignedTo==$right.Alias
     //   | lookup kind=leftouter (GSS2_lookup) on $left.TargetId==$right.ServiceId, $left.ActionItemId==$right.KPIId
        | project-away CustomDimensions,S360_WavesMetadata, S360Dimensions
    ;
    ActiveActionItems
        | where Level == 'Service'
        | extend Team = TeamGroupName
        | extend Service = Name
        | extend ShortTeamName = extract(@"\(([^)]+)\)", 1, TeamGroupName)
        | extend AllActionUrls = extract_all(@"(https?://[^\s""'<>]+)", tostring(pack_all()))
        | extend S360TeamLink = strcat('https://vnext.s360.msftcloudes.com/blades/allup?blade=Tab:KPI~isExpanded:false~KPIType:ActionItems;LaunchCriteria;Metric~SLA%2520State:All~ETAs:All~KPIs:All~Domains:All~Forums:All~_loc:allUp&global=3:',TeamGroupId)
        | extend S360TeamKPILink = strcat('https://vnext.s360.msftcloudes.com/blades/security?blade=KPI:',ActionItemId,'~SLA:3~AssignedTo:All~waves:All~Tab:Summary~_loc:Security&peopleBasedNodes=',tolower(ShortTeamName),'_team&global=3:',TeamGroupId)
        | extend S360URL = strcat('https://vnext.s360.msftcloudes.com/blades/security?blade=KPI:'
                             ,ActionItemId
                             ,'~SLA:3~AssignedTo:All~Forums:All~waves:All~Tab:Summary~_loc:Security&peopleBasedNodes=',tolower(ShortTeamName),'&global=3:'
                             ,TeamGroupId
                             ,'&tile=S360_AssignedToName:'
                             ,ActualDisplayName
                             ,'~S360_ServiceTreeServiceName:'
                             ,ServiceName
                             ,'~_loc:__key__Security__'
                             ,ActionItemId)
        | extend S360URL2 = strcat('https://vnext.s360.msftcloudes.com/blades/quality/reliability?blade=KPI:'
                             ,ActionItemId
                             ,'~SLA:3~AssignedTo:All~Forums:All~waves:All~Tab:Summary~_loc:Reliability&peopleBasedNodes=',tolower(ShortTeamName),'&global=3:'
                             ,TeamGroupId
                             ,'&tile=S360_AssignedToName:'
                             ,url_encode(ActualDisplayName)
                             ,'~S360_ServiceTreeServiceName:'
                             ,url_encode(ServiceName)
                             ,'~_loc:__key__Reliability__'
                             ,ActionItemId)
         | extend S360URL = iff(ProgramId =='68556099-a3e2-472e-8da0-e1d1b000eda4',S360URL2,S360URL) | project-away S360URL2
        | extend KO_ProcessedTime = now()
        | project-away Id
}

// List of functions in Accia.LeftShift.Invokers collection

.create-or-alter function with (folder = "S360/Invokers", docstring = "Get active action item ETAs", skipvalidation = "true") Invoker_AddtActiveActionItemETAs(T:(Id:string)) {
    //
    let Ids = T | summarize make_set(Id)
    ;
    let etas=	cluster('https://s360prodro.kusto.windows.net').database('service360db').ActionItemETAs_Calculated_Log
        | extend Id=tolower(Id)
    	| where Id  in (Ids)
        | summarize arg_max(CreatedDateTime, *) by Id, KpiId, TargetId, SlaType
        | join kind=fullouter (
            cluster('https://s360prodro.kusto.windows.net').database('service360db').ActionItemETAs_Calculated_Snapshot 
            | extend Id=tolower(Id)
            | where Id  in (Ids)
        ) on Id, KpiId, TargetId, SlaType
        | project Id=iff(isnotempty(Id), Id, Id1), KpiId=iff(isnotempty(KpiId), KpiId, KpiId1), ServiceId=iff(isnotempty(TargetId), TargetId, TargetId1), ServiceGroupId=iff(isnotempty(TargetGroupId), TargetGroupId, TargetGroupId1), SlaType=iff(isnotempty(SlaType), SlaType, SlaType1), Eta=iff(isnotempty(Id), Eta, Eta1), 
                    Status=base64_decode_tostring(iff(isnotempty(Id), Status, Status1)), CreatedDateTime=iff(isnotempty(CreatedDateTime), CreatedDateTime, CreatedDateTime1),CreatedBy=iff(isnotempty(CreatedBy), CreatedBy, CreatedBy1),
                    CreatedByDisplayName=iff(isnotempty(CreatedByDisplayName), CreatedByDisplayName, CreatedByDisplayName1), S360_ProgramIds=iff(isnotempty(S360_ProgramIds), S360_ProgramIds, S360_ProgramIds1)
        | summarize arg_max(CreatedDateTime, *) by Id, KpiId, ServiceId
        | project Id, SlaType, Eta
    ;
    T
    | join kind=leftouter (etas) on Id | project-away Id1
}

