    | lookup kind=inner(database('CXP_CSF').ActiveTopicTree()|distinct InitialProductId=ProductId, SapProductId)on InitialProductId
}

// List of functions in Accia.LeftShift.DS collection

.create-or-alter function with (folder = "LeftShift/DS", docstring = "", skipvalidation = "true") Invoker_GetOneHotEncoding(T:(*), PrimaryKeyName:string, FeatureColName:string, FeatureColPrefix:string="Is_") {
    // SAMPLE USAGE
    //      database('CXP_CSF').Get_CSF_Cooked()|take 10000|summarize SolutionTypeSet = make_set(todynamic(SolutionType))by WorkflowId|take 1000|invoke Invoker_GetOneHotEncoding(PrimaryKeyName = 'WorkflowId', FeatureColName = 'SolutionTypeSet', FeatureColPrefix = 'Is_')
    //
    //let PrimaryKeyName = 'WorkflowId';  let FeatureColName = 'SolutionTypeSet'; let FeatureColPrefix = 'Is_'; let T=database('CXP_CSF').Get_CSF_Cooked()|take 10000|summarize SolutionTypeSet =  make_set(todynamic(SolutionType)) by WorkflowId,SupportRequestNumber;
    T
    | extend PrimaryKeyCol  = column_ifexists(PrimaryKeyName,strcat('COLUMN NOT EXIST :', PrimaryKeyName))
            ,FeatureCol     = column_ifexists(FeatureColName,strcat('COLUMN NOT EXIST :', FeatureColName))
    | as T1
    | extend FullList = toscalar(T1|summarize make_set(todynamic(FeatureCol)))
    | mv-expand FullList to typeof(string)
    | extend cnt = toint(FeatureCol contains FullList)
    | extend FeatureCol = strcat(FeatureColPrefix,FullList)
    | evaluate pivot(FeatureCol,max(cnt),PrimaryKeyCol)    
    | join kind = rightouter(T1) on PrimaryKeyCol
    | project-away PrimaryKeyCol, PrimaryKeyCol1, FeatureCol
}

