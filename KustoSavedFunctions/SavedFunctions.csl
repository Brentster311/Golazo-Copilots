.create-or-alter function with (folder = "NLP/Invokers", docstring = "sklearn Countvectorizer", skipvalidation = "true") Invoker_GetTokenVectors(T:(Id:string,Verbatim:string), Param_min_df:real=0.0, Param_max_df:real=1.0, Param_min_ngram:long=1, Param_max_ngram:long=1, Param_Use_Stemmer:bool=true) {
// EXAMPLE:
// let T = database("CSS_Secured").GetCSFVerbatim(ParamScanStartDate=ago(14d))
// | where InitialProductId == '14749' and isnotempty(InitialTopicId) and InitialTopicId !='issuenotlisted'
// | project Id=tostring(WorkflowId), WorkflowId,InitialTopicId
// | invoke database("CSS_Secured").Invoker_GetTranslatedVerbatim()
// | where isnotempty(Verbatim)
// ;
// T
// | invoke Invoker_GetTokenVectors(Param_Use_Stemmer=false) 
// | join kind=inner (T ) on Id | project-away Id1, WorkflowId 
//
let PythonParameters = pack('min_df',Param_min_df
                           ,'max_df',Param_max_df
                           ,'min_ngram',Param_min_ngram
                           ,'max_ngram',Param_max_ngram
                           ,'use_stemmer',Param_Use_Stemmer
                           )
;
let PythonCode = ```
from sklearn.feature_extraction.text import CountVectorizer
from nltk.stem.snowball import SnowballStemmer
import pandas
passed_min_df  = kargs["min_df"]
passed_max_df  = kargs["max_df"]
passed_min_N   = kargs["min_ngram"]
passed_max_N   = kargs["max_ngram"]
use_stemmer   = kargs["use_stemmer"]
def text_tokenizer(str_input):
    return str_input.split()

# Use NLTKs Stemmer
def stemming_tokenizer(str_input):
    words = text_tokenizer(str_input)
    words = [stemmer.stem(word) for word in words]
    return words

def Countvectorizer(row):
  data = []
  data_cleaned=df.loc[df["Id"]==row["Id"]]["Verbatim"].tolist()
  terms=[]              
  try:
    data_vectorized = MyCountVectorizer.fit_transform(data_cleaned)
    terms = MyCountVectorizer.get_feature_names()
  except Exception as e:
    data = "EXCEPTION : " + str(e)
  return(pandas.io.json.dumps(terms))
                
stemmer = SnowballStemmer("english")
if use_stemmer:
    my_tokenizer = stemming_tokenizer
else:
    my_tokenizer = text_tokenizer
result = pd.DataFrame(columns=["Id"])
result = df

MyCountVectorizer = CountVectorizer(
                                    analyzer="word",				  
                                    ngram_range=(passed_min_N,passed_max_N),				  
                                    min_df=passed_min_df,             # minimum reqd occurences of a word 
                                    max_df=passed_max_df,             # minimum reqd occurences of a word 
                                    # stop_words="english",           # remove stop words   
                                    lowercase=True,                   # convert all words to lowercase
                                    tokenizer=my_tokenizer,
                                    )
                
result["ResultVector"]= result.apply(Countvectorizer,axis=1)
```
;
T
| evaluate python(typeof(*,ResultVector:string),PythonCode,PythonParameters)
| project-rename TokensList=ResultVector
}

.create-or-alter function with (folder = "NLP/Invokers", docstring = "retrieves the found verbatim for a workflowId ", skipvalidation = "true") Invoker_GetTranslatedVerbatim(T:(WorkflowId:guid), CleanVerbatim:bool=true) {
T
| join kind=leftouter (database('CSS_Secured').GetCSFVerbatim()
                       |project WorkflowId, Verbatim = coalesce(Translation,IssueSummary)) on WorkflowId
| join kind=leftouter (
                        database("CXP_CSF").Get_CSF_Cooked()
                        | where UpdateItemId == 'Microsoft_Azure_Support/Case Submission V2/Basics/IssueSummaryTextBox' and UpdateItemAction == 'entered' and UpdateItemValue !contains '<pii>{PII:H106'
                        | summarize arg_max(LogCoordinate,UpdateItemValue) by WorkflowId
                        | project WorkflowId, Verbatim=UpdateItemValue ) on WorkflowId
| project-away WorkflowId1,WorkflowId2
| extend Verbatim= coalesce(Verbatim,Verbatim1) | project-away Verbatim1
| extend Verbatim = iff(CleanVerbatim,Scalar_CleanVerbatim(Verbatim),Verbatim)
}

.create-or-alter function with (folder = "NLP/Invokers", docstring = "", skipvalidation = "true") Invoker_RemoveVerbatimWithInfreqTerms(T:(TokensList:string), BottomPercentToRemove:real=0.1, FrequencyToRemove:int=1) {
    let OneHot = 
    T 
    | extend TokensList_dyn = todynamic(TokensList)
    ;
    let TermsIDoNotWant=
    toscalar(OneHot
    | mv-expand Term=TokensList_dyn to typeof(string)
    | summarize score=count() by Term, key=1
    | order by score asc
    | extend cumlsum = row_cumsum(score)
    | as list
    | summarize Total=max(cumlsum) by key
    | join kind=inner (list) on key 
    | extend cumlPerc = 1.0*cumlsum/Total
    | where cumlPerc<=BottomPercentToRemove and score <=FrequencyToRemove
    | summarize make_set(Term)
    )
    ;
    OneHot 
    | where array_length(set_intersect(TokensList_dyn,TermsIDoNotWant))==0
    //| extend TermsIDoNotWant=TermsIDoNotWant
}

