        | summarize wf=count(), sr=countif(IsSRCreated) by SubscriptionId
        | extend SRCreateRate = 1.0*sr/wf
        | extend DeflRate = 1-SRCreateRate
        | extend log2wf = round(log2(wf)*1,0)/1
    ;
    let linest=
        SubSummarization  
        // filter out the non-linear bits
        //      this is done on SR>0 and wf>1, regardless of ParamMagicThreshold
        //      while ParamMagicThreshold is applied for X2
        | where log2wf >=1      // Question for Brent: 
                                //      Some have log2wf>=1, some have log2wf>=2 ==> Is there intention to tune this?
                                //      log2wf>=2 implies wf>=8, which overwrites wf>1 in next line. ==> by intention?
                                //      log2wf>=1 implies wf>=4, also overwrites wf>1
        | where wf>1 and sr>0
        | summarize wf=sum(wf),sr=sum(sr) by log2wf
        | extend percentd=1.0*(wf-sr)/wf
        | order by log2wf asc
        | summarize log2wf=make_list(log2wf), y=make_list(percentd)
        | extend (RSquare, Slope, Variance, RVariance, Interception, LineFit)=series_fit_line(y)
        | project Slope, Intercept=Interception,RSquare
        ;//linest|project log2wf, y, LineFit| render linechart
    SubSummarization
        | join kind=inner (linest) where True
        | extend ExpectDeflRate = (log2wf*Slope)+Intercept
        | extend delta=DeflRate - ExpectDeflRate
        //remove extreme anomalies///////////////////////////////////////////////////
        //| where DeflRate/ExpectDeflRate <4  //400% over expected : 743 Sub
        | extend IsAanomaly = DeflRate/ExpectDeflRate >= 4
        ////////////////////////////////////////////////////////////////////////////
        | extend SRImpact = 1.0*sr/toscalar(SubSummarization | summarize sum(wf))
        | as raw_output
        // X2
        | where ParamEnableX2
        | where not(IsAanomaly)
        | where sr>0 
        | where log2wf <ParamMagicThreshold+2 and log2wf >=ParamMagicThreshold //ParamMagicThreshold==1:  log2wf <3 and log2wf>=1
        | extend isinteresting1 = log2wf < ParamMagicThreshold+1               //                         log2wf <2
        | project SubscriptionId,isinteresting1
        // Join back with Annotated
        | join hint.shufflekey=SubscriptionId kind=inner (
            raw_input
            | project IsSRCreated,SubscriptionId, Solution//, ProductId, LeafTopicId,SupportTopicL2Id,PathName
            ) on SubscriptionId| project-away SubscriptionId1
        //| extend L1_Id=ProductId,L2_Id=SupportTopicL2Id,L3_Id=SolutionArticleId
        | extend X=isinteresting1
                ,Y=IsSRCreated
                ,pivot=Solution//PathName
        | union  (print X=True,Y=True,Pivot='PivotPivotPivot') // Error handling: in case input dataset is empty
        | invoke database("CSS_Secured").Invoker_PrepChiSquare() 
        | invoke database("CSS_Secured").Invoker_GetChiSquareSigGeneric(Threshold=ParamSigThreshold) 
        | where pivot != '' // cleanup for Error handling: in case input dataset is empty
        //BMF
        | extend percentsr1 = 1.0*XY/(XY+XNOTY),percentsr2 = 1.0*NOTXY/(NOTXY+NOTXNOTY)
        | extend delta = percentsr1-percentsr2
        | order by Sig asc
        | extend IPWImpact=(XY-percentsr2*(XY+XNOTY))/13
