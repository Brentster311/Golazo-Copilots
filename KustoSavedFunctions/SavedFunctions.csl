.create-or-alter function with (folder = "NLP\\DataCleaning", docstring = "Used to prep text for training", skipvalidation = "true") Scalar_CleanVerbatim(Verbatim:string) {
        let    Accents      = @"šžàáâãäåçèéêëìíîïðñòóôõöùúûüýÿ";
        let    Replacements = @"szaaaaaaceeeeiiiidnooooouuuuyy";
        let Verbatim1 = replace(@"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}","",tolower(Verbatim));  //guids
        let Verbatim2 = replace(@"\p{S}|'","",Verbatim1); //symbols and singlequotes
        let Verbatim3 = replace(@"\p{P}"," ",Verbatim2); //punctuation
        let Verbatim4 = replace(@"\s+"," ",Verbatim3); //new lines
        let Verbatim5 = replace("[\u0370-\uFFFF]","",Verbatim4); //non-english characters
        let Verbatim6 = replace('possiblebase64encodingremoved|emailaddressremoved|phoneremoved','',Verbatim5);
        let Verbatim7 = translate(Accents,Replacements,Verbatim6); //accents
        replace(@'^\s+','',Verbatim6)
}

.create-or-alter function with (folder = "NLP\\DataCleaning", docstring = "Remove StopWords", skipvalidation = "true") Scalar_RemoveStopWords(Verbatim:string, AdditionalStopWords:dynamic) {
// example | extend Verbatim = Scalar_RemoveStopWords(Verbatim,'["logic","app"]') 
let StopWordRegex = toscalar(StopWords | extend StopwordJSON = array_concat(StopwordJSON,parse_json(AdditionalStopWords))
                             |project StopwordRegex= strcat(@'\b',strcat_array(StopwordJSON,@'\b|\b'),@'\b'))
;
Scalar_CleanVerbatim(                                                             //clean final result to remove extra spaces
                     replace(StopWordRegex,' ',                                   //replace stop words with spaces
                                                Scalar_CleanVerbatim(Verbatim)))  // clean initial result
}

