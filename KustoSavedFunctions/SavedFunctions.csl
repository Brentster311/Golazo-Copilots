// Carroll | extend Id = "Chapter 6"
// | extend Verbatim = Scalar_CleanVerbatim(Verbatim)
// | invoke Invoker_GetCountVectors()     
//
let PythonCode = ```
def Fibonacci(row):
   x=int(row["X"])
   f =lambda x,a=1,b=1:[a,b][b-x<x-a]*(b>x)or f(x,b,a+b)
   return f(x)
result=df
result["Fibonacci"]= result.apply(Fibonacci,axis=1)
```
;
T
| evaluate python(typeof(*,Fibonacci:string),PythonCode)
}

.create-or-alter function with (folder = "NLP/Invokers", docstring = "", skipvalidation = "true") Invoker_GetTermMeasures(T:(Id:string,Verbatim:string), Param_min_df:real=0.0, Param_max_df:real=1.0, Param_min_ngram:long=1, Param_max_ngram:long=1, Param_Use_Stemmer:bool=true) {
// 
// let T = database("CSS_Secured").GetCSFVerbatim(ParamScanStartDate=ago(14d))
// | where InitialProductId == '14749' and isnotempty(InitialTopicId) and InitialTopicId !='issuenotlisted'
// | project Id=tostring(InitialTopicId), Verbatim=Scalar_CleanVerbatim(coalesce(Translation,IssueSummary)),InitialTopicId
// | where isnotempty(Verbatim)
// ;
// let Param_min_df=0.0; let Param_max_df=1.0; let Param_min_ngram=2; let Param_max_ngram=2; let Param_Use_Stemmer=true;
// //
let Probabilities= (
T
| invoke Invoker_GetExclusivityProbabilities(Param_min_df, Param_max_df, Param_min_ngram, Param_max_ngram, Param_Use_Stemmer)
)
;
let TotalTermCount = Probabilities | summarize hint.shufflekey=Term TotalTermCount=sum(TermCount) by Term
;
let ProbWithTermCount=materialize(TotalTermCount
| join hint.shufflekey=Term kind=inner (Probabilities) on Term | project-away Term1
)
;
let tfidf = T 
| invoke Invoker_GetTFIDFVectors(Param_min_df, Param_max_df, Param_min_ngram, Param_max_ngram, Param_Use_Stemmer)
| invoke Invoker_GetTermsFromResultVector()
| summarize hint.shufflekey=term TFIDFScore=avg(score) by Term=term
;
let n=10000
;
let TermMeasures=ProbWithTermCount
| order by ProbWordGivenId desc
| summarize Terms=make_list(Term,n),Probs=make_list(ProbWordGivenId,n) by Id
| mv-expand Term=Terms to typeof(string), ProbWordGivenId=Probs to typeof(real)
| project-away Terms,Probs
| as list
| summarize hint.shufflekey=Term SumOfAllProbabilitiesForTerm=sum(ProbWordGivenId),IdsContainingTermInTopN=dcount(Id,4) by Term
| join kind=inner (list) on Term
| project-away Term1
| extend ratio = (ProbWordGivenId/SumOfAllProbabilitiesForTerm)/IdsContainingTermInTopN
;
let TermExclusivity=TermMeasures
| summarize hint.shufflekey=Term AverageExclusivity=avg(ratio), IdsUsing = dcount(Id,4) by Term
| join hint.shufflekey=Term kind=inner (Probabilities
                                        | summarize FrequencyTermUsed=sum(TermCount)
                                                   ,TotalRecordsWithTerm=sum(RecordsInIdWithTerm)
                                                   by Term,TotalRecordsInDataset
                                        |extend PercentRecordsWithTerm=1.0*TotalRecordsWithTerm/TotalRecordsInDataset) on Term
| project-away Term1
;
let ChiSquare = ProbWithTermCount
| project Id,Term, XY= TermCount
                 , XNOTY= TotalTermsInId - TermCount
                 , NOTXY= TotalTermCount - TermCount
                 , NOTXNOTY= TotalTermsInDataset - TotalTermsInId - (TotalTermCount - TermCount)
                 , XLabel='Id',YLabel='Term'
| invoke Invoker_GetChiSquareSigGeneric(Threshold=5) 
| summarize IdCountWithSignificance=countif(Sig between (0 .. 0.05)),IdCountWithInSufficience=countif(Sig==-1),IdCountWithInsignificance=countif(Sig>0.05) by Term
;
TermExclusivity
| join hint.shufflekey=Term kind=inner (ChiSquare) on Term| project-away Term1
| join hint.shufflekey=Term kind=inner (tfidf) on Term| project-away Term1
| extend PercentIdsWithSig = 1.0*IdCountWithSignificance/IdsUsing
// | consume
// 
}

.create-or-alter function with (folder = "NLP/Invokers", docstring = "extracts terms and scores from Result vector", skipvalidation = "true") Invoker_GetTermsFromResultVector(T:(ResultVector:string)) {
T
| extend ResultVector_dynamic = todynamic(ResultVector)
| mv-expand ResultVector_dynamic limit 100000
| extend term =tostring(ResultVector_dynamic[0]), score=toreal(ResultVector_dynamic[1])
| project-away ResultVector_dynamic,ResultVector
}

