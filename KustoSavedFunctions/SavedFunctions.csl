.create-or-alter function with (folder = "other", docstring = "", skipvalidation = "true") ThingForLaura() {
let times =cluster('accia').database("CXP_CSF").Get_CSF_Cooked() 
| where StepType =='SelfHelp' 
| summarize hint.shufflekey=WorkflowId ImputtedTimeOnBladeInSeconds = (max(EventTimestamp)-min(EventTimestamp))/1s by WorkflowId,StepNumber
| summarize TimeOnBladeInSeconds=sum(ImputtedTimeOnBladeInSeconds) by WorkflowId
;
let diags= cluster('azds').database("adsmds").DiagnosticEvent 
            | where ClientName =='Ibiza' 
            | project RequestId, DurationInMs, env_time
;
cluster('accia').database("CXP_CSF").Get_Diagnostics() 
| project WorkflowId=toguid(WorkflowId)
         ,SymptomId = coalesce(Symptom_Portal_PolledSymptomId, Symptom_ADS_PolledSymptomId)
         ,DidDiagComplete = Symptom_Status startswith 'Completed'
         ,WasInsightFound = Symptom_DiagnosticsInsightReturned //Card_Scenario_InsightStatus in ('InsightAvailable','InsightPresented')
         ,WasInsightPresented = Symptom_DiagnosticsInsightPresented//Card_Scenario_InsightStatus in ('InsightPresented')
         // if a diag resulted in an insight found, what is the insight Id?
         ,RequestId=Symptom_RequestId
         ,ArticleId = Symptom_ADS_ArticleId 
         ,IsStillRunning = Symptom_Status=='InProgress'
         ,IsFailed = Symptom_Status=='Failed'
| where DidDiagComplete or IsStillRunning or IsFailed
| join kind=inner (cluster('accia').database("CXP_CSF").Get_CSF_Annotated()| project WorkflowId,IsSRCreated,StartWorkflowTimestamp ) on WorkflowId | project-away WorkflowId1
| join kind=inner (times) on WorkflowId | project-away WorkflowId1
| join kind=inner (diags) on RequestId
| extend Id = strcat(SymptomId,'.',ArticleId)
| extend    IsPresentedSR      = (    IsSRCreated  and     WasInsightPresented)
           ,IsNotPresentedSR   = (    IsSRCreated  and not(WasInsightPresented))
           ,IsPresentedNotSR   = (not(IsSRCreated) and     WasInsightPresented)
           ,IsNotPresentedNotSR= (not(IsSRCreated) and not(WasInsightPresented))
// | summarize PresentedSRTime=avgif(DurationInMs,IsPresentedSR)
//            ,NotPresentedSRTime=avgif(DurationInMs,IsNotPresentedSR)
//            ,PresentedNotSRTime=avgif(DurationInMs,IsPresentedNotSR)
//            ,NotPresentedNotSRTime=avgif(DurationInMs,IsNotPresentedNotSR)
//            ,XY=sum(IsPresentedSR) 
//            ,NOTXY=sum(IsNotPresentedSR) 
//            ,XNOTY=sum(IsPresentedNotSR) 
//            ,NOTXNOTY=sum(IsNotPresentedNotSR) 
//            by Id
}

