.create-or-alter function with (folder = "DataScience", docstring = "", skipvalidation = "true") Invoker_GetChiSquareSigGeneric(T:(XY:long,XNOTY:long,NOTXY:long,NOTXNOTY:long), Threshold:long=30) {
