.create-or-alter function with (folder = "LeftShift/CaseSubmissionFlow/Helpers", docstring = "", skipvalidation = "true") GetSelfHelpTimesAndClicks(ParamScanStart:datetime=datetime(2018-08-08T00:00:00.0000000Z), ParamScanEnd:datetime=datetime(2099-09-09T00:00:00.0000000Z)) {
let TimesAndClicks=database("CXP_CSF").Get_CSF_Cooked() 
| where WorkflowStartTime >= ParamScanStart and WorkflowStartTime< ParamScanEnd
| where StepType =='SelfHelp' 
| extend IsClicked = (isnotempty( SolutionType) or (UpdateItemId contains 'link')) 
                     and UpdateItemAction=='clicked' 
                     and UpdateItemId !contains 'Helpful'
                     and UpdateItemId !contains 'feedback'
| extend ProductId=coalesce(ProductId,LastProductId)
| extend TopicId=coalesce(SupportTopicId_PartB,LastL3TopicId,LastL2TopicId)
| summarize hint.shufflekey=WorkflowId ImputtedTimeOnBladeInSeconds = (max(EventTimestamp)-min(EventTimestamp))/1s,IsClicked=max(IsClicked), ProductId=max(ProductId), TopicId=max(TopicId) by WorkflowId,StepNumber
| project TimeOnBladeInSeconds=ImputtedTimeOnBladeInSeconds
         ,IsHelpEngaged=IsClicked
         ,InitialProductId=ProductId
         ,InitialLeafTopicId=TopicId
         ,WorkflowId
| where isnotempty(InitialLeafTopicId) and InitialLeafTopicId != 'issuenotlisted' and InitialLeafTopicId != 'QUOTA'
;
TimesAndClicks
}

// List of functions in Accia.LeftShift.Invokers collection

.create-or-alter function with (folder = "LeftShift/CaseSubmissionFlow/Invokers", docstring = "", skipvalidation = "true") Invoker_AddDwellAnnotation(T:(WorkflowId:guid), ParamScanStart:datetime=datetime(2018-08-08T00:00:00.0000000Z), ParamScanEnd:datetime=datetime(2099-09-09T00:00:00.0000000Z)) {
let end=ParamScanEnd;
let start=ParamScanEnd-84d;
// calculate 'official' dwell threshold by using the average daily threshold for the product in the quarter ending on ParamScanEnd
let Thresholds= //GetDwellThresholds(iff(ParamScanEnd>now(),now(),ParamScanEnd))
               DwellThresholds
               | where  ParamScanEnd between (start .. end)
               | project InitialProductId,DwellThreshold
               | summarize DwellThreshold=avg(DwellThreshold) by InitialProductId
;
let times =database("CXP_CSF").Get_CSF_Cooked() 
| where WorkflowStartTime >= ParamScanStart and WorkflowStartTime< ParamScanEnd
| where StepType =='SelfHelp' 
| extend IsClicked = (isnotempty( SolutionType) or (UpdateItemId contains 'link')) 
                     and UpdateItemAction=='clicked' 
                     and UpdateItemId !contains 'Helpful'
                     and UpdateItemId !contains 'feedback'
| extend ProductId=coalesce(ProductId,LastProductId)
| extend TopicId=coalesce(SupportTopicId_PartB,LastL3TopicId,LastL2TopicId)
| summarize hint.shufflekey=WorkflowId ImputtedTimeOnBladeInSeconds = (max(EventTimestamp)-min(EventTimestamp))/1s,IsClicked=max(IsClicked), ProductId=max(ProductId), TopicId=max(TopicId) by WorkflowId,StepNumber
| project TimeOnBladeInSeconds=ImputtedTimeOnBladeInSeconds
         ,IsHelpEngaged=IsClicked
         ,InitialProductId=ProductId
         ,InitialLeafTopicId=TopicId
         ,WorkflowId
| where isnotempty(InitialLeafTopicId) and InitialLeafTopicId != 'issuenotlisted' and InitialLeafTopicId != 'QUOTA'
;
let Annotations = Thresholds
                  | join kind=leftouter (times) on InitialProductId | project-away InitialProductId1
                  | extend  IsHelpDwelled = DwellThreshold < TimeOnBladeInSeconds
                  | summarize (TimeOnBladeInSeconds,IsHelpDwelled)=arg_max(TimeOnBladeInSeconds,IsHelpDwelled) by WorkflowId
;
T 
| join hint.shufflekey=WorkflowId kind=leftouter (Annotations) on WorkflowId 
| project-away WorkflowId1
}

// List of functions in Accia.LeftShift.KO collection

.create-or-alter function with (folder = "LeftShift/CaseSubmissionFlow/KO", docstring = "", skipvalidation = "true") KO_GetCSFData(ParamScanStart:datetime, ParamScanEnd:datetime) {   
// 
// let ParamScanStart= datetime(2022-02-01 00:00:00.0000000);
// let ParamScanEnd = datetime(2022-02-08 00:00:00.0000000);
let suffix='Presented'
;
let fulllistofsols = (database("CXP_CSF").Get_CSF_Annotated() 
                               | extend PresentedSolutionTypes= coalesce(PresentedSolutionTypes,'["NoSolution"]')
                               | project PresentedSolutionTypes=parse_json(PresentedSolutionTypes) 
                               |summarize f= make_set(PresentedSolutionTypes) )
;
//Gets only the leaf nodes of the currently active tree as well as the ProductId node
let tree = database("CXP_CSF").ActiveTopicTree() 
           | where IsActiveLeaf or isempty( LeafTopicId)
           | project LeafTopicId = coalesce(LeafTopicId,ProductId)
                    ,LeafTopicSapId=coalesce(LeafTopicSapId,SapProductId)
                    ,ProductId
                    ,ProductName
                    ,PathName
                    ,SapProductId
;
let CSF=
database("CXP_CSF").Get_CSF_Annotated()
| where StartDate >= ParamScanStart and StartDate<ParamScanEnd
| where IsEligible and not(IsError) and not(IsTestSub)
| extend PresentedSolutionTypes= coalesce(PresentedSolutionTypes,'["NoSolution"]')
| project PresentedSolutionTypes=parse_json(PresentedSolutionTypes)
         ,WorkflowId, SessionId,SupportRequestNumber, IsSRCreated,IsHelpPresented
         ,IsHelpClicked= IsHelpEngaged
         ,InitialLeafTopicId=LastSelectedTreeId
         ,InitialProductId=LastProductId
         ,IsRecoTaken, IsRecoPresented, IsTetrisReroute
         ,IsQuickFixPresented
         ,IsQuickFixEngaged=coalesce(IsQuickFixEngaged,false)
         ,StartWorkflowTimestamp
         ,IsChatPresentedSolutions
         ,IsChatStartedSolutions
         ,IsConfirmedNoSupportPlan
         ,SubscriptionId
         ,TetrisInitialProductSapId
         ,TetrisInitialSupportTopicSapId
         ,IsMPAC
         ,IsPAC
| as a 
// handle PresentedSolutionTypes
| extend full_list = toscalar(fulllistofsols)
| mv-expand SolutionType=full_list to typeof(string)
| extend HasSpecifiedType= PresentedSolutionTypes contains SolutionType
| extend SolutionTypeColName = strcat('Is',SolutionType,suffix)
| evaluate pivot(SolutionTypeColName,max(HasSpecifiedType),WorkflowId)
| join  kind=inner (a) on WorkflowId |  project-away WorkflowId1,PresentedSolutionTypes
;
tree
| project InitialLeafTopicId=LeafTopicId
                                 ,InitialProductId=ProductId
                                 ,InitialProductName=ProductName
                                 ,InitialPathName = strcat('Azure/',PathName)
// fix up tree info based on Tetris
// we want Initial values to be whatever customer selected in basic tab
| join kind =rightouter (
                    union   (CSF | where not(IsTetrisReroute)), 
                            (CSF | where (IsTetrisReroute)
                            //reset initial topic/product id's in the case of Tetris Reroute
                            | join kind=leftouter (tree| project LeafTopicId,LeafTopicSapId,ProductId) on $left.TetrisInitialSupportTopicSapId==$right.LeafTopicSapId
                            // if above joins, then this is TetrisedFlow  
                            | extend InitialProductId = coalesce(ProductId,InitialProductId)
                            | extend InitialLeafTopicId = coalesce(LeafTopicId,InitialLeafTopicId)
                            | project-away LeafTopicId,LeafTopicSapId,ProductId)
                    ) on InitialLeafTopicId, InitialProductId  | project-away TetrisInitialProductSapId,TetrisInitialSupportTopicSapId
| extend IsInitialPathFoundInTree = isnotempty(InitialLeafTopicId)
| extend InitialLeafTopicId=coalesce(InitialLeafTopicId,InitialLeafTopicId1)
| extend InitialProductId=coalesce(InitialProductId,InitialProductId1)
| extend InitialPathName=coalesce(InitialPathName,'[NOT FOUND]')
| join kind=leftouter (tree | distinct ProductId,ProductName) on $left.InitialProductId==$right.ProductId
| extend InitialProductName=coalesce(InitialProductName,ProductName,'[NOT FOUND]')
// add IsHelpDwelled
| invoke Invoker_AddDwellAnnotation(ParamScanStart,ParamScanEnd)
| project-away InitialLeafTopicId1,InitialProductId1
| project-away ProductId,ProductName
//override IsHelpEngaged
| extend IsHelpEngaged = IsHelpClicked or IsHelpDwelled
// add KO annotation
| extend ParamScanStart=ParamScanStart,ParamScanEnd=ParamScanEnd
| extend KO_ProcessedTime = now()
}

.create-or-alter function with (folder = "LeftShift/CaseSubmissionFlow/KO", docstring = "", skipvalidation = "true") KO_GetDwellThresholds(ParamScanStart:datetime=datetime(null), ParamScanEnd:datetime=datetime(null)) {
// SAMPLE USAGE : KO_GetDwellThresholds()
//  KO Job      : https://kustoorchestrator.azcompute.com/Manage/Details?cluster=Accia&database=LeftShift&actorId=Publish%20Dwell%20ThresholdsV2
//  KO func     : KO_GetDwellThresholds()
//  Output table: DwellThresholds
//  Wrapper func: GetDwellThresholds()
//
//let ParamScanStart=datetime(null);let ParamScanEnd = datetime(null);
let ScanEnd = coalesce(ParamScanEnd,now());
//calculate based on the Quarter ended on ScanEnd 
let times=GetSelfHelpTimesAndClicks(ScanEnd-(13*7)*1d, ScanEnd)
;
// this is per product dwelltime threshold
// how it works:  it assumes the 2 distributions of HE == true/false follows LogNormal. AND assumes the false distribution is less than the true distribution
// it converts both to normal distribution, then finds the mode of each distribution
// it filters out the left side of the false dist and the right side of the true
// then it finds the bin value where the 2 distributions are closest together
let list = times
// convert to normale
| extend Log10Time=toint(10*round(log10(TimeOnBladeInSeconds+1),1))
| project Log10Time, IsHelpEngaged,InitialProductId
;
let Totals = list | summarize TotalCounts=count() by IsHelpEngaged,InitialProductId
;
//find the range for the bins
let minL=toscalar(list | summarize min(Log10Time))
;
let maxL=toscalar(list | summarize max(Log10Time))
;
let TotalsbyLog10 = list 
// get frequencies across the bins
| make-series XCounts=count() default=0 on Log10Time from minL to maxL step 1 by IsHelpEngaged,InitialProductId
| mv-expand Log10Time to typeof(long), XCounts to typeof(long)
| join kind=inner (Totals) on IsHelpEngaged,InitialProductId | project-away IsHelpEngaged1,InitialProductId1
// convert frequencies to PDF
| extend pdf=1.0*XCounts/TotalCounts
;
// find the modes
let MaxValues=TotalsbyLog10  | summarize (Max_pdf, Max_Log10Time)=arg_max(pdf, Log10Time) by IsHelpEngaged,InitialProductId
| join kind=inner (TotalsbyLog10) on IsHelpEngaged,InitialProductId | project-away IsHelpEngaged1,InitialProductId1
;
// find the bin where the values are closest together in each distribution
MaxValues
| where IsHelpEngaged and Log10Time < Max_Log10Time
| project-rename HE_pdf=pdf
| join kind=inner (MaxValues
                    | where not(IsHelpEngaged) and Log10Time > Max_Log10Time
                    | project-rename NHE_pdf=pdf) on Log10Time,InitialProductId | project-away Log10Time1,InitialProductId1
| where XCounts +XCounts1>0
| extend delta = abs(HE_pdf-NHE_pdf)
| summarize (delta,Log10Time)=arg_min(delta,1.0*Log10Time/10) by InitialProductId
//Get SapId
| lookup kind=inner(database('CXP_CSF').ActiveTopicTree()|distinct InitialProductId=ProductId, SapProductId)on InitialProductId
| project InitialProductId,SapProductId, DwellThreshold = pow(10,Log10Time)-1
| extend ParamScanEnd=ParamScanEnd
| extend KO_ProcessedTime = now()
}

.create-or-alter function with (folder = "LeftShift/CaseSubmissionFlow", docstring = "", skipvalidation = "true") GetCSFData(ParamScanStart:datetime=datetime(2018-08-08T00:00:00.0000000Z), ParamScanEnd:datetime=datetime(2099-09-09T00:00:00.0000000Z)) {
let start=ParamScanStart;
let end = ParamScanEnd;
database("CARETProd").ActiveTopicTree 
| where IsActiveLeaf //and not(IsProductFamilyModel)
| distinct  LeafTopicId, ProductId, SupportTopicL2Id, SupportTopicL2Name,SupportTopicL3Id,SupportTopicL3Name
| join kind=rightouter (database('LeftShift')._CSFData) on $right.InitialProductId  ==$left.ProductId
                                    ,$right.InitialLeafTopicId==$left.LeafTopicId
| where StartWorkflowTimestamp >=start and StartWorkflowTimestamp <= end
| project-away KO_ProcessedTime,ParamScanEnd,ParamScanStart,ProductId,LeafTopicId
| project-rename InitialL2TopicId=SupportTopicL2Id,InitialL2TopicName=SupportTopicL2Name
                ,InitialL3TopicId=SupportTopicL3Id,InitialL3TopicName=SupportTopicL3Name
|extend ["IsAzureCore"]=(InitialProductId in (("13185"),("14749"),("15207"),("15400"),("15438"),("15480"),("15526"),("15528"),("15571"),("15607"),("15614"),("15629"),("15739"),("15797"),("15804"),("15842"),("15879"),("15922"),("16035"),("16050"),("16051"),("16080"),("16094"),("16098"),("16146"),("16147"),("16160"),("16213"),("16215"),("16304"),("16326"),("16348"),("16355"),("16370"),("16450"),("16454"),("16455"),("16456"),("16459"),("16460"),("16461"),("16462"),("16469"),("16470"),("16478"),("16505"),("16530"),("16531"),("16556"),("16572"),("16598"),("16600"),("16611"),("16651"),("16679"),("16716"),("16734"),("16757"),("16761"),("16802"),("16838"),("16843"),("16872"),("16913"),("16922"),("16932"),("16975"),("16987"),("17042"),("17043"),("17082"),("17112"),("17287"),("17315"),("17319"),("17321"),("17353"),("17362"),("17387"),("17436"),("17501"),("17533"),("17535"),("17782"),("17817"),("17898"),("17917")))
}

.create-or-alter function with (folder = "LeftShift/CaseSubmissionFlow", docstring = "", skipvalidation = "true") GetDwellThresholds() {
    DwellThresholds
    | where KO_ProcessedTime == toscalar(DwellThresholds|summarize max(KO_ProcessedTime))
