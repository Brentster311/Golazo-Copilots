        )
}

.create-or-alter function with (folder = "BonsaiV2", docstring = "", skipvalidation = "true") Get_SolutionAnnotated(ParamScanStart:datetime=datetime(2023-1-1), ParamScanEnd:datetime=datetime(2099-9-9), ParamClient:string="CSF", ParamPivotBySession:bool=False, ParamSampleWorkflowId:string="", ParamSampleSessionId:string="") {
    // NOTES:
    //      PrimaryKey : SesionId + WorkflowId + SolutionId
    //                Or SessionId + SolutionId if ParamPivotBySession==True
    //      SolutionId        : The unique id for solution. Could be free-format; but mostly guid-format for newer ones authored via Elixir.
    //      Solution          : Help experience presented to User. with UniqueId. Could be Apollo or some non-Apollo scenario (PENDING MORE DATA CLEANSING)
    //      SolutionComponent : Video/AKB etc within Apollo
    //      SolutionLink      : External/Blade Link etc, ApolloSolution could have link; SolutionComponent such as Diag could also have link
    // 
    // SAMPLE USAGE
    //      database("LeftShift").Get_SolutionAnnotated(ago(91d),now(),'CSF')|summarize count(),take_any(*) by IsApolloSolutionId, WorkflowType_set, StepType_set,SolutionType_set, SolutionComponentType_set
    //      database("LeftShift").Get_SolutionAnnotated(ago(10d),ago(9d),'CSF')|where IsApolloSolutionId
    //      database("LeftShift").Get_SolutionAnnotated(ago(10d),ago(9d),'H20')|where IsApolloSolutionId
    //      database("LeftShift").Get_SolutionAnnotated(ago(30d),ago(9d),'', ParamSampleWorkflowId='395ed30e-3182-433d-bf95-46ab297ce6e2')
    //
    //let ParamSampleWorkflowId='395ed30e-3182-433d-bf95-46ab297ce6e2';let ParamSampleSessionId='';let ParamClient = '';let ParamPivotBySession = False; let ParamScanStart = datetime(2023-1-1); let ParamScanEnd=ParamScanStart+180d;
    //let ParamSampleWorkflowId='';let ParamSampleSessionId='';let ParamClient = 'CSF';let ParamPivotBySession = False; let ParamScanStart = ago(10d); let ParamScanEnd=ParamScanStart+10m;
    let Product_List = 
        database('CXP_CSF').ActiveTopicTree
        |extend IssueType=case(ProductId ==15621,'Quota',ProductId in(15659,15660),'ASMS','Tech')
        |distinct IssueType, SapProductId, ProductId
        ;
    database("CXP_CSF").Get_PortExtTel_Cooked(ParamScanStart, ParamScanEnd)
    | project SessionId
             ,WorkflowId
             ,PreciseTimeStamp
             ,WorkflowType,StepType
             ,StepNumber,StepUpdateNumber
             ,UpdateItemId,UpdateItemAction,UpdateItemValue
             ,SolutionType
             ,SolutionId
             ,ApolloComponentId=PartC_ApolloComponentId // PENDING RENAME IN PIPELINE
             ,SolutionStatus
             ,SolutionArticleId,SolutionArticleUrl,SolutionArticleTitle // optional/legacy telemetry
             ,TimeOnBladeInSeconds = coalesce(toreal(TimeOnBladeInSeconds),0.0)
             ,IsLikelyAlchemy = isnotempty(PartC_BucketId)//BAM's defn on 4/21/2023
             ,SapProductId = coalesce(ProductSAPId,PartC_productId_1, ProductId,PartC_ProductId)
             ,LastProductId_CSFAnnotated=LastProductId
    | where isempty(ParamSampleWorkflowId) or ParamSampleWorkflowId==WorkflowId 
    | where isempty(ParamSampleSessionId) or ParamSampleSessionId==SessionId
    | extend IsHelpPresented = 
                (isnotempty(SolutionId) and (SolutionType !='Diagnostic' or  SolutionStatus =='Ready'))// Remove unready Diag Insights. long run or fail, which will NOT presented to cx
                or isnotempty( TimeOnBladeInSeconds)  // Kind of hacky, just to get the dwell time
    | where IsHelpPresented
    | extend IsCSF = WorkflowType == 'Case Submission V2' and StepType == 'SelfHelp'
            ,IsH20 = WorkflowType in('Help Experience Workflow','Help Pane Workflow')
            ,IsTSG = WorkflowType == 'TroubleshootV3'
    | where isempty(ParamClient) 
            or (ParamClient contains 'CSF' and IsCSF) 
            or (ParamClient contains 'H20' and IsH20)
            or (ParamClient contains 'TSG' and IsTSG)
    // Convert PESId to SAPId if needed & get IssueType
    | lookup kind=leftouter (Product_List|project ProductId, SapProductId)on $left.SapProductId==$right.ProductId
    | extend SapProductId = coalesce(SapProductId1,SapProductId)
    | lookup kind=leftouter (Product_List|project SapProductId, IssueType)on SapProductId
    | extend SolutionComponentId = case (
            // GOAL: apollo-id 
            //       unique-id for static+dynamic content 
            //       ignore irrelevant part 
            // *********** WORKING IN PROGRESS *****************//
            // Unique Apollo Id, refer to the whole canvus, 1:1 mapping to some backend github MD file
            SolutionType == 'Apollo' and UpdateItemAction == 'presented'        , strcat(SolutionType, '[The UniqueId].', SolutionId, '.', SolutionArticleId)
            //
            // Links are NOT in same granularity of Solutionm should be filter out from Solution analysis.
            // Observed 2 forms, link show in Url or UpdateItemValue
           ,SolutionType == 'Apollo' and isnotempty(SolutionArticleUrl)         , strcat(SolutionType, '_SomeStatickLink.', SolutionId, '.', SolutionArticleUrl) 
           ,SolutionType == 'Apollo'                                            , strcat(SolutionType,'_', split(UpdateItemId,'/')[-1], '.', SolutionId, '.', UpdateItemValue)
           //
           // "Component" refer to Akb, Video, Metric etc
           // AKB: Could also be compoonent, or standalone as fall back mechanism
           // AKB: Ignore component-id for Akb, which seems always 1:1 mapping with SolutionId
           ,isnotempty(ApolloComponentId) and SolutionType == 'AzureKb'         , strcat('Apollo_', SolutionType, '.', SolutionId, '.', SolutionArticleUrl)
           ,isnotempty(ApolloComponentId) and SolutionType == 'Diagnostic'      , strcat('Apollo_', SolutionType,'.', SolutionId, '.', SolutionArticleUrl)
           ,isnotempty(ApolloComponentId)                                       , strcat('Apollo_', SolutionType, '.', SolutionId, '.',ApolloComponentId, '.', SolutionArticleUrl)
           //
           // Apollo has no knowledge to WebApp yet
           ,SolutionType == 'WebAppsTroubleshooter'                             , SolutionType
           //
           // GT could be in part of Apollo, or standalone(legacy)
           ,SolutionType == 'GuidedTroubleshooter' and isnotempty(SolutionId)   , strcat('Apollo_', SolutionType, '.', SolutionId)
           ,SolutionType == 'GuidedTroubleshooter' and isempty(SolutionId)      , strcat(SolutionType, '.', SolutionId)
           // Default
                                                                                , strcat(SolutionType, '.', SolutionId, '.', SolutionArticleId )
           )
    | extend SolutionComponentType = tostring(split(SolutionComponentId,'.')[0])
    | project-reorder SolutionComponentType,SolutionComponentId, Solution*,*Solution*,WorkflowId,Workflow*
    | extend WorkflowId = iif(ParamPivotBySession, toguid(''),toguid(WorkflowId))
    | summarize hint.strategy=shuffle 
                ApolloSolutionId            = maxif(SolutionId, SolutionType =='Apollo')
               ,SolutionId_set              = make_set(todynamic(SolutionId))
                // PENDING : adding Dwell; remove non-cx-action , e.g. voting-button
               ,IsClicked                   = max(UpdateItemAction=='clicked' and isnotempty(SolutionType) and isnotempty(SolutionId))
               ,TimeOnBladeInSeconds        = sum(TimeOnBladeInSeconds)
               ,IsLikelyAlchemy             = max(IsLikelyAlchemy)
                //
               ,SolutionComponentType_set   = make_set(todynamic(SolutionComponentType))
               ,SolutionComponent_set       = make_set_if(todynamic(SolutionComponentId),SolutionComponentType !contains 'Link')
               ,LastProductId_CSFAnnotated  = make_set(todynamic(LastProductId_CSFAnnotated))
               ,IssueType_set               = make_set(todynamic(IssueType))
               ,SapProductId_set            = make_set(todynamic(SapProductId))
               ,SolutionLink_set            = make_set_if(todynamic(SolutionComponentId),SolutionComponentType contains 'Link')
               ,WorkflowType_set            = make_set(todynamic(WorkflowType))
               ,StepType_set                = make_set(todynamic(StepType))
               ,SolutionType_set            = make_set(todynamic(SolutionType))
               //SolutionArticleId is obsolete telemetry, adding as metadata of SolutionId for readability
               ,ApolloSolutionArticleId     = maxif(SolutionArticleId, SolutionType =='Apollo')
               ,ApolloSolutionArticleId_MaxTimeStamp = maxif(PreciseTimeStamp, SolutionType =='Apollo')
                by  SessionId, WorkflowId, StepNumber
               |project-reorder ApolloSolutionId,SolutionId_set, StepNumber,TimeOnBladeInSeconds
    | where array_length(SolutionId_set)>0  // Keep empty SolutionId row to calc dwell, then remove those for non-Solution blade
    | extend IsApolloSolutionId = isnotempty(ApolloSolutionId)
    | extend SolutionId = coalesce(
                ApolloSolutionId                                   // Apollo supposed to have single guid for SolutionId
               ,strcat_array(array_sort_asc(SolutionId_set),',')   // A lot of more to do for non-Apollo, DEPRIORITIZE!
               )
    | summarize hint.strategy=shuffle 
                IsClicked                   = max(IsClicked )
               ,TimeOnBladeInSeconds        = sum(TimeOnBladeInSeconds)
               ,BladeCount                  = count()
               ,IsLikelyAlchemy             = max(IsLikelyAlchemy)
               ,SolutionComponent_set       = array_sort_asc(make_set(SolutionComponent_set))
               ,SolutionLink_set            = array_sort_asc(make_set(SolutionLink_set))
               ,IssueType_set               = strcat_array(array_sort_asc(make_set(IssueType_set)),',')
               ,LastProductId_CSFAnnotated  = strcat_array(array_sort_asc(make_set(LastProductId_CSFAnnotated)),',')
               ,SapProductId_set            = strcat_array(array_sort_asc(make_set(SapProductId_set)),',')
               ,WorkflowType_set            = strcat_array(array_sort_asc(make_set(WorkflowType_set)),',')
               ,StepType_set                = strcat_array(array_sort_asc(make_set(StepType_set)),',')
               ,SolutionType_set            = strcat_array(array_sort_asc(make_set(SolutionType_set)),',')
               ,SolutionComponentType_set   = strcat_array(array_sort_asc(make_set(SolutionComponentType_set)),',')
               ,arg_max(ApolloSolutionArticleId_MaxTimeStamp,ApolloSolutionArticleId)
                by  SessionId, WorkflowId, IsApolloSolutionId, SolutionId
    | extend SolutionId_with_ArticleId=iif(isnotempty(ApolloSolutionArticleId), strcat(SolutionId, ' : ',ApolloSolutionArticleId),SolutionId)
    | project-reorder SessionId,WorkflowId,IsApolloSolutionId,SolutionId,SolutionId_with_ArticleId,IssueType_set
}

// List of functions in Accia.LeftShift.CapacityInventory collection

.create-or-alter function with (folder = "CapacityInventory", docstring = "", skipvalidation = "true") Get_CapacityInventory(ParamIncludeBug:bool=False, ParamSourceTable:string="_CapacityInventory") {
    //SAMPLE USAGE
    //  _CapacityInventory|summarize count() by RunId, BackingStore, Confidence
    //
    //  database('LeftShift').Get_CapacityInventory()|count
    //  database('LeftShift').Get_CapacityInventory()|summarize count() by BackingStore
    //  database('LeftShift').Get_CapacityInventory()|evaluate pivot(Confidence, count() , BackingStore)
    //  
    //  database('LeftShift').Get_CapacityInventory(ParamIncludeBug = True)|where IsBug
    //
    //  Get_CapacityInventory(ParamIncludeBug=False, ParamSourceTable='_CapacityInventory_20260225_095217') // previous stable version
    //
    table(ParamSourceTable)
    |summarize 
        arg_max(Timestamp,*)
       ,All_DiscoveredIn = strcat_array(make_set(DiscoveredIn), ',')
       ,(Max_CapacityRelevance, Max_CapacityCategories)=arg_max(CapacityRelevance, CapacityCategories)
       by Id
    |project-away CapacityRelevance, CapacityCategories, DiscoveredIn
    |project-rename CapacityRelevance=Max_CapacityRelevance, CapacityCategories=Max_CapacityCategories
    |extend IsBug=
            (BackingStore =='SQL' and DataSourceName contains "# MAGIC")
            or (isempty( Server))
            or (isempty(Object))
            or (BackingStore == "Kusto" and Server contains "{")
            or (BackingStore == "SQL" and Server contains "@@SERVERNAME")
            or UpstreamSources =='cluster'
            or Server in (
                'https://azsupport.kusto.windows.net',
                'https://azcore.kusto.windows.net',
                'https://caretprodpme.kusto.windows.net',
                'https://argwusarrone.kusto.windows.net',
                'https://supportmlprodweu.kusto.windows.net',
                'https://intmgmtshared.kusto.windows.net',
                'https://azurehpcplatform.kusto.windows.net',
                'https://azureallocator.kusto.windows.net',
                'https://....kusto.windows.net',
                'https://__lightdetectcentraluskustoclusterurl__.kusto.windows.net',
                'https://x.kusto.windows.net',
                'https://mycluster.kusto.windows.net',
                'https://cluster1.kusto.windows.net',
                'https://cluster2.kusto.windows.net'
            )
    |where ParamIncludeBug or not(IsBug)
    |project-reorder BackingStore, DataSourceName, Server, Scope, Object, CapacityCategories, CapacityRelevance
    //BC till Portal redeploy
    |extend Confidence=CapacityRelevance
}

.create-or-alter function with (folder = "CapacityInventory", docstring = "", skipvalidation = "true") Get_CapacityInventory_DependencyTracker(ParamCapacityRelevance:string="High", ParamCriticality:string="Critical,High", ParamExistInInventory:bool=True, ParamIncludeBug:bool=False, ParamConsumerLimit:int=10, ParamSourceTable:string="_CapacityInventory") {
    //SAMPLE USAGE
    //  Get_CapacityInventory_DependencyTracker()
    //  Get_CapacityInventory_DependencyTracker(ParamCriticality='Critical,High,Medium,Low')  -- all levels
    //  Get_CapacityInventory_DependencyTracker(ParamCriticality='')  -- all levels
    //  Get_CapacityInventory_DependencyTracker(ParamConsumerLimit=20)  -- more consumers
    //
    // OUTPUT COLUMNS:
    //   UpstreamSource - the data source being referenced
    //   ReferenceCount - how many objects reference this source
    //   DependencyCriticality - Critical/High/Medium/Low based on impact
    //   Consumers - list of objects that depend on this source (limited to ParamConsumerLimit)
    //   ExistInInventory - whether we have this source cataloged
    //
    // let ParamCapacityRelevance='High';let ParamCriticality='Critical,High';let ParamExistInInventory=True;let ParamIncludeBug=False;let ParamConsumerLimit=10;let ParamSourceTable='_CapacityInventory';
    database('LeftShift').Get_CapacityInventory(ParamIncludeBug, ParamSourceTable) 
    |where isempty(ParamCapacityRelevance) or CapacityRelevance == ParamCapacityRelevance
    |where isnotempty( UpstreamSources)
    |project DataSourceName, UpstreamSource= split(UpstreamSources,';')
    |mv-expand UpstreamSource to typeof(string )
    |summarize ReferenceCount=count(), Consumers=make_set(DataSourceName, coalesce(ParamConsumerLimit,10)) by UpstreamSource
    |as a 
    // DependencyCriticality: quantile-based ranking
    |extend k=1 |join kind = inner (a | summarize (P_99,P_95,P_80)=percentiles(ReferenceCount, 99,95,80)by k=1)on k|project-away k,k1
    |extend DependencyCriticality = case(
        ReferenceCount >= P_99, "Critical",  // top 1%
        ReferenceCount >= P_95, "High",      // top 5%
        ReferenceCount >= P_80, "Medium",    // top 20%
        "Low"
    )
    |where isempty(ParamCriticality) or DependencyCriticality in (split(ParamCriticality, ','))
    //
    |extend UpstreamSource_lower=tolower(UpstreamSource)
    |lookup (Get_CapacityInventory() |project DataSourceName_lower=tolower(DataSourceName),ExistInInventory=True) on $left.UpstreamSource_lower==$right.DataSourceName_lower
    |extend ExistInInventory = coalesce(ExistInInventory, False)
    |project-away *lower, P_*
    |order by ReferenceCount desc
    |project-reorder UpstreamSource
}

// List of functions in Accia.LeftShift.Cook collection

// List of functions in Accia.LeftShift.Invokers collection

.create-or-alter function with (folder = "Cook/Invokers", docstring = "Extract fields from LogMessage", skipvalidation = "true") Invoker_ExtractIngressLogFieldsV2(T:(LogMessage:string), ParamInvoker:string="Invoker_ExtractIngressLogFields") {
    // SAMPLE USAGE:
    // 		print LogMessage= '1.2.3.4'|invoke Invoker_ExtractIngressLogFields(ParamInvoker='Invoker_ExtractIngressLogFields') // returns client_ip
    // 		print LogMessage= '1.2.3.4'|invoke Invoker_ExtractIngressLogFields(ParamInvoker='') // returns empty for all generated col
	//
    // Invoker design:
    //      client (1) create invoker-func for parser logic 
    //             (2) implement when to call the invoker in client side 
    //             (3) pass invoker-func-name as "ParamInvoker" when calling wrapper Get_ContainerLogsV2()
    //      wrapper pass ParamInvoker to invoker func
    //      invoker func uses ParamInvoker to decide (1) trigger parser , or (2) do nothing
    //
/////////////////////////////////////////////////////////////////////////////
/// FOR TESTING
//     datatable(LogMessage: string)
// [
//     "{\"remote_addr\":\"$remote_addr\",\"remote_user\":\"$remote_user\",\"time_local\":\"$time_local\",\"request\":\"$request\",\"status\":\"$status\",\"body_bytes_sent\":\"$body_bytes_sent\",\"http_referer\":\"$http_referer\",\"http_user_agent\":\"$http_user_agent\",\"request_length\":\"$request_length\",\"request_time\":\"$request_time\",\"proxy_upstream_name\":\"$proxy_upstream_name\",\"proxy_alternative_upstream_name\":\"$proxy_alternative_upstream_name\",\"upstream_addr\":\"$upstream_addr\",\"upstream_response_length\":\"$upstream_response_length\",\"upstream_response_time\":\"$upstream_response_time\",\"upstream_status\":\"$upstream_status\",\"req_id\":\"$req_id\",\"http_x_forwarded_for\":\"$http_x_forwarded_for\",\"http_x_ms_client_ip_address\":\"$http_x_ms_client_ip_address\",\"http_x_ms_correlation_request_id\":\"$http_x_ms_correlation_request_id\"}"
// ]
////////////////////////////////////////////////////////////////////////////
    T
    |where ParamInvoker == 'Invoker_ExtractIngressLogFields'
    | extend JsonData = parse_json(LogMessage)
    | extend
             remote_addr = JsonData.remote_addr,
             remote_user = JsonData.remote_user,
             // could potentially be swapped with remote_addr, again we will need to wait to see exact data format
             client_ip = JsonData.http_x_ms_client_ip_address,
             timestamp = JsonData.time_local,
             request = JsonData.request,
             status = JsonData.status,
             bytes_sent = JsonData.body_bytes_sent,
             request_length = JsonData.request_length,
             referer = JsonData.http_referer,
             user_agent = JsonData.http_user_agent,
             request_time = JsonData.request_time,
             upstream_addr = JsonData.upstream_addr,
             upstream_response_length = JsonData.upstream_response_length,
             upstream_response_time = JsonData.upstream_response_time,
             upstream_status = JsonData.upstream_status,
             request_id = JsonData.req_id,
             http_x_forwarded_for = JsonData.http_x_forwarded_for,
             http_x_ms_correlation_request_id = JsonData.http_x_ms_correlation_request_id,
             http_referer = JsonData.http_referer,
             http_user_agent = JsonData.http_user_agent,
             proxy_upstream_name = JsonData.proxy_upstream_name,
             proxy_alternative_upstream_name = JsonData.proxy_alternative_upstream_name
     | extend              
            // protocol and method should be part of the request, to be seen how exactly the format would look like
         protocol = extract("HTTP/(\\S+)", 1, tostring(request)),
         method = extract("\"(\\S+)", 1, tostring(request))
    // Keep raw data when invoker is turned off
    | union kind = fullouter (T | where ParamInvoker != 'Invoker_ExtractIngressLogFields')
}

// List of functions in Accia.LeftShift.IPW collection

// List of functions in Accia.LeftShift.Invokers collection

// List of functions in Accia.LeftShift.Add collection

.create-or-alter function with (folder = "IPW/Invokers/Add", docstring = "", skipvalidation = "true") Invoker_Add_AutoSuggestFlightMetadata(T:(SessionId:string)) {
    // SAMPLE USAGE:
    //      cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()|where StartDate >ago(2d)|where IsEligible and IsPAC|project SessionId, LastProductId, IsSRCreated| invoke Invoker_Add_AutoSuggestFlightMetadata()
    //
    //let T= cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()|where StartDate >ago(3d)|where IsEligible and IsPAC|project SessionId, LastProductId, IsSRCreated;
    T
    | join kind = leftouter hint.strategy=shuffle (
        cluster('azsupportfollower.westus2.kusto.windows.net').database('AzureSupportability').PortalExtTelemetry
        // Filter down for query perf. pending tuning
        | where SessionId  in ((T|project SessionId))
        // Using this as filter, due to lack of FlightName
        | where Data has "IssueSummaryComboBox" and Data has "autoSuggestAPIResponseJSON"
        | extend MessageJSON = parse_json(Data)
        | extend IsAutoSuggestFlight = True
                 // from : database("AutoSuggest_Dev").GetAutoSuggestPortalTelemetry()
                ,Is_AutoSuggest_Suggestion=MessageJSON['PartC']['isAutoSuggestRecommendation']
                ,AutoSuggest_TransactionId=toguid(MessageJSON['PartC']['autoSuggestTransactionId'])
                ,AutoSuggest_ResponseJSON=tostring(MessageJSON['PartC']['autoSuggestAPIResponseJSON'])
        ) on SessionId
        |extend IsAutoSuggestFlight = coalesce(IsAutoSuggestFlight, False)
}

.create-or-alter function with (folder = "IPW/Invokers", docstring = "", skipvalidation = "true") Invoker_Get_CF_Adhoc(T:(StartDate:datetime,BoolFeature1_Col:bool,PivotsCol:string), ScanWindowInDays:int=7) {
    // SAMPLE USAGE
    //      cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()| where StartDate >=ago(60d) and LastProductId==14749| where IsSRCreated| project StartDate, BoolFeature1_Col = IsRecoPresented,BoolFeature2_Col = IsRecoTaken, PivotsCol=tostring(bag_pack('LastProductId',LastProductId))| invoke Invoker_Get_CF_Adhoc(ScanWindowInDays=7)
    //
    //let ScanWindowInDays =7; let T = cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()| where StartDate >=ago(60d)| where IsSRCreated| project StartDate, BoolFeature1_Col = IsRecoPresented, BoolFeature2_Col = IsRecoTaken,PivotsCol=tostring(bag_pack("LastStepType",LastStepType,"LastProductId",LastProductId));
    //
    let ScanStartDate   = toscalar(T|summarize min(StartDate));
    let ScanEndDate     = toscalar(T|summarize max(StartDate));
    T
    | extend PivotsCol = column_ifexists('PivotsCol', '')
    | make-series 
            BoolFeature1_Total_Count    = countif(isnotempty( BoolFeature1_Col))
           ,BoolFeature1_True_Count     = countif(BoolFeature1_Col==True)
           ,BoolFeature1_False_Count    = countif(BoolFeature1_Col==False)
           ,BoolFeature1_Null_Count     = countif(isempty(BoolFeature1_Col))
            default=0 on StartDate from ScanStartDate to ScanEndDate step 1d
            by PivotsCol
    | extend 
             BoolFeature1_Total_Count   = array_sum(BoolFeature1_Total_Count)
            ,BoolFeature1_True_Count    = array_sum(BoolFeature1_True_Count)
            ,BoolFeature1_False_Count   = array_sum(BoolFeature1_False_Count)
            ,BoolFeature1_Null_Count    = array_sum(BoolFeature1_Null_Count)
            //
            ,BoolFeature1_Total_MA      = series_fir(series = BoolFeature1_Total_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature1_True_MA       = series_fir(series = BoolFeature1_True_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature1_False_MA      = series_fir(series = BoolFeature1_False_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature1_Null_MA       = series_fir(series = BoolFeature1_Null_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
    | extend 
             BoolFeature1_Total_MA      = array_slice(BoolFeature1_Total_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature1_True_MA       = array_slice(BoolFeature1_True_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature1_False_MA      = array_slice(BoolFeature1_False_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature1_Null_MA       = array_slice(BoolFeature1_False_MA,ScanWindowInDays, -ScanWindowInDays)
    | mv-expand 
            StartDate               to typeof(datetime)
           ,BoolFeature1_Total_MA   to typeof(real)
           ,BoolFeature1_True_MA    to typeof(real)
           ,BoolFeature1_False_MA   to typeof(real)
           ,BoolFeature1_Null_MA    to typeof(real)
    |extend PivotsCol = parse_json(PivotsCol)
    |evaluate bag_unpack(PivotsCol)
    | project-away *_Count
}

.create-or-alter function with (folder = "IPW/Invokers", docstring = "Get Moving Avg for input data", skipvalidation = "true") Invoker_Get_MA(T:(StartDate:datetime,PivotsCol:string), ParamMovingWindowInDays:int=7, ParamMovingAvg:bool=False, ParamExpandSeries:bool=True) {
    // SAMPLE USAGE
    //      cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()| where StartDate >=ago(60d)| where IsSRCreated| project StartDate,PivotsCol=tostring(bag_pack('LastProductId',LastProductId))| invoke Invoker_Get_MA(ParamMovingWindowInDays=7)
    //
    //let ParamMovingWindowInDays =7; let ParamMovingAvg=False;let ParamExpandSeries = False; let T = cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()| where StartDate >=datetime(2023-1-1)| where IsSRCreated and IsEligible and IsPAC  and not(IsTestSub) and LastProductId !=15621 | project StartDate, PivotsCol='IssueType';
    let ScanStartDate   = toscalar(T|summarize min(StartDate));
    let ScanEndDate     = toscalar(T|summarize max(StartDate));
    T
    | make-series 
            TotalCount   = count()
            default      = 0 on StartDate from ScanStartDate to ScanEndDate step 1d
            by PivotsCol = column_ifexists('PivotsCol', '')
    | extend 
            TotalCount      = array_sum(TotalCount)
           ,Total_MA_series = series_fir(series = TotalCount, filter=repeat(1,ParamMovingWindowInDays), normalize=ParamMovingAvg, center = false)
    //Shift MA to make StartDate the starting of moving window
    //Cut off last partial window
    | extend Total_MA_series= array_slice(Total_MA_series,ParamMovingWindowInDays-1,-ParamMovingWindowInDays)
            ,StartDate      = array_slice(StartDate,0,-ParamMovingWindowInDays)
    | project-rename StartDate_series = StartDate
    | as ma_raw
    | where ParamExpandSeries
    | mv-expand StartDate = StartDate_series to typeof(datetime)
               ,Total_MA  = Total_MA_series to typeof(real)
    | project-away *_series
    | union (ma_raw|where not(ParamExpandSeries))
    | extend PivotsCol = parse_json(PivotsCol)
    | evaluate bag_unpack(PivotsCol)
}

.create-or-alter function with (folder = "IPW/Invokers", docstring = "", skipvalidation = "true") Invoker_Get_Multi_MA(T:(StartDate:datetime,BoolFeature1_Col:bool,BoolFeature2_Col:bool,PivotsCol:string), ScanWindowInDays:int=7) {
    // SAMPLE USAGE
    //      cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()| where StartDate >=ago(60d) and LastProductId==14749| where IsSRCreated| project StartDate, BoolFeature1_Col = IsRecoPresented,BoolFeature2_Col = IsRecoTaken, PivotsCol=tostring(bag_pack('LastProductId',LastProductId))| invoke Invoker_Get_Multi_MA(ScanWindowInDays=7)
    //
    //let ScanWindowInDays =7; let T = cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()| where StartDate >=ago(60d)| where IsSRCreated| project StartDate, BoolFeature1_Col = IsRecoPresented, BoolFeature2_Col = IsRecoTaken,PivotsCol=tostring(bag_pack("LastStepType",LastStepType,"LastProductId",LastProductId));
    //
    let ScanStartDate   = toscalar(T|summarize min(StartDate));
    let ScanEndDate     = toscalar(T|summarize max(StartDate));
    T
    | extend PivotsCol = column_ifexists('PivotsCol', '')
    | extend BoolFeature3_Col = column_ifexists('BoolFeature3_Col', tobool(''))
            ,BoolFeature4_Col = column_ifexists('BoolFeature4_Col', tobool(''))
    | make-series 
            BoolFeature1_Total_Count    = countif(isnotempty( BoolFeature1_Col))
           ,BoolFeature1_True_Count     = countif(BoolFeature1_Col==True)
           ,BoolFeature1_False_Count    = countif(BoolFeature1_Col==False)
           ,BoolFeature1_Null_Count     = countif(isempty(BoolFeature1_Col))
           //
           ,BoolFeature2_Total_Count    = countif(isnotempty( BoolFeature2_Col))
           ,BoolFeature2_True_Count     = countif(BoolFeature2_Col==True)
           ,BoolFeature2_False_Count    = countif(BoolFeature2_Col==False)
           ,BoolFeature2_Null_Count     = countif(isempty(BoolFeature2_Col))
           //
           ,BoolFeature3_Total_Count    = countif(isnotempty( BoolFeature3_Col))
           ,BoolFeature3_True_Count     = countif(BoolFeature3_Col==True)
           ,BoolFeature3_False_Count    = countif(BoolFeature3_Col==False)
           ,BoolFeature3_Null_Count     = countif(isempty(BoolFeature3_Col))
           //
           ,BoolFeature4_Total_Count    = countif(isnotempty( BoolFeature4_Col))
           ,BoolFeature4_True_Count     = countif(BoolFeature4_Col==True)
           ,BoolFeature4_False_Count    = countif(BoolFeature4_Col==False)
           ,BoolFeature4_Null_Count     = countif(isempty(BoolFeature4_Col))
            default=0 on StartDate from ScanStartDate to ScanEndDate step 1d
            by PivotsCol
    | extend 
             BoolFeature1_Total_Count   = array_sum(BoolFeature1_Total_Count)
            ,BoolFeature1_True_Count    = array_sum(BoolFeature1_True_Count)
            ,BoolFeature1_False_Count   = array_sum(BoolFeature1_False_Count)
            ,BoolFeature1_Null_Count    = array_sum(BoolFeature1_Null_Count)
            ,BoolFeature1_Total_MA      = series_fir(series = BoolFeature1_Total_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature1_True_MA       = series_fir(series = BoolFeature1_True_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature1_False_MA      = series_fir(series = BoolFeature1_False_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature1_Null_MA       = series_fir(series = BoolFeature1_Null_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            //
            ,BoolFeature2_Total_Count   = array_sum(BoolFeature2_Total_Count)
            ,BoolFeature2_True_Count    = array_sum(BoolFeature2_True_Count)
            ,BoolFeature2_False_Count   = array_sum(BoolFeature2_False_Count)
            ,BoolFeature2_Null_Count    = array_sum(BoolFeature2_Null_Count)
            ,BoolFeature2_Total_MA      = series_fir(series = BoolFeature2_Total_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature2_True_MA       = series_fir(series = BoolFeature2_True_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature2_False_MA      = series_fir(series = BoolFeature2_False_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature2_Null_MA       = series_fir(series = BoolFeature2_Null_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            //
            ,BoolFeature3_Total_Count   = array_sum(BoolFeature3_Total_Count)
            ,BoolFeature3_True_Count    = array_sum(BoolFeature3_True_Count)
            ,BoolFeature3_False_Count   = array_sum(BoolFeature3_False_Count)
            ,BoolFeature3_Null_Count    = array_sum(BoolFeature3_Null_Count)
            ,BoolFeature3_Total_MA      = series_fir(series = BoolFeature3_Total_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature3_True_MA       = series_fir(series = BoolFeature3_True_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature3_False_MA      = series_fir(series = BoolFeature3_False_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature3_Null_MA       = series_fir(series = BoolFeature3_Null_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            //
            ,BoolFeature4_Total_Count   = array_sum(BoolFeature4_Total_Count)
            ,BoolFeature4_True_Count    = array_sum(BoolFeature4_True_Count)
            ,BoolFeature4_False_Count   = array_sum(BoolFeature4_False_Count)
            ,BoolFeature4_Null_Count    = array_sum(BoolFeature4_Null_Count)
            ,BoolFeature4_Total_MA      = series_fir(series = BoolFeature4_Total_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature4_True_MA       = series_fir(series = BoolFeature4_True_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature4_False_MA      = series_fir(series = BoolFeature4_False_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
            ,BoolFeature4_Null_MA       = series_fir(series = BoolFeature4_Null_Count,filter=repeat(1,ScanWindowInDays), normalize=true,center=false)
    | extend BoolFeature1_Total_MA      = array_slice(BoolFeature1_Total_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature1_True_MA       = array_slice(BoolFeature1_True_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature1_False_MA      = array_slice(BoolFeature1_False_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature1_Null_MA       = array_slice(BoolFeature1_False_MA,ScanWindowInDays, -ScanWindowInDays)
            //
            ,BoolFeature2_Total_MA      = array_slice(BoolFeature2_Total_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature2_True_MA       = array_slice(BoolFeature2_True_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature2_False_MA      = array_slice(BoolFeature2_False_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature2_Null_MA       = array_slice(BoolFeature2_Null_MA,ScanWindowInDays, -ScanWindowInDays)
            //
            ,BoolFeature3_Total_MA      = array_slice(BoolFeature3_Total_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature3_True_MA       = array_slice(BoolFeature3_True_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature3_False_MA      = array_slice(BoolFeature3_False_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature3_Null_MA       = array_slice(BoolFeature3_Null_MA,ScanWindowInDays, -ScanWindowInDays)
            //
            ,BoolFeature4_Total_MA      = array_slice(BoolFeature4_Total_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature4_True_MA       = array_slice(BoolFeature4_True_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature4_False_MA      = array_slice(BoolFeature4_False_MA,ScanWindowInDays, -ScanWindowInDays)
            ,BoolFeature4_Null_MA       = array_slice(BoolFeature4_Null_MA,ScanWindowInDays, -ScanWindowInDays)
    | mv-expand 
            StartDate               to typeof(datetime)
           ,BoolFeature1_Total_MA   to typeof(real)
           ,BoolFeature1_True_MA    to typeof(real)
           ,BoolFeature1_False_MA   to typeof(real)
           ,BoolFeature1_Null_MA    to typeof(real)
           //
           ,BoolFeature2_Total_MA   to typeof(real)
           ,BoolFeature2_True_MA    to typeof(real)
           ,BoolFeature2_False_MA   to typeof(real)
           ,BoolFeature2_Null_MA    to typeof(real)
           //
           ,BoolFeature3_Total_MA   to typeof(real)
           ,BoolFeature3_True_MA    to typeof(real)
           ,BoolFeature3_False_MA   to typeof(real)
           ,BoolFeature3_Null_MA    to typeof(real)
           //
           ,BoolFeature4_Total_MA   to typeof(real)
           ,BoolFeature4_True_MA    to typeof(real)
           ,BoolFeature4_False_MA   to typeof(real)
           ,BoolFeature4_Null_MA    to typeof(real)
    |extend PivotsCol = parse_json(PivotsCol)
    |evaluate bag_unpack(PivotsCol)
    | project-away *_Count
}

.create-or-alter function with (folder = "IPW", docstring = "", skipvalidation = "true") Get_CF_Adhoc(ParamScanRange:timespan=180d, ParamScanEnd:datetime=datetime(null), ParamPivot:string="", ParamProductIdList:string="", ParamTopicIdList:string="", ParamBoolFeatureCol1_Name:string="IsRecoTaken") {
    // SAMPLE USAGE
    //      Get_CF_Adhoc()|render timechart
    //      Get_CF_Adhoc(ParamPivot = 'IssueType')|project-keep Start*,P*, *Given*|render timechart
    //      Get_CF_Adhoc(ParamPivot = 'ProductId')
    //      Get_CF_Adhoc(ParamProductIdList = '14749',ParamPivot='LeafTopicId')
    //      Get_CF_Adhoc(ParamProductIdList = '14749')|project-keep Start*, *Given*|render timechart
    //
    //let ParamBoolFeatureCol1_Name = 'IsRecoTaken'; let ParamBoolFeatureCol2_Name = 'IsHelpEngaged'; let ParamPivot = '';let ParamScanRange=180d;let ParamScanEnd=datetime(null);let ParamProductIdList='14749';let ParamTopicIdList='';
    let ScanEndDate =coalesce(ParamScanEnd, now());
    let ScanStartDate = ScanEndDate - ParamScanRange;
    cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()
    | as a
    | where StartDate >=ScanStartDate and StartDate<=ScanEndDate
    | where LastProductId != 15621
    | where IsEligible and IsPAC and not(IsConfirmedNoSupportPlan) and not(IsTestSub) and not(IsTetrisReroute) and not(IsError)
    | where IsSRCreated
    | where isempty( ParamProductIdList) or ParamProductIdList contains LastProductId
    | where isempty( ParamTopicIdList) or ParamTopicIdList contains LastSelectedTreeId
    | extend IssueType = iif (LastProductId in (15659, 15660), 'ASMS', 'Tech')
    // set null
    | extend IsRecoPresented= iif(IsEligible == True,      IsRecoPresented, tobool(''))
    | extend IsRecoTaken    = iif(IsRecoPresented == True, IsRecoTaken,     tobool(''))
    | project StartDate, IsSRCreated,IsRecoPresented, IsRecoTaken, IsHelpEngaged
             ,IssueType     = iif(ParamPivot in('IssueType', 'ProductId','LeafTopicId'), IssueType, '')
             ,ProductId     = iff(ParamPivot in('ProductId','LeafTopicId'), LastProductId, '')
             ,LeafTopicId   = iff(ParamPivot in('LeafTopicId'), LastSelectedTreeId, '')
    // Call Invoker 
    // Requires T:(StartDate:datetime,BoolFeature1_Col:bool,BoolFeature2_Col:bool,PivotsCol:string)
    //         ,ScanWindowInDays=7
    | extend PivotsCol        = tostring(bag_pack('IssueType',IssueType,'ProductId',ProductId,'LeafTopicId',LeafTopicId))
            ,BoolFeature1_Col = column_ifexists(ParamBoolFeatureCol1_Name,tobool('') )
    | invoke Invoker_Get_CF_Adhoc(ScanWindowInDays=7)
    | join kind = leftouter (cluster('ACCIA').database('CXP_CSF').ActiveTopicTree|distinct ProductId=ProductId, ProductName)on ProductId|project-away ProductId1
    | join kind = leftouter (cluster('ACCIA').database('CXP_CSF').ActiveTopicTree|distinct ProductId=ProductId, LeafTopicId, PathName)on ProductId,LeafTopicId|project-away ProductId1,LeafTopicId1
    | extend PivotsCol  = strcat(iif(isnotempty(IssueType),IssueType,' '),
                                iif(isnotempty(ProductId),ProductId,' '),
                                iif(isnotempty(LeafTopicId),LeafTopicId,' '))
    |project-reorder StartDate, PivotsCol, *Given*,*IPW*,*Count*
}

.create-or-alter function with (folder = "IPW", docstring = "", skipvalidation = "true") Get_IPW_Azure(ParamScanStartDate:datetime=datetime(null), ParamScanEndDate:datetime=datetime(null), ParamPivot:string="", ParamAdditionalPivot:string="", ParamProductIdList:string="", ParamTopicIdList:string="", ParamExcludeQuota:bool=True, ParamAzureCoreOnly:bool=False, ParamExpandSeries:bool=True) {
    // SAMPLE USAGE
    //      Get_IPW_Azure(ParamScanStartDate=datetime(2023-2-1),ParamExpandSeries=False)|project StartDate_series, IPW_series, IPW_Norm_series|render timechart
    //
    //      Get_IPW_Azure(ParamScanStartDate=datetime(2023-2-1))|project StartDate, IPW, IPW_Norm|render timechart
    //      Get_IPW_Azure(ParamPivot = 'IssueType', ParamExcludeQuota=False)|project StartDate, MainPivot, IPW,IPW_Norm |render timechart
    //      Get_IPW_Azure(ParamPivot = 'ProductId')|project StartDate, MainPivot, ProductName, IPW,IPW_Norm
    //      Get_IPW_Azure(ParamPivot = 'LeafTopicId', ParamProductIdList = '16450')  | project StartDate, MainPivot, IPW,IPW_Norm, IssueType,ProductId,LeafTopicId,PathName
    //      Get_IPW_Azure(ParamPivot = 'IsRecoPresented') | project StartDate,MainPivot, IPW,IPW_Norm
    //      Get_IPW_Azure(ParamPivot = 'ProductId',ParamAdditionalPivot='IsRecoPresented')| project  StartDate, ProductName, AdditionalPivot, IPW,IPW_Norm
    //      Get_IPW_Azure(ParamTopicIdList = '32615526') | project StartDate, IPW,IPW_Norm, MainPivot
    //
    //let ParamExpandSeries = False;let ParamScanStartDate = datetime(null); let ParamScanEndDate=datetime(null);let ParamPivot = 'IsRecoPresented';let ParamProductIdList='';let ParamTopicIdList='';let ParamAzureCoreOnly = False;let ParamExcludeQuota=True;let ParamAdditionalPivot = ''; 
    let ScanEndDate =coalesce(ParamScanEndDate, toscalar(cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()|summarize max(StartDate)));
    let ScanStartDate = coalesce(ParamScanStartDate,ScanEndDate - 180d);
    cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()
    | where StartDate >=ScanStartDate and StartDate<= ScanEndDate
    | where IsSRCreated
    | where IsEligible and IsPAC  and not(IsTestSub) and not(IsConfirmedNoSupportPlan)
    | where isempty( ParamProductIdList) or ParamProductIdList contains LastProductId
    | where isempty( ParamTopicIdList) or ParamTopicIdList contains Workflow_TopicId
    | extend IsQuota        = LastProductId  == 15621
            ,IsASMS         = LastProductId  in (15659, 15660)
            ,ProductId      = LastProductId
            ,LeafTopicId    = Workflow_TopicId
    | extend IsAzureTech    = not(IsQuota) and not(IsASMS) and isnotempty(ProductId)
    | where ParamExcludeQuota and not(IsQuota) or not(ParamExcludeQuota)
    | extend IssueType = case (IsQuota, 'Quota', IsASMS, 'ASMS', 'Tech')
    | invoke database('SupportAnalysis').Invoker_GetIsAzureCore() //Requires col ProductId for PESId
    | extend IsResourceURI_Generic = ResourceURI=='MICROSOFT.GENERALQUESTION'
            ,IsResourceURI_Empty   = isempty(ResourceURI)
    | extend StartDate, IsSRCreated, IsRecoPresented, IsRecoTaken, SupportRequestNumber,SessionId
            ,IsAzureTech, IsASMS, IsQuota,IsAzureCore
            ,IssueType     = iif(ParamPivot in('IssueType', 'ProductId','LeafTopicId'), IssueType, '')
            ,ProductId     = iff(ParamPivot in('ProductId','LeafTopicId'), ProductId, '')
            ,LeafTopicId   = iff(ParamPivot in('LeafTopicId'), LeafTopicId, '')
            ,MainPivot     = iif(isempty(ParamPivot), '', strcat(ParamPivot, '_', column_ifexists(ParamPivot, '')))
            ,AdditionalPivot    = iif(isempty(ParamAdditionalPivot), '', strcat(ParamAdditionalPivot, '_', column_ifexists(ParamAdditionalPivot, '')))
    // Prep for MA
    // Requires T:(StartDate:datetime,PivotsCol:string) ,ScanWindowInDays, ParamExpandSeries
    | extend PivotsCol      = tostring(bag_pack(
                                'IssueType',IssueType,
                                'ProductId',ProductId,
                                'LeafTopicId',LeafTopicId, // PENDING: If Pivot by Topic, how to handle shared topic cross product?
                                'MainPivot',MainPivot,
                                'AdditionalPivot',AdditionalPivot))
    | as ipw_raw
    // Get IPW
    | invoke Invoker_Get_MA(
             ParamMovingWindowInDays= 7                 // IPW
            ,ParamMovingAvg         = false             // False for MovingSum; True for MovingAvg; feed into series_fir(normalize=..)
            ,ParamExpandSeries      = ParamExpandSeries // False return MA as dynamic; True returns 1 row per datapoint
            )
    | project-rename IPW = Total_MA ,IPW_series = Total_MA_series
    | lookup kind = leftouter(
        // Get IPW_Norm (28d)
        ipw_raw
        | project StartDate,PivotsCol
        | invoke Invoker_Get_MA(
                 ParamMovingWindowInDays= 28                // IPW_Norm
                ,ParamMovingAvg         = false             // False for MovingSum; True for MovingAvg; feed into series_fir(normalize=..)
                ,ParamExpandSeries      = ParamExpandSeries // False return MA as dynamic; True returns 1 row per datapoint
                )
        | project StartDate
                 ,IssueType,ProductId,LeafTopicId,MainPivot,AdditionalPivot // expand of PivotsCol
                 ,IPW_Norm        = Total_MA/4
                 ,IPW_Norm_series = series_divide(Total_MA_series, repeat(4,array_length(Total_MA_series)))
        ) on StartDate, IssueType,ProductId,LeafTopicId,MainPivot,AdditionalPivot
    // Remove last 7 day from output: IPW = 0 for last 7 day ; IPW_Norm=0 for last 28d
    // Get ProductName/PathName if applicable, e.g. pivot by Product/Topic
    | join kind = leftouter (cluster('ACCIA').database('CXP_CSF').ActiveTopicTree|where isnotempty(ProductId)|distinct ProductId, ProductName)on ProductId|project-away ProductId1
    | join kind = leftouter (cluster('ACCIA').database('CXP_CSF').ActiveTopicTree|where IsActiveLeaf|distinct ProductId, LeafTopicId, PathName)on ProductId,LeafTopicId|project-away ProductId1,LeafTopicId1
    | project-reorder StartDate,IPW*,TotalCount
}

.create-or-alter function with (folder = "IPW", docstring = "", skipvalidation = "true") Get_Muliti_MA(ParamScanRange:timespan=180d, ParamScanEnd:datetime=datetime(null), ParamPivot:string="", ParamProductIdList:string="", ParamTopicIdList:string="", ParamBoolFeatureCol1_Name:string="IsRecoTaken", ParamBoolFeatureCol2_Name:string="IsHelpEngaged") {
    // SAMPLE USAGE
    //      Get_Muliti_MA()|render timechart
    //      Get_Muliti_MA(ParamPivot = 'IssueType')|project-keep Start*,P*, *Given*|render timechart
    //      Get_Muliti_MA(ParamPivot = 'ProductId')
    //      Get_Muliti_MA(ParamProductIdList = '14749',ParamPivot='LeafTopicId')
    //      Get_Muliti_MA(ParamProductIdList = '14749')|project-keep Start*, *Given*|render timechart
    //
    //let ParamBoolFeatureCol1_Name = 'IsRecoTaken'; let ParamBoolFeatureCol2_Name = 'IsHelpEngaged'; let ParamPivot = '';let ParamScanRange=180d;let ParamScanEnd=datetime(null);let ParamProductIdList='14749';let ParamTopicIdList='';
    let ScanEndDate =coalesce(ParamScanEnd, now());
    let ScanStartDate = ScanEndDate - ParamScanRange;
    cluster('ACCIA').database('CXP_CSF').Get_CSF_Annotated()
    | as a
    | where StartDate >=ScanStartDate and StartDate<=ScanEndDate
    | where LastProductId != 15621
    | where IsEligible and IsPAC and not(IsConfirmedNoSupportPlan) and not(IsTestSub) and not(IsTetrisReroute) and not(IsError)
    | where IsSRCreated
    | where isempty( ParamProductIdList) or ParamProductIdList contains LastProductId
    | where isempty( ParamTopicIdList) or ParamTopicIdList contains LastSelectedTreeId
    | extend IssueType = iif (LastProductId in (15659, 15660), 'ASMS', 'Tech')
    // set null
    | extend IsRecoTaken = iif(IsRecoPresented == True, IsRecoTaken, tobool(''))
    | project StartDate, IsSRCreated,IsRecoPresented, IsRecoTaken, IsHelpEngaged
             ,IssueType     = iif(ParamPivot in('IssueType', 'ProductId','LeafTopicId'), IssueType, '')
             ,ProductId     = iff(ParamPivot in('ProductId','LeafTopicId'), LastProductId, '')
             ,LeafTopicId   = iff(ParamPivot in('LeafTopicId'), LastSelectedTreeId, '')
    // Call Invoker 
    // Requires T:(StartDate:datetime,BoolFeature1_Col:bool,BoolFeature2_Col:bool,PivotsCol:string)
    //         ,ScanWindowInDays=7
    | extend BoolFeature1_Col = column_ifexists(ParamBoolFeatureCol1_Name,tobool('') )
            ,BoolFeature2_Col = column_ifexists(ParamBoolFeatureCol2_Name,tobool('') )
    | extend PivotsCol        = tostring(bag_pack('IssueType',IssueType,'ProductId',ProductId,'LeafTopicId',LeafTopicId))
//             ,BoolFeature3_Col = case(BoolFeature1_Col==True  and isnotempty(BoolFeature2_Col), BoolFeature2_Col, tobool(''))//Feature2_Given_Feature1_True
//             ,BoolFeature4_Col = case(BoolFeature1_Col==False and isnotempty(BoolFeature2_Col), BoolFeature2_Col, tobool(''))//Feature2_Given_Feature_False
    | invoke Invoker_Get_Multi_MA(ScanWindowInDays=7)
    | join kind = leftouter (cluster('ACCIA').database('CXP_CSF').ActiveTopicTree|distinct ProductId=ProductId, ProductName)on ProductId|project-away ProductId1
    | join kind = leftouter (cluster('ACCIA').database('CXP_CSF').ActiveTopicTree|distinct ProductId=ProductId, LeafTopicId, PathName)on ProductId,LeafTopicId|project-away ProductId1,LeafTopicId1
    | extend IPW        = BoolFeature1_True_MA + BoolFeature1_False_MA
            ,PivotsCol  = strcat(iif(isnotempty(IssueType),IssueType,' '),
                                iif(isnotempty(ProductId),ProductId,' '),
                                iif(isnotempty(LeafTopicId),LeafTopicId,' '))
    | extend 
             F1_True_Given_Total    = 1.0*BoolFeature1_True_MA/IPW
            ,F2_True_Given_Total    = 1.0*BoolFeature2_True_MA/IPW
//             ,F3_True_Given_F1_True  = 1.0*BoolFeature3_True_MA/BoolFeature1_True_MA
//             ,F4_True_Given_F1_True  = 1.0*BoolFeature4_True_MA/BoolFeature1_True_MA
    |project-reorder StartDate, PivotsCol, *Given*,*IPW*,*Count*
}

// List of functions in Accia.LeftShift.IPW_Dashboard collection

.create-or-alter function with (folder = "IPW_Dashboard", docstring = "Gets P360 Id Mapping", skipvalidation = "true") GetP360PortfolioDim() {
    // PENDING: Find better source then add KO. KO currently does not have access to Usage360
    cluster('Usage360').database("Product360").AllCloudSupportIncidentDataWithP360MetadataMappingVNext  
    | where P360_ProductType == 'Portfolio'
    | summarize ProductIds = make_set(DerivedProductIDStr) by PortfolioName=P360_ProductName, PortfolioId=P360_ProductId
    | mv-expand ProductId = ProductIds //to typeof(long) 
    | extend ProductId = tolong(ProductId) | project-away ProductIds
}

.create-or-alter function with (folder = "IPW_Dashboard", docstring = "", skipvalidation = "true") IPW_ByProduct() {
    // SAMPLE USAGE
    //      SHS_Strategy_IPW()|render timechart
    //      .drop function SHS_Strategy_IPW
    //
    let SRData = IPW_GetSRData()
    ;
    let Start = toscalar(SRData| summarize max(SequenceStart))
    ;
    SRData
    // Annotated_Prod does NOT backfill 
    //|where StartDate !between (datetime(2023-8-30)..datetime(2023-9-20))
    | make-series sr=count() default=0 on StartDate from Start to startofday(now(),-1) step 1d by ProductId
    | extend IPW = series_fir(sr,repeat(1,7),false,false)
    | extend IPM = series_fir(sr,repeat(1,28),false,false)| project-away sr
    | mv-expand StartDate to typeof(datetime),IPW to typeof(long),IPM to typeof(long)
    | extend IPW_Smoothed = IPM/4 | project-away IPM
    | where StartDate >= (Start+28d)
    | project-rename CreatedDate = StartDate
    | extend StupidKey = strcat(CreatedDate,ProductId)
}

.create-or-alter function with (folder = "IPW_Dashboard", docstring = "", skipvalidation = "true") IPW_CxBehaviors() {
    let SRData = IPW_GetSRData()
    ;
    let Start = toscalar(SRData| summarize max(SequenceStart))
    ;
    let sessions = SRData
    | distinct SessionId, ProductId,SupportRequestNumber
    ;
    database('CSS_Secured').Get_Annotated_SR_Sessions()
    | join kind=inner(sessions) on SessionId,SupportRequestNumber | project-away SessionId1,SupportRequestNumber1
    | extend IsHelpEngaged=coalesce(IsHelpEngaged,False)
            ,HasOpportunityBlade=coalesce(HasOpportunityBlade,False)
            ,HasResourceMenuBlade=coalesce(HasResourceMenuBlade,False)
            ,IsHelpEngaged_CSF=coalesce(IsHelpEngaged_CSF,False)
            //this isn't very accurate
            ,IsHelpEngaged_NotCSF= coalesce(IsHelpClicked_DNS or IsHelpEngaged_H20,False)
    | where isnotempty(IsCaseCreator_ByPuid) and isnotempty( IsNewCSFUser_ByPuid)
    | summarize arg_max(SessionEndTime_Portal,*) by SupportRequestNumber,SessionId
    | project  IsHelpEngaged_CSF, VisitedTroubleshootingBlade=HasOpportunityBlade
           ,IsHelpEngaged_NotCSF,IsUndeflectableCustomer=IsCaseCreator_ByPuid
           ,SessionId, SupportRequestNumber, CreatedDate=SR_CreatedDate, ProductId
    | summarize c=count() 
         by IsHelpEngaged_CSF, VisitedTroubleshootingBlade,IsHelpEngaged_NotCSF,IsUndeflectableCustomer,ProductId,CreatedDate
    | order by c desc
    |as a|extend pct = 1.0*c/toscalar (a|summarize sum(c))
    |extend Label = case(
            IsHelpEngaged_CSF or IsHelpEngaged_NotCSF, 'Unsuccessful Content',
            IsUndeflectableCustomer, 'Undeflectable Customer',
            VisitedTroubleshootingBlade, 'Visited Troubleshooting',
            'No Interaction'
            )
    | extend StupidKey = strcat(CreatedDate,ProductId)
}

.create-or-alter function with (folder = "IPW_Dashboard", docstring = "", skipvalidation = "true") IPW_GetSRData() {
    let SequenceStart = toscalar(database("CXP_CSF").Get_PortExtTel_Annotated()| summarize min(StartDate))
    ;
    database("CXP_CSF").Get_PortExtTel_Annotated()
    | where IsSRCreated
    | where StartWorkflowTimestamp >= SequenceStart //and LastProductId !in (15621)
    | project WorkflowId,IsSRCreated, StartDate, ProductId=LastProductId,SequenceStart=SequenceStart, SessionId, SupportRequestNumber
}

// List of functions in Accia.LeftShift.IPW_Portal collection

.create-or-alter function with (folder = "IPW_Portal", docstring = "", skipvalidation = "true") SHS_Strategy_3dot(ParamScanStart:datetime=datetime(2023-1-1)) {
    // SAMPLE USAGE
    //      SHS_Strategy_3dot()|summarize c=sum(c), pct=sum(pct)by Label
    //      .drop function SHS_Strategy_3dot
    //
    let sessions = database("CXP_CSF").Get_PortExtTel_Annotated()
    |where IsEligible and IsPAC and not(IsTestSub) 
    |where StartWorkflowTimestamp >= (ParamScanStart-28d) and LastProductId !in (15621)
    | distinct SessionId
    ;
    database('CSS_Secured').Get_Annotated_SR_Sessions()
    | join kind=inner(sessions) on SessionId | project-away SessionId1
    | extend IsHelpEngaged=coalesce(IsHelpEngaged,False)
            ,HasOpportunityBlade=coalesce(HasOpportunityBlade,False)
            ,HasResourceMenuBlade=coalesce(HasResourceMenuBlade,False)
            ,IsHelpEngaged_CSF=coalesce(IsHelpEngaged_CSF,False)
            ,IsHelpEngaged_NotCSF= coalesce(IsHelpClicked_DNS or IsHelpEngaged_H20,False)
            ,SR_CreatedDate=iif(isnotempty( SupportRequestNumber),SessionStartDate,todatetime(''))
            |extend IsCaseCreator_ByPuid=column_ifexists('IsCaseCreator_ByPuid',false),IsNewCSFUser_ByPuid=column_ifexists('IsNewCSFUser_ByPuid',false)
    | where isnotempty(IsCaseCreator_ByPuid) and isnotempty( IsNewCSFUser_ByPuid)
    | summarize arg_max(SessionEndTime_Portal,*) by SupportRequestNumber,SessionId
    | project  IsHelpEngaged_CSF, HasOpportunityBlade
              ,IsHelpEngaged_NotCSF,IsCaseCreator_ByPuid,SessionId, SupportRequestNumber, SR_CreatedDate
    | summarize c=count() 
         by IsHelpEngaged_CSF, HasOpportunityBlade
           ,IsHelpEngaged_NotCSF,IsCaseCreator_ByPuid
    | order by c desc
    |as a|extend pct = 1.0*c/toscalar (a|summarize sum(c))
    |extend Label = case(
            IsHelpEngaged_CSF or IsHelpEngaged_NotCSF, 'Relevancy',
            IsCaseCreator_ByPuid, 'CaseCreator_ByPuid',
            HasOpportunityBlade, 'Visited Troubleshooting',
            'No Interaction'
            )
}

.create-or-alter function with (folder = "IPW_Portal", docstring = "", skipvalidation = "true") SHS_Strategy_BladeSeqLength_Chart() {
    // SAMPLE USAGE
    //      database("LeftShift").SHS_Strategy_BladeSeqLength_Chart()
    //
    let ScanStart = datetime(2023-10-1);
    let ScanRange = 14d;
    cluster('ACCIA').database("CSS_Secured").GetPreHeatMap( ScanStart, ScanStart + ScanRange)
    | join kind=inner (cluster('ACCIA').database("CSS_Secured").GetHeatMap(ScanStart, ScanStart + ScanRange)) on SessionId
    | summarize dc4_Blade= dcount(BladeName,4) by SessionId, Label
    //| as cdf_raw // =================> Use this to draw CDF in EXCEL 
    //cdf_raw
    | evaluate pivot(Label, count(),dc4_Blade)
    |extend Relevancy=column_ifexists('Relevancy',-1)
            ,CaseCreator_ByPuid=column_ifexists('CaseCreator_ByPuid',-1)
            ,Visited_Troubleshooting=column_ifexists('Visited_Troubleshooting',-1)
            ,No_Interaction=column_ifexists('No_Interaction',-1)
    | order by dc4_Blade asc
    | extend Relevancy              = row_cumsum(Relevancy)
            ,CaseCreator_ByPuid     = row_cumsum(CaseCreator_ByPuid)
            ,Visited_Troubleshooting= row_cumsum(Visited_Troubleshooting)
            ,No_Interaction         = row_cumsum(No_Interaction)
    | as temp
    | extend Relevancy              = 1.0* Relevancy/toscalar (temp|summarize max(Relevancy))
            ,CaseCreator_ByPuid     = 1.0* CaseCreator_ByPuid/toscalar (temp|summarize max(CaseCreator_ByPuid))
            ,Visited_Troubleshooting= 1.0* Visited_Troubleshooting/toscalar (temp|summarize max(Visited_Troubleshooting))
            ,No_Interaction         = 1.0* No_Interaction/toscalar (temp|summarize max(No_Interaction ))
}

.create-or-alter function with (folder = "IPW_Portal", docstring = "", skipvalidation = "true") SHS_Strategy_BladeSeqLength_Table() {
    // SAMPLE USAGE
    //      database("LeftShift").SHS_Strategy_BladeSeqLength_Table()
    //
    // [2023-7-18] Page8/Query#2 : CDF (up to 14 day without hitting runaway)
    let ScanStart = datetime(2023-10-1);
    let ScanRange = 14d;
    cluster('ACCIA').database("CSS_Secured").GetPreHeatMap( ScanStart, ScanStart + ScanRange)
    | join kind=inner (cluster('ACCIA').database("CSS_Secured").GetHeatMap(ScanStart, ScanStart + ScanRange)) on SessionId
    | summarize dc4_Blade= dcount(BladeName,4) by SessionId, Label
    | as cdf_raw // =================> Use this to draw CDF in EXCEL 
    | summarize AverageDistinctBladesVisited=avg(dc4_Blade) by Label
    | order by AverageDistinctBladesVisited asc
}

.create-or-alter function with (folder = "IPW_Portal", docstring = "", skipvalidation = "true") SHS_Strategy_IPW(ParamScanStart:datetime=datetime(2023-1-1)) {
    // SAMPLE USAGE
    //      SHS_Strategy_IPW()|render timechart
    //      .drop function SHS_Strategy_IPW
    //
    database("CXP_CSF").Get_PortExtTel_Annotated()
    |where IsEligible and IsPAC and not(IsTestSub) 
    |where StartWorkflowTimestamp >= (datetime(2023-1-1)-28d) and LastProductId !in (15621)
    |project WorkflowId,IsSRCreated, StartDate, LastProductId
    // Annotated_Prod does NOT backfill 
    //|where StartDate !between (datetime(2023-8-30)..datetime(2023-9-20))
    | summarize sr=countif(IsSRCreated) by StartDate
    | order by StartDate asc 
    | summarize  sr= make_list(sr),make_list(StartDate)
    | extend IPW = series_fir(sr,repeat(1,7),false)
    | extend IPM = series_fir(sr,repeat(1,28),false)| project-away sr
    | mv-expand list_StartDate to typeof(datetime),IPW to typeof(long),IPM to typeof(long)
    | extend IPM_Normed = IPM/4 | project-away IPM
    | where list_StartDate >= datetime(2023-1-1)
    | project-rename StartDate = list_StartDate
}

.create-or-alter function with (folder = "IPW_Portal", docstring = "", skipvalidation = "true") SHS_Strategy_SubscriptionBehavior() {
    // SAMPLE USAGE
    //      database("LeftShift").SHS_Strategy_SubscriptionBehavior()
    //
    let scanstart = datetime(1/1/2023)
    ;
    let annotated = database("CXP_CSF").Get_CSF_Annotated()
        | where StartDate >= scanstart
        | where IsPAC and not(IsTestSub) and not(IsConfirmedNoSupportPlan) and IsHelpPresented and IsEligible and LastProductId != 15621
        | project IsSRCreated,SubscriptionId, ProductId=LastProductId, LeafTopicId=Workflow_TopicId
        | join kind=inner (database("CXP_CSF").ActiveTopicTree| project ProductId,SupportTopicL2Id, LeafTopicId,PathName) on ProductId,LeafTopicId
    ;
    let SubSummarization=annotated
                        | where isnotempty(SubscriptionId)
                        | summarize wf=count(), sr=countif(IsSRCreated) by SubscriptionId
                        | extend SRCreateRate = 1.0*sr/wf
                        | extend DeflRate = 1-SRCreateRate
                        | extend log2wf = round(log2(wf)*1,0)/1
    ;
    let Initial_linest=
    SubSummarization  
    // filter out the non-linear bits
    | where log2wf >=3
    | where wf>1 and sr>0
    | summarize wf=sum(wf),sr=sum(sr) by log2wf
    | extend percentd=1.0*(wf-sr)/wf
    | order by log2wf asc
    | summarize x=make_list(log2wf), y=make_list(percentd)
    | extend (RSquare, Slope, Variance, RVariance, Interception, LineFit)=series_fit_line(y)
    //| project-away RSquare, Slope, Variance, RVariance, Interception
    | project Slope, Intercept=Interception,RSquare
    ;
    let final_linest=
    SubSummarization
    | join kind=inner (Initial_linest) where True
    | extend ExpectDeflRate = (log2wf*Slope)+Intercept
    | extend delta=DeflRate - ExpectDeflRate
    //remove extreme anomalies///////////////////////////////////////////////////
    | where DeflRate/ExpectDeflRate <4  //400% over expected
    ////////////////////////////////////////////////////////////////////////////
    | where log2wf >=3
    | where wf>1 and sr>0
    | summarize wf=sum(wf),sr=sum(sr) by log2wf
    | extend percentd=1.0*(wf-sr)/wf
    | order by log2wf asc
    | summarize x=make_list(log2wf), y=make_list(percentd)
    | extend (RSquare, Slope, Variance, RVariance, Interception, LineFit)=series_fit_line(y)
    //| project-away RSquare, Slope, Variance, RVariance, Interception
    | project Slope, Intercept=Interception,RSquare
    ;
    SubSummarization
    | join kind=inner (final_linest) where True
    | extend ExpectDeflRate = (log2wf*Slope)+Intercept
    | extend delta=DeflRate - ExpectDeflRate
    | where DeflRate/ExpectDeflRate <4  //400% over expected
    | extend SRImpact = 1.0*sr/toscalar(SubSummarization | summarize sum(wf))
    | order by SRImpact desc
    | summarize wf=sum(wf), sr=sum(sr) by log2wf,Slope,Intercept
    | as a
    | extend Deflection=1-1.0*sr/wf, Impact=1.0*sr/(toscalar(a|summarize sum(sr)))
    | extend log2wf = tostring(log2wf) // to render as X
}

.create-or-alter function with (folder = "IPW_Portal", docstring = "", skipvalidation = "true") SHS_Strategy_UserBehavior() {
    // SAMPLE USAGE
    //      database("LeftShift").SHS_Strategy_UserBehavior()
    //
    cluster('ACCIA').database("CSS_Secured")._WorkflowIdVisits 
    | where StartWorkflowTimestamp >= datetime(1/1/2023)
    | summarize 
            t=count(), sr= countif(IsSRCreated), he= countif(IsHelpEngaged) 
            by CSFVisit, bin(StartWorkflowTimestamp,1d)
    | extend defl = t-sr
    | extend Grouping = case (
                                CSFVisit ==1,  '01',
                                CSFVisit <=3,  '02-3',
                                CSFVisit <=7,  '04-7',
                                CSFVisit <=19, '08-19',
                                '20+')
    | summarize 
            t=sum(t), sr=sum(sr),defl=sum(defl), he=sum(he)
            by Grouping, key =1
    | as all 
    | join kind = inner(
            all
            | summarize t=sum(t), sr=sum(sr),defl=sum(defl), he=sum(he) by key 
            | as all_sum
            ) on key
    | extend t_pct      = round(1.0*t/t1,2)
            ,sr_pct     = round(1.0*sr/sr1,2)
            ,defl_pct   = round(1.0*defl/defl1,2)
            ,he_pct     = round(1.0*he/he1,2)
    | union kind = outer  (all_sum|extend Grouping='All')
    | order by Grouping asc
    | project-away *1,key
    | project-reorder Grouping, *pct
}

